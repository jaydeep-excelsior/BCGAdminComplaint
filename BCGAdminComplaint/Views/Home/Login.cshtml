
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bar Council of Gujarat - Compalint Management</title>
    <link rel="shortcut icon" href="/assets/img/logo.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css">
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/Site.css?v=13" rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main, #f8fafc);
        }
        .login-wrapper {
            min-height: 100vh;
        }
        .login-branding {
            background: linear-gradient(135deg, #4f46e5 0%, #312e81 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 3rem;
            text-align: center;
        }
        .login-branding h2 {
            font-weight: 700;
            margin-top: 1.5rem;
            color: white !important;
            letter-spacing: -0.02em;
        }
        .login-branding p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.1rem;
            margin-top: 0.5rem;
            max-width: 400px;
        }
        .login-form-container {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            background-color: white;
        }
        .login-card {
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            background: #ffffff;
            border: 1px solid #f1f5f9;
        }
        .login-card h3 {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }
        .login-card p {
            color: #64748b;
            margin-bottom: 2rem;
        }
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 1rem;
        }
        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
        .btn-login {
            background-color: #4f46e5;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            transition: all 0.2s ease;
            border: none;
        }
        .btn-login:hover {
            background-color: #4338ca;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
            color: white;
        }
        .auth-pass-inputgroup {
            display: flex;
            align-items: stretch;
        }
        .auth-pass-inputgroup .form-control {
            border-top-right-radius: 0 !important;
            border-bottom-right-radius: 0 !important;
            border-right: none !important;
        }
        .auth-pass-inputgroup .form-control:focus {
            box-shadow: none !important;
            border-color: #cbd5e1 !important;
        }
        .auth-pass-inputgroup:focus-within {
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15) !important;
            border-radius: 8px !important;
        }
        .auth-pass-inputgroup:focus-within .form-control,
        .auth-pass-inputgroup:focus-within .btn {
            border-color: #4f46e5 !important;
        }
        #password-addon,
        .auth-pass-inputgroup .btn {
            border: 1px solid #cbd5e1 !important;
            border-left: none !important;
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            background-color: transparent !important;
            color: #64748b !important;
            padding-left: 1rem !important;
            padding-right: 1rem !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
        }
        #password-addon i,
        .auth-pass-inputgroup .btn i {
            font-size: 1.45rem !important;
            line-height: 1 !important;
            display: inline-block !important;
            transition: color 0.2s ease, transform 0.2s ease;
        }
        #password-addon:hover,
        .auth-pass-inputgroup .btn:hover {
            color: #4f46e5 !important;
            background-color: transparent !important;
            transform: none !important;
            box-shadow: none !important;
        }
        #password-addon:hover i,
        .auth-pass-inputgroup .btn:hover i {
            color: #4f46e5 !important;
            transform: scale(1.1);
        }
        @@media (max-width: 991.98px) {
            .login-branding {
                display: none; /* Hide branding on mobile to focus on form */
            }
            .login-wrapper {
                background-color: #f8fafc;
            }
            .login-form-container {
                background-color: transparent;
            }
        }
    </style>
</head>
<body>
    <div class="row g-0 login-wrapper">
        <!-- Branding Side (Left) -->
        <div class="col-lg-6 login-branding d-none d-lg-flex">
            <img height="100" src="/assets/img/logo.png" alt="BCG Logo" />
            <h2>Bar Council of Gujarat</h2>
            <p>Welcome to the Complaint Management System. Please log in to continue.</p>
        </div>

        <!-- Form Side (Right) -->
        <div class="col-lg-6 login-form-container">
            <div class="login-card">
                <!-- Logo for mobile view -->
                <div class="text-center d-block d-lg-none mb-4">
                    <img height="80" src="/assets/img/logo.png" alt="BCG Logo" />
                </div>
                
                <h3>Welcome Back!</h3>
                <p>Login to continue to Bar Council of Gujarat - Compalint Management.</p>

                <div>
                    <div class="mb-4">
                        <label for="username" class="form-label" style="font-weight: 500; color: #475569;">Username</label>
                        <input type="text" class="form-control" name="txtUserName" id="txtUserName" placeholder="Enter username">
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 500; color: #475569;">Password</label>
                        <div class="input-group auth-pass-inputgroup">
                            <input type="password" class="form-control" name="txtPassword" id="txtPassword" placeholder="Enter password" aria-label="Password" aria-describedby="password-addon">
                            <a class="btn btn-light" id="password-addon" role="button" aria-label="Toggle password visibility"><i class="lar la-eye" style="font-size: 1.45rem !important;"></i></a>
                        </div>
                    </div>



                    <div class="d-grid">
                        <a class="btn-login text-center" id="lnkLogin" style="cursor: pointer;">Log In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/metisMenu.min.js"></script>
    <script src="~/assets/js/simplebar.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/node-waves/0.7.6/waves.min.js"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.swal = function (a, b, c) {
            var config = {
                buttonsStyling: false,
                customClass: {
                    confirmButton: 'btn btn-outline-primary',
                    cancelButton: 'btn btn-outline-secondary ms-2'
                }
            };

            if (typeof a === 'object') {
                config = $.extend(true, config, a);
            } else {
                config.title = a;
                if (c !== undefined) {
                    config.text = b || '';
                    config.icon = c || undefined;
                } else if (b !== undefined) {
                    var icons = ['success', 'error', 'warning', 'info', 'question'];
                    if (icons.indexOf(b) !== -1) {
                        config.icon = b;
                    } else {
                        config.text = b || '';
                    }
                }
            }
            return Swal.fire(config);
        };
    </script>
    <script>
        $(document).ready(function() {
            // Toggle Password Visibility
            $('#password-addon').off('click').on('click', function (e) {
                e.preventDefault();
                var passwordInput = $('#txtPassword');
                var icon = $(this).find('i');
                
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('la-eye').addClass('la-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('la-eye-slash').addClass('la-eye');
                }
            });
        });

        $('#lnkLogin').on('click', function (e) {
            var VUserName = $("#txtUserName").val();
            var VPassword = $("#txtPassword").val();
            var IsLogin = 1;

            if (VUserName == null) {
                IsLogin = 0;
                swal("Please input username", "", "error");
                return;
            }

            if (VUserName == '') {
                IsLogin = 0;
                swal("Please input username", "", "error");
                return;
            }

            if (VPassword == null) {
                IsLogin = 0;
                swal("Please input password", "", "error");
                return;
            }

            if (VPassword == '') {
                IsLogin = 0;
                swal("Please input password", "", "error");
                return;
            }

            if (IsLogin == 1) {
                var VUserName = $("#txtUserName").val();
                var VPassword = $("#txtPassword").val();
                var Logindata = JSON.stringify({
                    UserName: VUserName,
                    Password: VPassword,
                    PCIPAddress: ''
                });
                $.when(UserLogin(Logindata))
                .then(function (response) { })
                .fail(function (err) {
                    console.log(err);
                });
                //    e.preventDefault();
                //    return $.ajax({
                //        url: 'https://api4.my-ip.io/ip.json',
                //        method: 'GET'
                //    })
                //   .done(function (data) {
                //       localStorage.setItem("PCIPAddress", data.ip);
                //       UserLoginMethod(data.ip);
                //   })
                //   .fail(function () {
                //       UserLoginMethod('');
                //   });
            }
        });

        function UserLoginMethod(PCIPAddress) {
            var VUserName = $("#txtUserName").val();
            var VPassword = $("#txtPassword").val();
            var Logindata = JSON.stringify({
                UserName: VUserName,
                Password: VPassword,
                PCIPAddress: PCIPAddress
            });
            $.when(UserLogin(Logindata))
            .then(function (response) { })
            .fail(function (err) {
                console.log(err);
            });
        };

        function UserLogin(data) {

            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: "/Home/UserLogin",
                data: data,
                success: function (result) {
                    if (result.data == "Success") {
                        var url = '/Home/Index';
                        location.href = url;
                    }
                    else if (result.ReturnStatus == 'N' || result.ReturnStatus == null) {
                        swal('You have no access', "", "error");
                    }
                    else {
                        swal("Office Admin Login", "", "error");
                    }
                },
                error: function () {
                    swal('Opps! Something Went Wrong', "", "error");
                }
            });
        }

    </script>
</body>
</html>
