@{
    ViewBag.Title = "Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Premium Notes Styling */
    .notes-page-container {
        padding: 20px 0 40px 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .notes-header-card {
        background: linear-gradient(135deg, #0b2b5c 0%, #174276 60%, #1e5a9c 100%);
        border-radius: 12px;
        padding: 24px 28px;
        color: #ffffff;
        box-shadow: 0 8px 24px rgba(11, 43, 92, 0.15);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .notes-header-card::after {
        content: "";
        position: absolute;
        top: -40px;
        right: -40px;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .notes-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #ffffff !important;
    }

    .notes-subtitle {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.82);
        margin: 0;
    }


    /* Metric Cards */
    .metric-card {
        background: #ffffff;
        border-radius: 10px;
        padding: 16px 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    }

    .metric-val {
        font-size: 24px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
    }

    .metric-lbl {
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 4px;
    }

    .metric-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Filter Toolbar */
    .filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }

    .filter-input {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 13px;
        padding: 8px 12px;
        height: 40px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .filter-input:focus {
        border-color: #0b2b5c;
        box-shadow: 0 0 0 3px rgba(11, 43, 92, 0.12);
        outline: none;
    }

    /* Equalize Select2 container height and styling with .filter-input */
    .select2-container .select2-selection--single {
        height: 40px !important;
        min-height: 40px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 5px 12px !important;
        font-size: 13px !important;
        background-color: #ffffff !important;
        display: flex !important;
        align-items: center !important;
        transition: border-color 0.15s ease, box-shadow 0.15s ease !important;
        box-sizing: border-box !important;
    }

    .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 28px !important;
        padding-left: 0 !important;
        padding-right: 24px !important;
        color: #334155 !important;
        font-size: 13px !important;
        width: 100% !important;
    }

    .select2-container .select2-selection--single .select2-selection__placeholder {
        color: #94a3b8 !important;
        font-size: 13px !important;
    }

    .select2-container .select2-selection--single .select2-selection__arrow {
        height: 38px !important;
        right: 8px !important;
        top: 1px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #0b2b5c !important;
        box-shadow: 0 0 0 3px rgba(11, 43, 92, 0.12) !important;
        outline: none !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__clear {
        margin-right: 18px !important;
        font-size: 16px !important;
        color: #94a3b8 !important;
        line-height: 28px !important;
    }

    /* Note Cards Grid */
    .note-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .note-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

    .note-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        border-color: #cbd5e1;
    }

    .note-type-badge {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        height: 28px;
        line-height: 26px;
        padding: 0 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        border: 1px solid transparent;
        white-space: nowrap;
        vertical-align: middle;
    }

    .badge-complaint { background: #e0e7ff; color: #3730a3; border-color: #c7d2fe; }
    .badge-general { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
    .badge-meeting { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .badge-confidential { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
    .badge-order { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
    .badge-other { background: #e2e8f0; color: #334155; border-color: #cbd5e1; }

    .note-title-text {
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        margin: 10px 0 6px 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .note-desc-text {
        font-size: 13px;
        color: #475569;
        line-height: 1.5;
        margin-bottom: 14px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: pre-line;
    }

    .note-ref-badge {
        font-size: 11.5px;
        font-weight: 600;
        color: #0b2b5c;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        height: 28px;
        line-height: 26px;
        padding: 0 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 0;
        text-decoration: none;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        box-sizing: border-box;
        vertical-align: middle;
    }

    .note-card .note-ref-badge {
        margin-bottom: 12px;
    }

    /* Note Details Popup Badges - Identical Height & Alignment */
    #modalViewNote #viewNoteTypeBadge,
    #modalViewNote #viewNoteRefBadge {
        height: 28px !important;
        min-height: 28px !important;
        max-height: 28px !important;
        line-height: 26px !important;
        display: inline-flex !important;
        align-items: center !important;
        margin-bottom: 0 !important;
        box-sizing: border-box !important;
        vertical-align: middle !important;
    }

    .note-ref-badge:hover {
        background: #e2e8f0;
        color: #0b2b5c;
    }

    .note-meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 11.5px;
        color: #64748b;
        padding-top: 12px;
        border-top: 1px dashed #e2e8f0;
        margin-top: auto;
    }

    .note-actions-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
        transition: all 0.15s ease;
        cursor: pointer;
    }

    .note-actions-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
    }

    .note-actions-btn.delete-btn:hover {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fca5a5;
    }

    .file-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        background: #f1f5f9;
        color: #0f172a;
        padding: 2px 7px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
    }

    /* Modal Styling */
    .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.18);
    }

    .modal-header {
        background: #0b2b5c;
        color: #ffffff;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        padding: 16px 22px;
    }

    .modal-header .modal-title,
    .modal-title {
        font-weight: 700;
        font-size: 17px;
        color: #ffffff !important;
    }

    .modal-title i {
        color: #ffffff !important;
    }

    .modal-body {
        padding: 22px;
    }

    .form-label {
        font-weight: 600;
        font-size: 12.5px;
        color: #334155;
        margin-bottom: 6px;
    }

    .attachment-dropzone {
        border: 2px dashed #cbd5e1;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: border-color 0.2s, background-color 0.2s;
    }

    .attachment-dropzone:hover,
    .attachment-dropzone.dropzone-active {
        border-color: #0b2b5c;
        background-color: #e0e7ff;
    }

    .existing-file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        margin-bottom: 6px;
        font-size: 12.5px;
    }

    .existing-file-name {
        font-weight: 600;
        color: #0b2b5c;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 320px;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        background: #ffffff;
        border-radius: 10px;
        border: 1px dashed #cbd5e1;
        margin-bottom: 24px;
    }
    .empty-icon {
        font-size: 48px;
        color: #94a3b8;
        margin-bottom: 14px;
    }

    /* Table View */
    .notes-table {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }
</style>

<div class="container-fluid notes-page-container">
    <!-- Header Banner -->
    <div class="notes-header-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="notes-title text-white" style="color: #ffffff !important;">
                    <i class="fa-solid fa-note-sticky text-warning"></i> Notes & Remarks Management
                </h1>
                <p class="notes-subtitle">
                    Create, manage, and attach documents to your personal administrative and complaint-related notes.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-warning text-dark fw-bold px-3 py-2" id="btnOpenAddModal">
                    <i class="fa-solid fa-plus me-1"></i> Add New Note
                </button>
            </div>
        </div>
    </div>

    <!-- Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="metric-card">
                <div>
                    <div class="metric-val" id="metricTotal">0</div>
                    <div class="metric-lbl">Total Notes</div>
                </div>
                <div class="metric-icon-box" style="background:#e0f2fe; color:#0369a1;">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card">
                <div>
                    <div class="metric-val" id="metricComplaint">0</div>
                    <div class="metric-lbl">Complaint Notes</div>
                </div>
                <div class="metric-icon-box" style="background:#e0e7ff; color:#3730a3;">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card">
                <div>
                    <div class="metric-val" id="metricGeneral">0</div>
                    <div class="metric-lbl">General Notes</div>
                </div>
                <div class="metric-icon-box" style="background:#dcfce7; color:#15803d;">
                    <i class="fa-solid fa-file-lines"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card">
                <div>
                    <div class="metric-val" id="metricAttachedFiles">0</div>
                    <div class="metric-lbl">Attached Files</div>
                </div>
                <div class="metric-icon-box" style="background:#fef3c7; color:#b45309;">
                    <i class="fa-solid fa-paperclip"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="filter-card">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="txtSearch" class="form-control filter-input border-start-0" placeholder="Search notes by title, details, or complaint #..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select id="ddlNoteType" class="form-select filter-input">
                    <option value="">All Categories</option>
                    <option value="Complaint Note">Complaint Note</option>
                    <option value="General Note">General Note</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <input type="date" id="txtFromDate" class="form-control filter-input" placeholder="From Date" title="Created From Date" />
            </div>
            <div class="col-6 col-md-2">
                <input type="date" id="txtToDate" class="form-control filter-input" placeholder="To Date" title="Created To Date" />
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary filter-input px-3" id="btnResetFilters" title="Reset Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <div class="btn-group w-100" role="group">
                    <button type="button" class="btn btn-primary active filter-input" id="btnViewGrid" title="Grid View">
                        <i class="fa-solid fa-grip"></i>
                    </button>
                    <button type="button" class="btn btn-outline-primary filter-input" id="btnViewTable" title="Table View">
                        <i class="fa-solid fa-list"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes Content Area -->
    <div id="notesLoading" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2 font-size-13">Fetching your notes...</p>
    </div>

    <!-- Grid View Container -->
    <div id="notesGridContainer" class="note-grid"></div>

    <!-- Table View Container -->
    <div id="notesTableContainer" class="notes-table d-none table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 120px;">Type</th>
                    <th>Note Title</th>
                    <th style="width: 180px;">Complaint Ref</th>
                    <th>Description</th>
                    <th style="width: 70px;" class="text-center">Files</th>
                    <th style="width: 150px;">Created Date</th>
                    <th style="width: 110px;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="notesTableBody"></tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="notesEmptyState" class="empty-state d-none">
        <div class="empty-icon"><i class="fa-regular fa-folder-open"></i></div>
        <h5 class="fw-bold text-dark">No Notes Found</h5>
        <p class="text-muted font-size-13 mb-3">You haven't created any notes matching the selected criteria yet.</p>
        <button type="button" class="btn btn-primary btn-sm px-3" onclick="$('#btnOpenAddModal').click();">
            <i class="fa-solid fa-plus me-1"></i> Create Your First Note
        </button>
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3" id="notesPaginationRow">
        <div class="font-size-13 text-muted" id="notesCountInfo">Showing 0 of 0 notes</div>
        <nav aria-label="Notes pagination">
            <ul class="pagination pagination-sm mb-0" id="notesPagination"></ul>
        </nav>
    </div>
</div>

<!-- ========================================== -->
<!-- ADD / EDIT NOTE MODAL                      -->
<!-- ========================================== -->
<div class="modal fade" id="modalNote" tabindex="-1" aria-labelledby="modalNoteTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="modalNoteTitle" style="color: #ffffff !important;"><i class="fa-solid fa-pen-to-square me-2"></i>Create New Note</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNote" enctype="multipart/form-data">
                    <input type="hidden" id="noteId" value="0" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-5" id="colNoteType">
                            <label class="form-label" for="txtNoteType">Note Category / Type <span class="text-danger">*</span></label>
                            <select id="txtNoteType" class="form-select filter-input" required>
                                <option value="Complaint Note" selected>Complaint Note</option>
                                <option value="General Note">General Note</option>
                            </select>
                        </div>
                        <div class="col-md-7" id="colNoteRef">
                            <label class="form-label" for="txtNoteRef">Reference Complaint <span class="text-muted fw-normal font-size-11">(Optional)</span></label>
                            <select id="txtNoteRef" class="form-select filter-input" style="width: 100%;">
                                <option value="">-- No Complaint Linked --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="txtNoteTitle">Note Title / Subject <span class="text-danger">*</span></label>
                        <input type="text" id="txtNoteTitle" class="form-control filter-input" placeholder="Enter a descriptive note title..." required maxlength="250" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="txtNoteDesc">Note Content / Detailed Description <span class="text-danger">*</span></label>
                        <textarea id="txtNoteDesc" class="form-control filter-input" rows="5" placeholder="Write internal remarks, observations, case notes, or instructions here..." style="height: auto;" required></textarea>
                    </div>

                    <!-- File Upload Section -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0 fw-bold text-dark font-size-13">
                                <i class="fa-solid fa-paperclip me-1 text-primary"></i> Attach Documents / Files
                                <span class="badge bg-primary text-white ms-1 font-size-10 px-2 py-1"><i class="fa-solid fa-layer-group me-1"></i>Multi-File Selection</span>
                            </label>
                            <span class="text-muted font-size-11">Max 50MB per file (PDF, Docs, Images, Excel)</span>
                        </div>
                        <div class="attachment-dropzone p-3" id="dropzoneFiles" role="button" tabindex="0">
                            <div class="d-flex flex-column align-items-center justify-content-center text-center">
                                <i class="fa-solid fa-cloud-arrow-up font-size-30 text-primary mb-2"></i>
                                <span class="fw-bold text-dark font-size-14 mb-1">Click or Drop Files Here to Upload</span>
                            </div>
                        </div>
                        <div id="stagedInputsContainer" class="d-none"></div>
                        <div id="newFilesList" class="mt-2"></div>
                    </div>

                    <!-- Existing Files when Editing -->
                    <div id="existingFilesSection" class="mt-3 d-none">
                        <label class="form-label font-size-12 text-muted text-uppercase">Existing Attachments</label>
                        <div id="existingFilesList"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" id="btnSaveNote">
                    <i class="fa-solid fa-check me-1"></i> Save Note
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- VIEW NOTE DETAILS MODAL                    -->
<!-- ========================================== -->
<div class="modal fade" id="modalViewNote" tabindex="-1" aria-labelledby="modalViewNoteTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="modalViewNoteTitle" style="color: #ffffff !important;">
                    <i class="fa-solid fa-file-lines me-2"></i>Note Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span id="viewNoteTypeBadge" class="note-type-badge badge-general">General</span>
                    <span id="viewNoteRefBadge" class="note-ref-badge d-none"></span>
                </div>
                <h4 id="viewNoteTitle" class="fw-bold text-dark mb-2"></h4>
                <div class="text-muted font-size-12 mb-3 pb-2 border-bottom d-flex flex-wrap gap-3">
                    <span><i class="fa-regular fa-clock me-1 text-primary"></i> <span id="viewNoteDate"></span></span>
                    <span><i class="fa-regular fa-user me-1 text-primary"></i> Created by <strong id="viewNoteUser"></strong></span>
                    <span id="viewNoteUpdated" class="d-none"><i class="fa-solid fa-pencil me-1 text-secondary"></i> Updated: <span id="viewNoteUpdateDate"></span></span>
                </div>

                <div class="mb-4">
                    <h6 class="text-uppercase text-muted font-size-11 fw-bold mb-2">Note Content</h6>
                    <div id="viewNoteDesc" class="p-3 bg-light rounded font-size-13 text-dark" style="white-space: pre-wrap; line-height: 1.6; border: 1px solid #e2e8f0; min-height: 90px;"></div>
                </div>

                <div>
                    <h6 class="text-uppercase text-muted font-size-11 fw-bold mb-2">
                        <i class="fa-solid fa-paperclip me-1 text-primary"></i> Attached Files (<span id="viewNoteFilesCount">0</span>)
                    </h6>
                    <div id="viewNoteFilesList" class="row g-2"></div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-danger me-auto" id="btnDeleteFromView">
                    <i class="fa-solid fa-trash-can me-1"></i> Delete
                </button>
                <button type="button" class="btn btn-primary" id="btnEditFromView">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit Note
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var currentViewMode = 'grid'; // 'grid' or 'table'
    var currentPage = 1;
    var pageSize = 12;
    var stagedFiles = []; // Array of new files to upload
    var activeNoteData = null; // currently viewed/edited note

    var isEditLoading = false; // Flag to prevent auto-overwriting title during edit load

    $(document).ready(function () {
        // Initialize Select2 for Complaint Reference search
        initComplaintSelect2();

        // Load initial summary and notes
        loadNotesSummary();
        loadNotes(1);

        // Filter events
        var searchTimer = null;
        $('#txtSearch').on('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
                loadNotes(1);
            }, 300);
        });

        $('#ddlNoteType, #txtFromDate, #txtToDate').on('change', function () {
            loadNotes(1);
        });

        $('#btnResetFilters').on('click', function () {
            $('#txtSearch').val('');
            $('#ddlNoteType').val('');
            $('#txtFromDate').val('');
            $('#txtToDate').val('');
            loadNotes(1);
        });

        // View toggle
        $('#btnViewGrid').on('click', function () {
            currentViewMode = 'grid';
            $('#btnViewGrid').addClass('btn-primary active').removeClass('btn-outline-primary');
            $('#btnViewTable').addClass('btn-outline-primary').removeClass('btn-primary active');
            $('#notesTableContainer').addClass('d-none');
            $('#notesGridContainer').removeClass('d-none');
            renderNotes();
        });

        $('#btnViewTable').on('click', function () {
            currentViewMode = 'table';
            $('#btnViewTable').addClass('btn-primary active').removeClass('btn-outline-primary');
            $('#btnViewGrid').addClass('btn-outline-primary').removeClass('btn-primary active');
            $('#notesGridContainer').addClass('d-none');
            $('#notesTableContainer').removeClass('d-none');
            renderNotes();
        });

        // Open Add Modal
        $('#btnOpenAddModal').on('click', function () {
            resetNoteForm();
            $('#modalNoteTitle').html('<i class="fa-solid fa-pen-to-square me-2"></i>Create New Note');
            $('#modalNote').modal('show');
        });

        // Save Note Submit
        $('#btnSaveNote').on('click', function () {
            saveNote();
        });

        // Note Category / Type dynamic field toggling
        $('#txtNoteType').on('change', function () {
            var selectedType = $(this).val();
            if (selectedType === 'Complaint Note') {
                $('#colNoteRef').removeClass('d-none');
                $('#colNoteType').removeClass('col-md-12').addClass('col-md-5');
                if (!isEditLoading && $('#txtNoteRef').val() && !$('#txtNoteTitle').val().trim()) {
                    $('#txtNoteRef').trigger('change');
                }
            } else {
                $('#colNoteRef').addClass('d-none');
                $('#colNoteType').removeClass('col-md-5').addClass('col-md-12');
                $('#txtNoteRef').val('').trigger('change');
            }
        });

        // Auto-generate Note Title / Subject when Reference Complaint is selected under Complaint Note
        $('#txtNoteRef').on('change', function () {
            if (isEditLoading) return;

            var selectedType = $('#txtNoteType').val();
            var selectedRefId = $(this).val();

            if (selectedType === 'Complaint Note' && selectedRefId) {
                // Find selected complaint in preloaded list
                var comp = null;
                for (var i = 0; i < allComplaintsList.length; i++) {
                    if (allComplaintsList[i].id == selectedRefId) {
                        comp = allComplaintsList[i];
                        break;
                    }
                }

                var genTitle = '';
                if (comp) {
                    genTitle = 'Complaint Note - ' + comp.complaintNumber;
                    if (comp.fullName) {
                        genTitle += ' - ' + comp.fullName;
                    }
                } else {
                    var selectedText = $(this).find('option:selected').text();
                    if (selectedText && selectedText.indexOf('--') === -1) {
                        var cleanText = selectedText.replace(/\s*\([^\)]*\)\s*$/, '').trim();
                        genTitle = 'Complaint Note - ' + cleanText;
                    }
                }

                if (genTitle) {
                    $('#txtNoteTitle').val(genTitle);
                }
            }
        });

        // Safe file dropzone click and drag & drop support
        var $dropzone = $('#dropzoneFiles');

        $dropzone.on('click', function (e) {
            if ($(e.target).closest('button').length > 0) return;
            e.preventDefault();
            e.stopPropagation();
            triggerFileInput();
        });

        $dropzone.on('dragenter dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).addClass('dropzone-active');
        });

        $dropzone.on('dragleave dragend drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dropzone-active');
        });

        $dropzone.on('drop', function (e) {
            var dt = e.originalEvent.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                handleDroppedFiles(dt.files);
            }
        });

        // Edit from View Modal
        $('#btnEditFromView').on('click', function () {
            if (activeNoteData) {
                $('#modalViewNote').modal('hide');
                openEditModal(activeNoteData.Id);
            }
        });

        // Delete from View Modal
        $('#btnDeleteFromView').on('click', function () {
            if (activeNoteData) {
                confirmDeleteNote(activeNoteData.Id, activeNoteData.NoteTitle);
            }
        });
    });

    var allComplaintsList = [];

    function initComplaintSelect2() {
        $.ajax({
            url: '/Notes/GetAllComplaints',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.success && res.results) {
                    allComplaintsList = res.results;
                    renderComplaintSelectOptions();
                }
            }
        });
    }

    function renderComplaintSelectOptions(selectedId) {
        var $ref = $('#txtNoteRef');
        $ref.empty();
        $ref.append('<option value="">-- No Complaint Linked (Optional) --</option>');
        for (var i = 0; i < allComplaintsList.length; i++) {
            var c = allComplaintsList[i];
            var isSel = (selectedId && selectedId == c.id) ? 'selected' : '';
            $ref.append('<option value="' + c.id + '" ' + isSel + '>' + escapeHtml(c.text) + '</option>');
        }

        $ref.select2({
            dropdownParent: $('#modalNote'),
            placeholder: '-- Select Reference Complaint (Optional) --',
            allowClear: true,
            width: '100%'
        });

        if (selectedId) {
            $ref.val(selectedId).trigger('change');
        }
    }

    // Load Summary Counts
    function loadNotesSummary() {
        $.ajax({
            url: '/Notes/GetNotesSummary',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.success && res.summary) {
                    $('#metricTotal').text(res.summary.TotalCount || 0);
                    $('#metricComplaint').text(res.summary.ComplaintCount || 0);
                    $('#metricGeneral').text(res.summary.GeneralCount || 0);
                    $('#metricAttachedFiles').text(res.summary.AttachedFilesCount || 0);
                }
            }
        });
    }

    // Load Notes via AJAX
    var currentNotesList = [];
    function loadNotes(page) {
        if (page) currentPage = page;

        var searchValue = $('#txtSearch').val().trim();
        var noteType = $('#ddlNoteType').val();
        var fromDate = $('#txtFromDate').val();
        var toDate = $('#txtToDate').val();

        $('#notesLoading').removeClass('d-none');
        $('#notesGridContainer, #notesTableContainer, #notesEmptyState').addClass('d-none');

        $.ajax({
            url: '/Notes/GetNotesList',
            type: 'POST',
            data: {
                searchValue: searchValue,
                noteType: noteType,
                fromDate: fromDate,
                toDate: toDate,
                pageNo: currentPage,
                pageSize: pageSize
            },
            dataType: 'json',
            success: function (res) {
                $('#notesLoading').addClass('d-none');
                if (res.success) {
                    currentNotesList = res.data || [];
                    renderNotes();
                    renderPagination(res.total, res.page, res.totalPages);
                } else {
                    Swal.fire('Error', res.message || 'Could not load notes', 'error');
                }
            },
            error: function () {
                $('#notesLoading').addClass('d-none');
                Swal.fire('Error', 'An error occurred while loading notes.', 'error');
            }
        });
    }

    function renderNotes() {
        if (!currentNotesList || currentNotesList.length === 0) {
            $('#notesGridContainer, #notesTableContainer').addClass('d-none');
            $('#notesEmptyState').removeClass('d-none');
            return;
        }

        $('#notesEmptyState').addClass('d-none');

        if (currentViewMode === 'grid') {
            $('#notesTableContainer').addClass('d-none');
            $('#notesGridContainer').removeClass('d-none');
            renderGridView();
        } else {
            $('#notesGridContainer').addClass('d-none');
            $('#notesTableContainer').removeClass('d-none');
            renderTableView();
        }
    }

    function getBadgeClass(type) {
        var t = (type || '').toLowerCase();
        if (t.indexOf('complaint') !== -1) return 'badge-complaint';
        if (t.indexOf('general') !== -1) return 'badge-general';
        return 'badge-other';
    }

    function escapeHtml(text) {
        if (!text) return '';
        return $('<div>').text(text).html();
    }

    function renderGridView() {
        var html = '';
        for (var i = 0; i < currentNotesList.length; i++) {
            var n = currentNotesList[i];
            var badgeClass = getBadgeClass(n.NoteType);
            var safeTitle = escapeHtml(n.NoteTitle);
            var safeDesc = escapeHtml(n.NoteDescription);

            var refHtml = '';
            if (n.ComplaintNumber) {
                var compDetails = escapeHtml(n.ComplaintNumber);
                if (n.ComplainantName) {
                    compDetails += ' &bull; ' + escapeHtml(n.ComplainantName);
                }
                refHtml = '<a href="javascript:void(0)" onclick="viewNote(' + n.Id + ')" class="note-ref-badge" title="Reference: ' + escapeHtml(n.ComplaintNumber) + (n.ComplainantName ? ' (' + escapeHtml(n.ComplainantName) + ')' : '') + '">' +
                          '<i class="fa-solid fa-scale-balanced"></i> ' + compDetails +
                          '</a>';
            }

            var fileBadge = '';
            if (n.FileCount > 0) {
                fileBadge = '<span class="file-pill"><i class="fa-solid fa-paperclip"></i> ' + n.FileCount + '</span>';
            }

            html += '<div class="note-card">' +
                    '  <div>' +
                    '    <div class="d-flex justify-content-between align-items-center mb-1">' +
                    '      <span class="note-type-badge ' + badgeClass + '">' + escapeHtml(n.NoteType || 'General') + '</span>' +
                    '      ' + fileBadge +
                    '    </div>' +
                    '    <h3 class="note-title-text" onclick="viewNote(' + n.Id + ')" style="cursor:pointer;" title="' + safeTitle + '">' + safeTitle + '</h3>' +
                    '    ' + refHtml +
                    '    <p class="note-desc-text">' + safeDesc + '</p>' +
                    '  </div>' +
                    '  <div class="note-meta-row">' +
                    '    <span><i class="fa-regular fa-calendar-check me-1"></i>' + escapeHtml(n.SCreateDate) + '</span>' +
                    '    <div class="d-flex gap-1">' +
                    '      <button class="note-actions-btn" onclick="viewNote(' + n.Id + ')" title="View Details"><i class="fa-regular fa-eye"></i></button>' +
                    '      <button class="note-actions-btn" onclick="openEditModal(' + n.Id + ')" title="Edit Note"><i class="fa-regular fa-pen-to-square"></i></button>' +
                    '      <button class="note-actions-btn delete-btn" onclick="confirmDeleteNote(' + n.Id + ', \'' + safeTitle.replace(/'/g, "\\'") + '\')" title="Delete Note"><i class="fa-regular fa-trash-can"></i></button>' +
                    '    </div>' +
                    '  </div>' +
                    '</div>';
        }
        $('#notesGridContainer').html(html);
    }

    function renderTableView() {
        var html = '';
        for (var i = 0; i < currentNotesList.length; i++) {
            var n = currentNotesList[i];
            var badgeClass = getBadgeClass(n.NoteType);
            var safeTitle = escapeHtml(n.NoteTitle);
            var safeDesc = escapeHtml(n.NoteDescription);

            var refText = '<span class="text-muted">-</span>';
            if (n.ComplaintNumber) {
                refText = '<div class="d-flex flex-column">' +
                          '  <span class="fw-semibold text-primary"><i class="fa-solid fa-scale-balanced me-1"></i>' + escapeHtml(n.ComplaintNumber) + '</span>' +
                          (n.ComplainantName ? ('  <small class="text-muted text-truncate" style="max-width: 170px;" title="' + escapeHtml(n.ComplainantName) + '">' + escapeHtml(n.ComplainantName) + '</small>') : '') +
                          '</div>';
            }
            var filesHtml = n.FileCount > 0 ? ('<span class="badge bg-secondary"><i class="fa-solid fa-paperclip me-1"></i>' + n.FileCount + '</span>') : '<span class="text-muted">0</span>';

            html += '<tr>' +
                    '  <td class="text-muted font-size-12">' + (n.RowNum || (i + 1)) + '</td>' +
                    '  <td><span class="note-type-badge ' + badgeClass + '">' + escapeHtml(n.NoteType || 'General') + '</span></td>' +
                    '  <td><a href="javascript:void(0)" onclick="viewNote(' + n.Id + ')" class="fw-bold text-dark text-decoration-none">' + safeTitle + '</a></td>' +
                    '  <td>' + refText + '</td>' +
                    '  <td><div class="text-truncate text-muted font-size-12" style="max-width: 250px;">' + safeDesc + '</div></td>' +
                    '  <td class="text-center">' + filesHtml + '</td>' +
                    '  <td class="font-size-12 text-muted">' + escapeHtml(n.SCreateDate) + '</td>' +
                    '  <td class="text-end">' +
                    '    <div class="d-inline-flex gap-1">' +
                    '      <button class="note-actions-btn" onclick="viewNote(' + n.Id + ')" title="View"><i class="fa-regular fa-eye"></i></button>' +
                    '      <button class="note-actions-btn" onclick="openEditModal(' + n.Id + ')" title="Edit"><i class="fa-regular fa-pen-to-square"></i></button>' +
                    '      <button class="note-actions-btn delete-btn" onclick="confirmDeleteNote(' + n.Id + ', \'' + safeTitle.replace(/'/g, "\\'") + '\')" title="Delete"><i class="fa-regular fa-trash-can"></i></button>' +
                    '    </div>' +
                    '  </td>' +
                    '</tr>';
        }
        $('#notesTableBody').html(html);
    }

    function renderPagination(total, page, totalPages) {
        if (!total || total === 0) {
            $('#notesPaginationRow').addClass('d-none');
            return;
        }

        $('#notesPaginationRow').removeClass('d-none');
        var start = (page - 1) * pageSize + 1;
        var end = Math.min(page * pageSize, total);
        $('#notesCountInfo').text('Showing ' + start + ' to ' + end + ' of ' + total + ' notes (Login User Wise)');

        var html = '';
        var prevDisabled = page <= 1 ? 'disabled' : '';
        html += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0)" onclick="loadNotes(' + (page - 1) + ')">&laquo;</a></li>';

        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, page + 2);

        for (var p = startPage; p <= endPage; p++) {
            var activeClass = p === page ? 'active' : '';
            html += '<li class="page-item ' + activeClass + '"><a class="page-link" href="javascript:void(0)" onclick="loadNotes(' + p + ')">' + p + '</a></li>';
        }

        var nextDisabled = page >= totalPages ? 'disabled' : '';
        html += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0)" onclick="loadNotes(' + (page + 1) + ')">&raquo;</a></li>';

        $('#notesPagination').html(html);
    }

    // View Note Details
    function viewNote(id) {
        $.ajax({
            url: '/Notes/GetNoteById',
            type: 'POST',
            data: { id: id },
            dataType: 'json',
            success: function (res) {
                if (res.success && res.data) {
                    activeNoteData = res.data;
                    var n = res.data;

                    $('#viewNoteTitle').text(n.NoteTitle);
                    $('#viewNoteTypeBadge').attr('class', 'note-type-badge ' + getBadgeClass(n.NoteType)).text(n.NoteType || 'General');

                    if (n.ComplaintNumber) {
                        $('#viewNoteRefBadge').removeClass('d-none').html('<i class="fa-solid fa-scale-balanced me-1"></i> Reference: ' + escapeHtml(n.ComplaintNumber) + (n.ComplainantName ? ' (' + escapeHtml(n.ComplainantName) + ')' : ''));
                    } else {
                        $('#viewNoteRefBadge').addClass('d-none');
                    }

                    $('#viewNoteDate').text(n.SCreateDate || '-');
                    $('#viewNoteUser').text(n.CreateUserName || 'Admin');

                    if (n.SUpdateDate) {
                        $('#viewNoteUpdated').removeClass('d-none');
                        $('#viewNoteUpdateDate').text(n.SUpdateDate);
                    } else {
                        $('#viewNoteUpdated').addClass('d-none');
                    }

                    $('#viewNoteDesc').text(n.NoteDescription || '');

                    // Render files
                    var files = n.Files || [];
                    $('#viewNoteFilesCount').text(files.length);
                    var filesHtml = '';
                    if (files.length > 0) {
                        for (var i = 0; i < files.length; i++) {
                            var f = files[i];
                            var icon = getFileIcon(f.FileType, f.FileName);
                            filesHtml += '<div class="col-md-6">' +
                                         '  <div class="existing-file-item">' +
                                         '    <div class="d-flex align-items-center gap-2 overflow-hidden">' +
                                         '      ' + icon +
                                         '      <a href="' + escapeHtml(f.FilePath) + '" target="_blank" class="existing-file-name text-decoration-none" title="' + escapeHtml(f.FileName) + '">' + escapeHtml(f.FileName) + '</a>' +
                                         '    </div>' +
                                         '    <a href="' + escapeHtml(f.FilePath) + '" download="' + escapeHtml(f.FileName) + '" class="btn btn-sm btn-light border py-1 px-2" title="Download"><i class="fa-solid fa-download"></i></a>' +
                                         '  </div>' +
                                         '</div>';
                        }
                    } else {
                        filesHtml = '<div class="col-12 text-muted font-size-12 fst-italic">No documents attached to this note.</div>';
                    }
                    $('#viewNoteFilesList').html(filesHtml);

                    $('#modalViewNote').modal('show');
                } else {
                    Swal.fire('Error', res.message || 'Note details not found', 'error');
                }
            }
        });
    }

    function getFileIcon(type, fileName) {
        var name = (fileName || '').toLowerCase();
        if (name.endsWith('.pdf')) return '<i class="fa-solid fa-file-pdf text-danger font-size-18"></i>';
        if (name.endsWith('.doc') || name.endsWith('.docx')) return '<i class="fa-solid fa-file-word text-primary font-size-18"></i>';
        if (name.endsWith('.xls') || name.endsWith('.xlsx')) return '<i class="fa-solid fa-file-excel text-success font-size-18"></i>';
        if (name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.png') || name.endsWith('.gif')) return '<i class="fa-solid fa-file-image text-warning font-size-18"></i>';
        return '<i class="fa-solid fa-file text-secondary font-size-18"></i>';
    }

    // Reset Form
    function resetNoteForm() {
        isEditLoading = true;
        $('#noteId').val('0');
        $('#txtNoteType').val('Complaint Note').trigger('change');
        $('#txtNoteTitle').val('');
        $('#txtNoteDesc').val('');
        $('#txtNoteRef').val('').trigger('change');
        clearAllSelectedFiles();
        $('#existingFilesSection').addClass('d-none');
        $('#existingFilesList').html('');
        isEditLoading = false;
    }

    // Open Edit Modal
    function openEditModal(id) {
        resetNoteForm();
        $.ajax({
            url: '/Notes/GetNoteById',
            type: 'POST',
            data: { id: id },
            dataType: 'json',
            success: function (res) {
                if (res.success && res.data) {
                    var n = res.data;
                    isEditLoading = true;
                    $('#noteId').val(n.Id);

                    var typeVal = 'Complaint Note';
                    if (n.NoteType && n.NoteType.toLowerCase().indexOf('general') !== -1) {
                        typeVal = 'General Note';
                    }
                    $('#txtNoteType').val(typeVal).trigger('change');
                    $('#txtNoteTitle').val(n.NoteTitle || '');
                    $('#txtNoteDesc').val(n.NoteDescription || '');

                    if (typeVal === 'Complaint Note' && n.NoteReferanceId) {
                        if ($('#txtNoteRef option[value="' + n.NoteReferanceId + '"]').length === 0 && n.ComplaintNumber) {
                            var option = new Option(n.ComplaintNumber + (n.ComplainantName ? ' - ' + n.ComplainantName : ''), n.NoteReferanceId, true, true);
                            $('#txtNoteRef').append(option);
                        }
                        $('#txtNoteRef').val(n.NoteReferanceId).trigger('change');
                    }
                    isEditLoading = false;

                    // Existing files
                    if (n.Files && n.Files.length > 0) {
                        $('#existingFilesSection').removeClass('d-none');
                        var html = '';
                        for (var i = 0; i < n.Files.length; i++) {
                            var f = n.Files[i];
                            var icon = getFileIcon(f.FileType, f.FileName);
                            html += '<div class="existing-file-item" id="fileRow_' + f.Id + '">' +
                                    '  <div class="d-flex align-items-center gap-2 overflow-hidden">' +
                                    '    ' + icon +
                                    '    <span class="existing-file-name" title="' + escapeHtml(f.FileName) + '">' + escapeHtml(f.FileName) + '</span>' +
                                    '  </div>' +
                                    '  <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="deleteExistingFile(' + f.Id + ')" title="Remove Attachment"><i class="fa-solid fa-xmark"></i></button>' +
                                    '</div>';
                        }
                        $('#existingFilesList').html(html);
                    }

                    $('#modalNoteTitle').html('<i class="fa-solid fa-pen-to-square me-2"></i>Edit Note');
                    $('#modalNote').modal('show');
                } else {
                    Swal.fire('Error', res.message || 'Could not load note for editing', 'error');
                }
            }
        });
    }

    // File selection management (Multi-File support via dynamic native inputs)
    var stagedFiles = [];

    function triggerFileInput() {
        var inputId = 'file_inp_' + Date.now() + '_' + Math.floor(Math.random() * 10000);
        var $input = $('<input type="file" multiple="multiple" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.webp,.txt" class="d-none" id="' + inputId + '" />');
        $('#stagedInputsContainer').append($input);

        $input.on('change', function () {
            var files = this.files;
            if (!files || files.length === 0) {
                $(this).remove();
                return;
            }

            var maxFileSize = 50 * 1024 * 1024; // 50MB
            var addedCount = 0;

            for (var i = 0; i < files.length; i++) {
                var f = files[i];
                if (f.size > maxFileSize) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'File Too Large',
                        text: 'File "' + f.name + '" exceeds the 50MB limit and was skipped.'
                    });
                    continue;
                }

                addedCount++;
                var uid = 'uid_' + Date.now() + '_' + Math.floor(Math.random() * 100000) + '_' + i;
                stagedFiles.push({
                    uid: uid,
                    file: f,
                    name: f.name,
                    size: f.size,
                    inputId: inputId,
                    fileIndex: i
                });
            }

            if (addedCount === 0) {
                $(this).remove();
            }

            renderSelectedFiles();
        });

        $input.trigger('click');
    }

    function handleDroppedFiles(files) {
        if (!files || files.length === 0) return;
        var maxFileSize = 50 * 1024 * 1024;
        for (var i = 0; i < files.length; i++) {
            var f = files[i];
            if (f.size > maxFileSize) {
                Swal.fire({
                    icon: 'warning',
                    title: 'File Too Large',
                    text: 'File "' + f.name + '" exceeds the 50MB limit and was skipped.'
                });
                continue;
            }

            var uid = 'uid_' + Date.now() + '_' + Math.floor(Math.random() * 100000) + '_' + i;
            stagedFiles.push({
                uid: uid,
                file: f,
                name: f.name,
                size: f.size,
                inputId: null,
                fileIndex: i
            });
        }
        renderSelectedFiles();
    }

    function removeSelectedFile(uid) {
        stagedFiles = stagedFiles.filter(function (item) {
            return item.uid !== uid;
        });
        renderSelectedFiles();
    }

    function clearAllSelectedFiles() {
        stagedFiles = [];
        $('#stagedInputsContainer').empty();
        renderSelectedFiles();
    }

    function renderSelectedFiles() {
        var $list = $('#newFilesList');
        if (!stagedFiles || stagedFiles.length === 0) {
            $list.html('');
            return;
        }

        var totalBytes = 0;
        for (var i = 0; i < stagedFiles.length; i++) {
            totalBytes += stagedFiles[i].size;
        }
        var totalKb = Math.round(totalBytes / 1024);
        var totalStr = totalKb > 1024 ? (totalKb / 1024).toFixed(1) + ' MB' : totalKb + ' KB';

        var html = '<div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded border">' +
                   '  <div class="d-flex align-items-center gap-2">' +
                   '    <span class="badge bg-primary font-size-11"><i class="fa-solid fa-paperclip me-1"></i>' + stagedFiles.length + ' File(s) Selected</span>' +
                   '    <span class="text-muted font-size-11">Total: ' + totalStr + '</span>' +
                   '  </div>' +
                   '  <div class="d-flex gap-1">' +
                   '    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 font-size-11" onclick="triggerFileInput();" title="Add more files">' +
                   '      <i class="fa-solid fa-plus me-1"></i> Add More Files' +
                   '    </button>' +
                   '    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 font-size-11" onclick="clearAllSelectedFiles()" title="Clear all attachments">' +
                   '      <i class="fa-solid fa-trash-can me-1"></i> Clear All' +
                   '    </button>' +
                   '  </div>' +
                   '</div>' +
                   '<div class="selected-files-scroll" style="max-height: 180px; overflow-y: auto;">';

        for (var i = 0; i < stagedFiles.length; i++) {
            var item = stagedFiles[i];
            var sizeKb = Math.round(item.size / 1024);
            var sizeStr = sizeKb > 1024 ? (sizeKb / 1024).toFixed(1) + ' MB' : sizeKb + ' KB';
            var icon = getFileIcon('', item.name);

            html += '<div class="existing-file-item bg-white mb-2 shadow-sm" id="newFileItem_' + item.uid + '">' +
                    '  <div class="d-flex align-items-center gap-2 overflow-hidden" style="max-width: 80%;">' +
                    '    ' + icon +
                    '    <span class="existing-file-name text-dark font-size-12 fw-semibold" title="' + escapeHtml(item.name) + '">' + escapeHtml(item.name) + '</span>' +
                    '    <span class="text-muted font-size-11 flex-shrink-0">(' + sizeStr + ')</span>' +
                    '  </div>' +
                    '  <div class="d-flex align-items-center gap-2">' +
                    '    <span class="badge bg-success font-size-10">Ready</span>' +
                    '    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeSelectedFile(\'' + item.uid + '\')" title="Remove File"><i class="fa-solid fa-xmark"></i></button>' +
                    '  </div>' +
                    '</div>';
        }
        html += '</div>';

        $list.html(html);
    }

    // Delete existing attachment from note
    function deleteExistingFile(fileId) {
        Swal.fire({
            title: 'Remove File?',
            text: 'Are you sure you want to remove this attached file?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, remove'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Notes/DeleteNoteFile',
                    type: 'POST',
                    data: { fileId: fileId },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            $('#fileRow_' + fileId).fadeOut(200, function () { $(this).remove(); });
                            Swal.fire({
                                icon: 'success',
                                title: 'Removed',
                                text: 'File attachment has been removed.',
                                timer: 1200,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire('Error', res.message || 'Could not remove file', 'error');
                        }
                    }
                });
            }
        });
    }

    // Save Note
    function saveNote() {
        var noteTitle = $('#txtNoteTitle').val().trim();
        var noteDesc = $('#txtNoteDesc').val().trim();
        var noteType = $('#txtNoteType').val();
        var noteRef = $('#txtNoteRef').val();
        var id = $('#noteId').val() || 0;

        if (!noteTitle) {
            Swal.fire('Required', 'Please enter a note title.', 'warning');
            $('#txtNoteTitle').focus();
            return;
        }

        if (!noteDesc) {
            Swal.fire('Required', 'Please enter note content/description.', 'warning');
            $('#txtNoteDesc').focus();
            return;
        }

        var formData = new FormData();
        formData.append('id', id);
        formData.append('noteType', noteType);
        formData.append('noteTitle', noteTitle);
        formData.append('noteReferanceId', noteRef ? noteRef : '');
        formData.append('noteDescription', noteDesc);

        // Append all staged files to FormData
        if (stagedFiles && stagedFiles.length > 0) {
            for (var i = 0; i < stagedFiles.length; i++) {
                formData.append('files', stagedFiles[i].file);
            }
        }

        $('#btnSaveNote').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

        $.ajax({
            url: '/Notes/SaveNote',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            dataType: 'json',
            success: function (res) {
                $('#btnSaveNote').prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Save Note');
                if (res.success) {
                    $('#modalNote').modal('hide');
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: res.message || 'Note saved successfully!',
                        timer: 1600,
                        showConfirmButton: false
                    });
                    loadNotesSummary();
                    loadNotes(currentPage);
                } else {
                    Swal.fire('Error', res.message || 'Failed to save note.', 'error');
                }
            },
            error: function () {
                $('#btnSaveNote').prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Save Note');
                Swal.fire('Error', 'An unexpected error occurred while saving the note.', 'error');
            }
        });
    }

    // Delete Note
    function confirmDeleteNote(id, title) {
        Swal.fire({
            title: 'Delete Note?',
            html: 'Are you sure you want to delete note: <strong>' + escapeHtml(title) + '</strong>?<br><small class="text-muted">Attached files will also be removed.</small>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, delete it'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Notes/DeleteNote',
                    type: 'POST',
                    data: { id: id },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            $('#modalViewNote').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: res.message || 'Note has been deleted.',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            loadNotesSummary();
                            loadNotes(currentPage);
                        } else {
                            Swal.fire('Error', res.message || 'Could not delete note.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'An error occurred while deleting the note.', 'error');
                    }
                });
            }
        });
    }
</script>
