
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DC Member - Login</title>
    <link rel="shortcut icon" href="/assets/img/logo.ico" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css">
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/Site.css" rel="stylesheet" />

</head>
<body>
    <div class="account-pages my-5 pt-sm-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card overflow-hidden">
                        <div class="bg-primary bg-soft">
                            <div class="row">
                                <div class="col-7">
                                    <div class="text-primary p-4">
                                        <h5 class="text-primary">Welcome Back !</h5>
                                        <p>Login in to continue to BCG.</p>
                                    </div>
                                </div>
                                <div class="col-5 align-self-end">
                                    <img src="" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="card-body pt-0">
                            <div class="auth-logo">
                                <a href="" class="auth-logo-light">
                                    <div class="avatar-md profile-user-wid mb-4">
                                        <span class="avatar-title rounded-circle bg-light">
                                            <img class="rounded-circle" height="60" src="~/assets/img/logo.png" />
                                        </span>
                                    </div>
                                </a>

                                <a href="" class="auth-logo-dark">
                                    <div class="avatar-md profile-user-wid mb-4">
                                        <span class="avatar-title rounded-circle bg-light">
                                            <img class="rounded-circle" height="60" src="~/assets/img/logo.png" />
                                        </span>
                                    </div>
                                </a>
                            </div>
                            <div class="p-2">
                                <div class="mb-3">
                                    <label for="username" class="form-label">Mobile Number</label>
                                    <input type="text" class="form-control" id="txtMobileNumber" placeholder="Enter Mobile Number">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">OTP</label>
                                    <div class="input-group auth-pass-inputgroup">
                                        <input type="text" class="form-control" name="txtPassword" id="txtPassword" placeholder="Enter password" aria-label="Password" aria-describedby="password-addon">
                                        <a class="btn btn-light  btn-sm" id="password-addon"><i class="lar la-eye"></i></a>
                                    </div>
                                </div>

                                <div class="mt-3 d-grid">
                                    <a class="btn btn-outline-primary waves-effect waves-light btn-sm" id="lnkLogin">Log In</a>
                                </div>

                                <div class="mt-4 text-center">
                                    <a href="" class="text-muted"><i class="mdi mdi-lock me-1"></i> Forgot your password?</a>
                                </div>

                            </div>

                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/metisMenu.min.js"></script>
    <script src="~/assets/js/simplebar.min.js"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
    <script>
        $('#lnkLogin').on('click', function (e) {
            var VUserName = $("#txtUserName").val();
            var VPassword = $("#txtPassword").val();
            var IsLogin = 1;

            if (VUserName == null) {
                IsLogin = 0;
                swal("Please input username", "", "error");
                return;
            }

            if (VUserName == '') {
                IsLogin = 0;
                swal("Please input username", "", "error");
                return;
            }

            if (VPassword == null) {
                IsLogin = 0;
                swal("Please input password", "", "error");
                return;
            }

            if (VPassword == '') {
                IsLogin = 0;
                swal("Please input password", "", "error");
                return;
            }

            if (IsLogin == 1) {
                var VUserName = $("#txtUserName").val();
                var VPassword = $("#txtPassword").val();
                var Logindata = JSON.stringify({
                    UserName: VUserName,
                    Password: VPassword,
                    PCIPAddress: ''
                });
                $.when(UserLogin(Logindata))
                .then(function (response) { })
                .fail(function (err) {
                    console.log(err);
                });
                //    e.preventDefault();
                //    return $.ajax({
                //        url: 'https://api4.my-ip.io/ip.json',
                //        method: 'GET'
                //    })
                //   .done(function (data) {
                //       localStorage.setItem("PCIPAddress", data.ip);
                //       UserLoginMethod(data.ip);
                //   })
                //   .fail(function () {
                //       UserLoginMethod('');
                //   });
            }
        });

        function UserLoginMethod(PCIPAddress) {
            var VUserName = $("#txtUserName").val();
            var VPassword = $("#txtPassword").val();
            var Logindata = JSON.stringify({
                UserName: VUserName,
                Password: VPassword,
                PCIPAddress: PCIPAddress
            });
            $.when(UserLogin(Logindata))
            .then(function (response) { })
            .fail(function (err) {
                console.log(err);
            });
        };

        function UserLogin(data) {

            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: "/Home/UserLogin",
                data: data,
                success: function (result) {
                    if (result.data == "Success") {
                        var url = '/Home/Index';
                        location.href = url;
                    }
                    else if (result.ReturnStatus == 'N' || result.ReturnStatus == null) {
                        swal('You have no access', "", "error");
                    }
                    else {
                        swal("Office Admin Login", "", "error");
                    }
                },
                error: function () {
                    swal('Opps! Something Went Wrong', "", "error");
                }
            });
        }

    </script>
</body>
</html>
