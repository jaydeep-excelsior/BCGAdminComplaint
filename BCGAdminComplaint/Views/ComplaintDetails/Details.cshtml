                <div class="title">Email</div>
                <div class="description">@ViewBag.EmailAddress</div>
            </div>
            <div class="col-md-4 col-sm-6 col-12 mt-3">
                <div class="title">Mobile No.</div>
                <div class="description">@ViewBag.ContactNumber</div>
            </div>
            <div class="col-md-12 col-sm-12 col-12 mt-3">
                <div class="title">Address</div>
                <div class="description">@ViewBag.Address</div>
            </div>

        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card mb-0">
            <div class="card-body">
                <div class="top_belt_new">
                    <h5 class="mb-0">Defendant Details</h5>

                </div>
                <div class="main_scroll_complaint_against">
                    <div class="row">
                        <div class="col-md-12">
                            <label>Do yoy know Mobile No./Name of Advocate? (??? ??? ?????????? ?????? ????/??? ???? ???)</label>
                        </div>
                        <div class="col-md-6">
                            <div class="redio-part1">
                                <input type="radio" id="rdYes" name="yes" value="Y" />
                                <label for="contactChoice2">Yes (??)</label>
                                <input type="radio" id="rdNo" name="no" value="N" />
                                <label for="contactChoice3">No (??)</label>
                            </div>
                        </div>
                    </div>
