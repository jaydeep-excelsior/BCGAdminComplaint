    <div class="col-md-12 col-lg-6 col-xl-4 mt-3 mt-md-3 mt-lg-3 mt-xl-0">
        <div class="card mb-0 h-100">
            <div class="card-body">
                <div class="top_belt_new top_belt_new_border">
                    <h5 class="mb-0">
                        Action Log
                    </h5>
                </div>
                <div class="main_scroll_complaint_against">

                    <div id="logDetails" class="main_log_details_new"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="filePreviewModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mb-0">File Preview</h5>
                    <a class="btn-close btn-sm" data-bs-dismiss="modal" aria-hidden="true"></a>
                </div>
                <div class="modal-body p-0">
                    <iframe src="" id="displayPdf"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="MemberList" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mt-0" id="mySmallModalLabel">Member List</h5>
                    <a  class="btn-close btn-sm" data-dismiss="modal" aria-hidden="true"></a>
                </div>
                <div class="modal-body">
                    <div id="tblMemberList">

                    </div>
                </div>
                <div class="modal-footer justify-content-end">
                    <a  id="btnAddToList" name="btnAddToList" class="btn btn-outline-primary waves-effect waves-light btn-sm">Add</a>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
    </div>

</div>
<script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
<script>
    $(document).ready(function () {
        GetComplaintBankList();
        GetComplaintCurrentStatus();
        GetComplaintPaymentDetail();
        GetOtherList();
        GetStatusLogDetails();
        GetDcNumberList();
        GetLogList();
        $("#txtOrderSummary").val('');
    });

    function isNumberKey(evt, element) {

        var charCode = (evt.which) ? evt.which : event.keyCode
        //if (charCode > 31 && (charCode < 48 || charCode > 57) && !(charCode == 8) && (charCode == 46 || charCode == 44))
        if (charCode >= 48 && charCode <= 57)
            return true;
        else {
            swal("Please enter valid number.", "", "error");
            return false;
        }
        return false;
    }

    function openFiledialog() {
        $("#fileLoader").click();
    }

    $('#rdYes').on('click', function () {
        $('#rdYes').prop('checked');
        $('#rdNo').prop('checked', false);
        $('#selectDetails').css('display', 'block');
        $('#addDetails').css('display', 'none');
    });

    $('#rdNo').on('click', function () {
        $('#rdYes').prop('checked', false);
        $('#rdNo').prop('checked');
        $('#addDetails').css('display', 'block');
        $('#selectDetails').css('display', 'none');
    });

    function GetComplaintBankList() {
        $.ajax({
            type: "POST",
            url: "/ComplaintDetails/GetComplaintBankList",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
                if (response.IsSuccess) {
                    if (response.Data != null) {
                        if (response.Data != '') {

                            $.each(response.Data, function (i, item) {
                                $("#ddlBank").append('<option value="' + item.Id + '">' + item.BankName + '</option>');
                            });
                        }
                        else {
                            $("#ddlBank").empty();
                            $("#ddlBank").append('<option value="0">Select</option>');
                        }
                    }
                    else {
                        $("#ddlBank").empty();
                        $("#ddlBank").append('<option value="0">Select</option>');
                    }
                }
                else {
                    $("#ddlBank").empty();
                    $("#ddlBank").append('<option value="0">Select</option>');
                }
            }, failure: function (result) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
            },
            error: function (result) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
            }
        });
    }

    function GetComplaintCurrentStatus() {
        $.ajax({
            type: "POST",
            url: "/ComplaintDetails/GetComplaintCurrentStatus",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ ComplaintId: $("#hdfComplaintId").val() }),
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    if (response.Data != null) {
                        if (response.Data != '') {
                            var VComplaintCurrentStatus = response.Data[0].Status;
                            $('#txtComplaintStatus').text(VComplaintCurrentStatus);
                            $('#drpStatus').val(VComplaintCurrentStatus);
                        }
                        else {
                            var VComplaintCurrentStatus = '';
                            $('#txtComplaintStatus').text(VComplaintCurrentStatus);
                            $('#drpStatus').val(VComplaintCurrentStatus);
                        }
                    }
                    else {
                        var VComplaintCurrentStatus = '';
                        $('#txtComplaintStatus').text(VComplaintCurrentStatus);
                        $('#drpStatus').val(VComplaintCurrentStatus);
                    }
                }
                else {
                    var VComplaintCurrentStatus = '';
                    $('#txtComplaintStatus').text(VComplaintCurrentStatus);
                    $('#drpStatus').val(VComplaintCurrentStatus);
                }
            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

    function GetComplaintPaymentDetail() {
        $.ajax({
            type: "POST",
            url: "/ComplaintDetails/GetComplaintPaymentDetail",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ ComplaintId: $("#hdfComplaintId").val() }),
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    if (response.Data != null) {
                        if (response.Data != '') {
                            var VTotalAmount = response.Data[0].TotalAmount;
                            var VPaidAmount = response.Data[0].PaidAmount;
                            var VDueAmount = response.Data[0].DueAmount;
                            var VPaymentStatus = response.Data[0].PaymentStatus;
                            var VStatus = response.Data[0].Status;

                            $('#lblTotalAmount').html(VTotalAmount);
                            $('#lblPaidAmount').html(VPaidAmount);
                            $('#lblDueAmount').html(VDueAmount);

                            if (VStatus == 'Accepted') {
                                if (VPaymentStatus == 'Pending') {
                                    $('#divPayment').removeClass("d-none");
                                }
                                else {
                                    $('#divPayment').addClass("d-none");
                                }
                            }
                            else {
                                $('#divPayment').addClass("d-none");
                            }
                        }
                        else {
                            $('#lblTotalAmount').html('0');
                            $('#lblPaidAmount').html('0');
                            $('#lblDueAmount').html('0');
                        }
                    }
                    else {
                        $('#lblTotalAmount').html('0');
                        $('#lblPaidAmount').html('0');
                        $('#lblDueAmount').html('0');
                    }
                }
                else {
                    $('#lblTotalAmount').html('0');
                    $('#lblPaidAmount').html('0');
                    $('#lblDueAmount').html('0');
                }
            }, failure: function (result) {
                $('#lblTotalAmount').html('0');
                $('#lblPaidAmount').html('0');
                $('#lblDueAmount').html('0');
            },
            error: function (result) {
                $('#lblTotalAmount').html('0');
                $('#lblPaidAmount').html('0');
                $('#lblDueAmount').html('0');
            }
        });
    }

    $('#lnkSavePayment').on('click', function () {

        var IsSave = 1;
        var VDueAmount = parseFloat($('#lblDueAmount').text() == null ? '0' : $('#lblDueAmount').text() == '' ? '0' : $('#lblDueAmount').text());
        var VPaidOn = $('#txtPaidOn').val() == null ? '' : $('#txtPaidOn').val();
        var VPaymentMode = $('#ddlPaymentMode').val() == null ? '' : $('#ddlPaymentMode').val() == 'Select' ? '' : $('#ddlPaymentMode').val() == '0' ? '' : $('#ddlPaymentMode').val();
        var VTransactionNumber = $('#txtTransactionNumber').val() == null ? '' : $('#txtTransactionNumber').val();
        var VTransactionDate = $('#txtTransactionDate').val() == null ? '' : $('#txtTransactionDate').val();
        var VPaidOn = $('#txtPaidOn').val() == null ? '' : $('#txtPaidOn').val();
        var VBankId = $('#ddlBank').val() == null ? '0' : $('#ddlBank').val() == 'Select' ? '0' : $('#ddlBank').val() == '' ? '0' : $('#ddlBank').val();

        if (VDueAmount <= 0) {
            swal("The due amount is zero.", "", "error");
            IsSave = 0;
            return;
        }

        if (VPaidOn == '') {
            swal("Please input paid on.", "", "error");
            IsSave = 0;
            return;
        }
        if (VPaymentMode == '') {
            swal("Please select payment mode.", "", "error");
            IsSave = 0;
            return;
        }
        if (VPaymentMode != 'CASH') {
            if (VTransactionNumber == '') {
                swal("Please input transaction number.", "", "error");
                IsSave = 0;
                return;
            }
        }
        if (VTransactionDate == '') {
            swal("Please input transaction date.", "", "error");
            IsSave = 0;
            return;
        }
        if (VPaymentMode != 'CASH') {
            if (parseInt(VBankId) == 0) {
                swal("Please select bank.", "", "error");
                IsSave = 0;
                return;
            }
        }

        if (IsSave == 1) {
            var data = JSON.stringify({
                ComplaintId: $("#hdfComplaintId").val(),
                PaidAmount: VDueAmount,
                PaidOn: VPaidOn,
                PaymentMode: VPaymentMode,
                TransactionNumber: VTransactionNumber,
                TransactionDate: VTransactionDate,
                BankId: VBankId
            });

            $.when(SubmitComplaintPayment(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });
        }
    });

    function SubmitComplaintPayment(data) {
        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/ComplaintDetails/GetComplaintPaymentReceived",
            data: data,
            success: function (response) {
                if (response.IsSuccess) {
                    if (response.Data != null) {
                        if (response.Data != '') {
                            swal('Complaint payment received successfully.', "", "success");
                            GetComplaintPaymentDetail();
                            GetComplaintCurrentStatus();
                            $("#txtComplaintStatus").text(response.Data[0].ComplaintStatus)
                        }
                        else {
                            swal('Opps! Something Went Wrong.', "", "success");
                        }
                    }
                    else {
                        swal('Opps! Something Went Wrong.', "", "success");
                    }
                }
                else {
                    swal('Opps! Something Went Wrong.', "", "error");
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                swal('Opps! Something Went Wrong.', "", "error");
            }
        });
    }

