    <div class="col-md-6 col-lg-6 col-xl-4 mt-3 mt-md-0 mt-lg-0 mt-xl-0">
        <div class="card mb-0 h-100">
            <div class="card-body" id="ActionBar">
                <div class="top_belt_new top_belt_new_border">
                    <h5 class="mb-0">Action bar</h5>
                    <select id="drpStatus" class="form-control" onchange="ddlStatusChange()">
                        <option value="" selected>Select Status</option>
                        <option value="New">New</option>
                        <option value="Accepted">Accepted</option>
                        <option value="Rejected">Rejected</option>
                        <option value="More Detail">More Detail</option>
                        <option value="Payment Done">Payment Done</option>
                        <option value="Next General Board">Next General Board</option>
                        <option value="Board Has Approved">Board Has Approved</option>
                        <option value="Board Has Rejected">Board Has Rejected</option>
                        <option value="Hearing">Hearing</option>
                        <option value="Adjunt">Adjunt</option>
                        <option value="Order Passed">Order Passed</option>
                    </select>
                </div>
                <div id="adjuntDetails" style="display:none;">
                    <h6 class="mb-3 border-bottom pb-2">Adjunt Details ( મુલતવી વિગતો )</h6>
                    <div class="row">
                        <div class="col-md-12">
                            <label>Next Date ( આગામી તારીખ )</label>
                            <input name="txtNextDate" id="txtNextDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                        </div>
                        <div class="col-md-12 mt-3">
                            <label>Summary | Short Information ( સારાંશ | ટૂંકી માહિતી )</label>
                            <textarea name="txtSummary" id="txtSummary" placeholder="Please Enter Summary" class="form-control col-md-12" rows="2" cols="20" width="-webkit-fill-available;"></textarea>

                        </div>
                        <div class="form-group col-md-12">
                            <div>
                                <a id="lnkSaveAdjuntDetails" class="btn btn-outline-primary waves-effect waves-light btn-sm"><i class="fa-solid fa-check me-1"></i> Save</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="OrderPassed" style="display:none;">
                    <h5 class="mb-3 border-bottom pb-2">Order Passed Details</h5>
                    <label>Order File</label>
                    <div class="input-group mb-3">
                        <input type="file" class="form-control uploadbtn" name="orderFile" id="orderFile" onchange="ShowPreview(this,'Order')">
                        <input type="hidden" id="hdfB64ImagePath" />
                        <input type="hidden" id="hdfFileName" />
                        <label class="input-group-text" for="orderFile">Upload</label>
                    </div>
                    <div class="col-md-12 d-none">
                        <label>Last UploadFile : <label id="lblLastUploadFile"></label></label>
                    </div>
                    <div class="mt-3">

                        <label>Summary | Short Information ( સારાંશ | ટૂંકી માહિતી )</label>
                        <textarea name="txtOrderSummary" id="txtOrderSummary" placeholder="Please Enter Summary" class="form-control col-md-12" rows="2" cols="20" width="-webkit-fill-available;"></textarea>

                    </div>
                    <div class="form-group mt-3">
                        <div>
                            <a id="lnkSaveOrderDetails" class="btn btn-outline-primary waves-effect waves-light btn-sm"><i class="fa-solid fa-check me-1"></i> Save</a>
                        </div>
                    </div>
                </div>
                <div id="boardAccept" style="display:none;">
                    <h6 class="mb-3">Under the Commitee</h6>
                    <div class="main_under_commitee_select mb-4">
                        <input type="hidden" id="hdfCommitteeId" value="@ViewBag.DcNumber" />
                        <select id="drpDcNo" class="form-control" onchange="ddlDcNumber()">
                            <option value="">Select DcNumber</option>
                        </select>
                        <a id="lnkAddMember" data-toggle="modal" data-target="#MemberList" class="btn btn-sm btn-outline-primary waves-effect waves-light btn-sm">Add Member</a>
                    </div>
                    <div id="tbldcDetails">

                    </div>

                    <div class="row">
                        <div class="form-group col-md-12">
                            <div>
                                <a id="lnkSaveBoardAccept" class="btn btn-outline-primary waves-effect waves-light btn-sm"><i class="fa-solid fa-check me-1"></i> Save</a>
                            </div>
