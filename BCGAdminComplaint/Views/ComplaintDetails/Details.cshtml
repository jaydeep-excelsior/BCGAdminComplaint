                                        <div class="number">@dr["SrNo"].ToString()</div>
                                        <div class="">
                                            <div class="title">Title</div><div class="description">@dr["FileTitle"].ToString()</div>
                                        </div>
                                    </div>
                                    <div class="rigth_side"></div>
                                </div>
                                <div class="main_card_list_body">
                                    <div class="row">
