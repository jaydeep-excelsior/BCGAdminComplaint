@model Tuple<IEnumerable<BCGAdminComplaint.Models.ComplaintListModel>, IEnumerable<BCGAdminComplaint.Models.ComplaintDocumentList>, IEnumerable<BCGAdminComplaint.Models.ComplaintMemberLog>>

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="top_belt_new">
    <h5 class="mb-0">Complaint Details</h5>
    <div class="d-flex">

        <div class="me-2">
            <span id="txtComplaintStatus" class="btn btn-primary btn-sm fw-bold" style="pointer-events: none;">@ViewBag.Status</span>
        </div>
        <div class="me-2">
            <a class="btn btn-outline-primary waves-effect waves-light white-space-nowrap btn-sm" id="lnkShareACopy"><i class="fa-solid fa-share me-1"></i> Share a copy with the advocate</a>
        </div>
        <div class="me-2">
            <a class="btn btn-outline-primary waves-effect waves-light white-space-nowrap btn-sm" id="lnkDownload"><i class="fa-solid fa-download me-1"></i> Download</a>
        </div>
        <a href="/ComplaintList/Index" class="btn btn-outline-primary waves-effect waves-light white-space-nowrap btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>

    </div>
</div>
<div class="main_card_list">
    <input type="hidden" id="hdfComplaintId" value="@ViewBag.ComplaintId" />
    <input type="hidden" id="hdfStatus" value="@ViewBag.Status" />
    <div class="main_header_card">
        <h5 class="mb-0">Personal Details</h5>
        
    </div>
    <div class="main_card_list_body">
        <div class="row">
            <div class="col-md-4 col-sm-6 col-12 mt-3">
