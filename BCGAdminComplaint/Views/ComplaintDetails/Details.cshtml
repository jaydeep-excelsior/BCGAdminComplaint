    </div>

    <div class="col-md-12 mt-4">

    </div>



    <div class="col-md-6 col-lg-6 col-xl-4">
        <div class="card mb-0 h-100">
            <div class="card-body">
                <div class="top_belt_new">
                    <h5 class="mb-0">Files</h5>
                </div>
                <div class="main_scroll_complaint_against" id="dvOrderPassed">
                    @if (ViewBag.DocumentList != null)
                    {
                        foreach (System.Data.DataRow dr in ViewBag.DocumentList.Rows)
                        {
                            <div class="main_card_list main_card_list_border p-12-custome">
