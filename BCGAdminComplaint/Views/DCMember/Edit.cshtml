
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="customer-list admin-users">
    <div>
        <div class="row mb-2">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-sm-0 font-size-18">Edit DC Member</h4>
                        <div class="page-title-left mt-1">
                            <ol class="breadcrumb m-0 font-size-13">
                                <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/DCMember/Index" class="text-muted">D.C. Member</a></li>
                                <li class="breadcrumb-item active">Edit DC Member</li>
                            </ol>
                        </div>
                    </div>
                    <div class="page-title-right d-flex align-items-center">
                        <a class="btn btn-sm btn-outline-primary text-nowrap" href="@Url.Action("Index", "DCMember")"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="add-customer">
            <div class="row">
                <div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="card border-0 redius-top mb-3">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="ddlMemberType">Member Type<span class="text-danger">*</span></label>
                                            <select id="ddlMemberType" class="form-control">
                                                <option value="">Select Member Type</option>
                                                <option value="B">BCG MEMBER</option>
                                                <option value="O">CO-OPT MEMBER</option>
                                                <option value="S">BCG STAFF</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12" id="divEnrollmentNo">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="txtEnrollment">Enrollment No.<span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="txtEnrollment" placeholder="Enter Enrollment No." />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12" id="divStaffSelect" style="display:none;">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="ddlBCGStaff">Select BCG Staff<span class="text-danger">*</span></label>
                                            <select id="ddlBCGStaff" class="form-control" style="width: 100%;">
                                                <option value="">Select BCG Staff</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="txtName">Full Name</label>
                                            <input type="text" class="form-control" id="txtName" placeholder="Enter Full Name" readonly>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12 mt-3">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="txtContactNo">Contact Number</label>
                                            <input type="text" class="form-control" id="txtContactNo" placeholder="Enter Contact Number" readonly>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12 mt-3">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="txtEmailAddress">Email Address</label>
                                            <input type="email" class="form-control" id="txtEmailAddress" placeholder="Enter Email Address" readonly>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12 mt-3">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="txtBarAssociation">Bar Association</label>
                                            <input type="text" class="form-control" id="txtBarAssociation" placeholder="Enter Bar Association" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-3">
                                    <input type="hidden" id="hdfEditDCMemberId" value="0" />
                                    <a class="btn btn-outline-success waves-effect waves-light btn-sm" id="lnkDCMemberDataSaveRecord"><i class="fas fa-save"></i> Save</a>
                                    <a class="btn btn-outline-danger waves-effect waves-light btn-sm" id="lnkDCMemberDataSaveRecordCancel"><i class="fas fa-times-circle"></i> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdfEnrollmentId" value="0" />

<script>
    var isStaffLoaded = false;

    $(document).ready(function () {
        initStaffSelect2();
        GetRecordDetail();

        $('#ddlMemberType').on('change', function () {
            var mType = $(this).val();
            resetMemberFields();

            if (mType === 'S') {
                $('#divEnrollmentNo').hide();
                $('#divStaffSelect').show();
                $('#txtBarAssociation').val('BCG Staff');

                if (!isStaffLoaded) {
                    loadBCGStaffList();
                } else {
                    $('#ddlBCGStaff').val('').trigger('change.select2');
                }
            } else {
                $('#divStaffSelect').hide();
                $('#divEnrollmentNo').show();
                $('#txtBarAssociation').val('');
            }
        });

        $('#ddlBCGStaff').on('change', function () {
            var regId = $(this).val();
            if (regId && regId !== "" && regId !== "0") {
                var $selected = $(this).find('option:selected');
                $("#hdfEnrollmentId").val(regId);
                $("#txtName").val($selected.data('name') || '');
                $("#txtContactNo").val($selected.data('mobile') || '');
                $("#txtEmailAddress").val($selected.data('email') || '');
                $("#txtBarAssociation").val('BCG Staff');
            } else {
                $("#hdfEnrollmentId").val('0');
                $("#txtName").val('');
                $("#txtContactNo").val('');
                $("#txtEmailAddress").val('');
                if ($('#ddlMemberType').val() === 'S') {
                    $("#txtBarAssociation").val('BCG Staff');
                }
            }
        });
    });

    function initStaffSelect2() {
        if ($.fn.select2) {
            $('#ddlBCGStaff').select2({
                placeholder: "Select BCG Staff",
                allowClear: true,
                width: '100%'
            });
        }
    }

    function loadBCGStaffList(selectedRegisterId) {
        $.ajax({
            type: 'POST',
            url: "/DCMember/GetBCGStaffList",
            success: function (result) {
                if (result != null && result.data != null) {
                    var $staff = $("#ddlBCGStaff");
                    $staff.empty().append('<option value="">Select BCG Staff</option>');
                    $.each(result.data, function (i, item) {
                        $staff.append('<option value="' + item.RegisterId + '" data-name="' + (item.FullName || '') + '" data-mobile="' + (item.ContactNumber || '') + '" data-email="' + (item.EmailAddress || '') + '" data-user="' + (item.UserName || '') + '">' + item.DisplayText + '</option>');
                    });
                    isStaffLoaded = true;
                    initStaffSelect2();

                    if (selectedRegisterId) {
                        $staff.val(selectedRegisterId).trigger('change');
                    }
                }
            },
            error: function () {
                console.log("Error loading BCG Staff list");
            }
        });
    }

    function resetMemberFields() {
        $("#txtEnrollment").val('');
        if ($('#ddlBCGStaff').data('select2')) {
            $('#ddlBCGStaff').val('').trigger('change.select2');
        } else {
            $('#ddlBCGStaff').val('');
        }
        $("#hdfEnrollmentId").val('0');
        $("#txtName").val('');
        $("#txtContactNo").val('');
        $("#txtEmailAddress").val('');
        $("#txtBarAssociation").val('');
    }

    function GetRecordDetail() {
        var urlParams = new URLSearchParams(window.location.search);
        var urlId = urlParams.get('id');
        var VEditDCMemberDataId = urlId || localStorage.getItem("EditDCMemberId") || '0';
        if (urlId) {
            localStorage.setItem("EditDCMemberId", urlId);
        }
        $.ajax({
            type: "POST",
            url: "/DCMember/DCMemberDataEdit",
            data: { id: VEditDCMemberDataId },
            success: DCMemberDataEditOnSuccess,
            error: function (response) { }
        });
    }

    function DCMemberDataEditOnSuccess(response) {
        var row = response.data;
        if (row != null && row != '' && row.length > 0) {
            var d = row[0];
            $("#hdfEditDCMemberId").val(d.Id);
            $("#hdfEnrollmentId").val(d.EnrollmentId);
            $("#ddlMemberType").val(d.MemberType || '');
            $("#txtEmailAddress").val(d.EmailAddress);
            $("#txtName").val(d.Name);
            $("#txtContactNo").val(d.ContactNo);
            $("#txtBarAssociation").val(d.BarAssociation);

            if (d.MemberType === 'S') {
                $('#divEnrollmentNo').hide();
                $('#divStaffSelect').show();
                loadBCGStaffList(d.EnrollmentId);
            } else {
                $('#divStaffSelect').hide();
                $('#divEnrollmentNo').show();
                $("#txtEnrollment").val(d.EnroNumber);
            }
        } else {
            $("#hdfEditDCMemberId").val('0');
            $("#hdfEnrollmentId").val('0');
            $("#txtEnrollment").val('');
            $("#ddlMemberType").val('');
            $("#txtEmailAddress").val('');
            $("#txtName").val('');
            $("#txtContactNo").val('');
            $("#txtBarAssociation").val('');
        }
    }

    $('#lnkDCMemberDataSaveRecordCancel').click(function () { GetRecordDetail(); });

    $('#lnkDCMemberDataSaveRecord').click(function () {
        var VDCMemberId = $("#hdfEditDCMemberId").val() == null ? '0' : $("#hdfEditDCMemberId").val() == '' ? '0' : $("#hdfEditDCMemberId").val();
        if (parseInt(VDCMemberId) == 0) { swal("", "Please select DCMember Id...", "warning"); return; }

        var mType = $("#ddlMemberType").val();
        if (mType == "") { swal("", "Please select Member Type...", "warning"); return; }

        if (mType === 'S') {
            if ($("#ddlBCGStaff").val() == "" || $("#hdfEnrollmentId").val() == "0" || $("#hdfEnrollmentId").val() == "") {
                swal("", "Please select BCG Staff...", "warning");
                return;
            }
        } else {
            if ($("#txtEnrollment").val() == "") { swal("", "Please enter Enrollment No...", "warning"); return; }
            if ($("#hdfEnrollmentId").val() == "0" || $("#hdfEnrollmentId").val() == "") {
                swal("", "Invalid Enrollment No. Please verify.", "warning");
                return;
            }
        }

        if ($("#txtContactNo").val() == "") { swal("", "Please enter Contact Number...", "warning"); return; }

        var data = {
            Id: VDCMemberId,
            EnrollmentId: $("#hdfEnrollmentId").val(),
            MemberType: mType,
            EmailAddress: $("#txtEmailAddress").val(),
            Password: "",
            Name: $("#txtName").val(),
            ContactNo: $("#txtContactNo").val(),
            BarAssociation: $("#txtBarAssociation").val() || (mType === 'S' ? 'BCG Staff' : '')
        };

        $.when(DCMemberDataSubmitRecord(data)).then(function (r) { console.log(r); }).fail(function (e) { console.log(e); });
    });

    $("#txtEnrollment").on("blur", function () {
        var enroNumber = $(this).val();
        if (enroNumber != "") {
            $.ajax({
                type: 'POST',
                url: "/DCMember/GetEnrollmentDetails",
                data: { enroNumber: enroNumber },
                success: function (result) {
                    if (result != null && result.data != null) {
                        var details = result.data;
                        $("#hdfEnrollmentId").val(details.EnrollmentId);
                        $("#txtName").val(details.FullName);
                        $("#txtContactNo").val(details.ContactNumber);
                        $("#txtEmailAddress").val(details.EmailAddress);
                        $("#txtBarAssociation").val(details.BarAssociation);
                    } else {
                        $("#hdfEnrollmentId").val('0');
                        $("#txtName").val('');
                        $("#txtContactNo").val('');
                        $("#txtEmailAddress").val('');
                        $("#txtBarAssociation").val('');
                    }
                },
                error: function () {
                    console.log("Error fetching enrollment details");
                }
            });
        }
    });

    function DCMemberDataSubmitRecord(data) {
        return $.ajax({
            type: 'POST',
            url: "/DCMember/DCMembersInsert",
            data: data,
            success: function (result) {
                if (result != null) {
                    var VRecordStatus = result.data;
                    $('#loader_bcg').css('display', 'none');
                    if (VRecordStatus == "UD" || VRecordStatus == "IN") {
                        swal({ title: "Good Job!", text: "Record updated successfully..", icon: "success", showCancelButton: false, confirmButtonColor: '#DD6B55', confirmButtonText: 'Ok' })
                        .then(function () { location.href = '/DCMember/Index'; });
                    } else if (VRecordStatus == "EX") { swal("", "Record Exist..", "warning"); }
                    else { swal("", "Opps! Something Went Wrong.", "warning"); }
                } else { swal("", "Opps! Something Went Wrong.", "warning"); }
            },
            error: function () { swal("", "Opps! Something Went Wrong.", "warning"); }
        });
    }
</script>
