    /* Pagination */
    function RenderPagination(totalRecords) {
        if (!totalRecords || totalRecords <= 0) {
            $("#paginationDiv").hide();
            $("#entriesInfo").empty();
            $("#paginationList").empty();
            return;
        }
        $("#paginationDiv").css("display", "flex");
        var totalPages = Math.ceil(totalRecords / baseFilter.pageSize);
        var paginationHtml = '';
        $("#paginationList").empty();

        var startEntry = totalRecords > 0 ? ((baseFilter.pageNo - 1) * baseFilter.pageSize + 1) : 0;
        var endEntry = Math.min(baseFilter.pageNo * baseFilter.pageSize, totalRecords);
        $("#entriesInfo").html('Showing <strong class="text-dark">' + startEntry + '</strong> to <strong class="text-dark">' + endEntry + '</strong> of <strong class="text-dark">' + totalRecords + '</strong> complaints');

        if (totalPages > 1) {
            var isFirst = baseFilter.pageNo <= 1;
            var prevDisabled = isFirst ? 'disabled' : '';
            var firstClick = isFirst ? '' : 'onclick="ChangePage(1)"';
            var prevClick = isFirst ? '' : 'onclick="ChangePage(' + (baseFilter.pageNo - 1) + ')"';

            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" ' + firstClick + ' title="First Page" aria-label="First"><i class="fa-solid fa-angles-left"></i></a></li>';
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" ' + prevClick + ' title="Previous Page" aria-label="Previous"><i class="fa-solid fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, baseFilter.pageNo - 2);
            var endPage = Math.min(totalPages, baseFilter.pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === baseFilter.pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + i + ')">' + i + '</a></li>';
            }

            var isLast = baseFilter.pageNo >= totalPages;
            var nextDisabled = isLast ? 'disabled' : '';
            var nextClick = isLast ? '' : 'onclick="ChangePage(' + (baseFilter.pageNo + 1) + ')"';
            var lastClick = isLast ? '' : 'onclick="ChangePage(' + totalPages + ')"';

            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" ' + nextClick + ' title="Next Page" aria-label="Next"><i class="fa-solid fa-chevron-right"></i></a></li>';
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" ' + lastClick + ' title="Last Page" aria-label="Last"><i class="fa-solid fa-angles-right"></i></a></li>';
        }

        $("#paginationList").html(paginationHtml);
    }

    function ChangePage(page) {
        baseFilter.pageNo = page;
        GetComplaintList();
        $('html, body').animate({ scrollTop: $(".complaint-hero").offset().top }, 200);
    }

    /* Share with DC Committee */
    $(document).on('click', '#lnkShareWithDC', function () {
        var currow = $(this).closest('.main_card_list');
        var complaintId = currow.find('#HdfId').text().trim();
        $('#shareDcCommitteeModal').data('complaintId', complaintId);
        $('#btnShareWithSelectedMembers').hide();

        $.ajax({
            type: 'GET',
            url: "/Complaint/GetComplaintShareMembers",
            contentType: "application/json; charset=utf-8",
            data: { ComplaintId: complaintId },
            dataType: "json",
            success: function (response) {
                $('#tblShareDcMembers').empty();
                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    $('#btnShareWithSelectedMembers').show();
                    $.each(response.Data, function (data, value) {
                        var isCheckedStr = (value.Flag === 'A' || value.Flag === null) ? 'checked=""' : '';
                        var memberInitials = getInitials(value.FullName);

                        var memberCard = ''
                            + '<div class="dc-member-item">'
                                + '<div class="dc-member-info">'
                                    + '<div class="dc-member-avatar">' + memberInitials + '</div>'
                                    + '<div>'
                                        + '<div class="fw-bold text-dark">' + (value.FullName || 'Member') + '</div>'
                                        + '<div class="text-muted small">'
                                            + '<i class="fa-solid fa-id-card text-primary me-1"></i> ' + (value.EnroNumber || 'N/A')
                                            + (value.ContactNumber ? ' &bull; <i class="fa-solid fa-phone text-primary me-1 ms-1"></i> ' + value.ContactNumber : '')
                                        + '</div>'
                                    + '</div>'
                                + '</div>'
                                + '<div>'
                                    + '<input type="checkbox" class="form-check-custom" name="shareDcCheck" value="' + value.MemberId + '" ' + isCheckedStr + '>'
                                + '</div>'
                            + '</div>';
                        $('#tblShareDcMembers').append(memberCard);
                    });
                } else {
                    $('#btnShareWithSelectedMembers').hide();
                    var emptyShare = '<div class="empty-state-box py-4 my-2">'
                                   + '<div class="empty-state-icon empty-state-icon-sm">'
                                       + '<i class="fa-solid fa-users-slash text-muted"></i>'
                                   + '</div>'
                                   + '<h6 class="empty-state-heading fs-6">No Committee Members Found</h6>'
                                   + '<p class="empty-state-desc mb-0 small text-muted">There are no active D.C. committee members configured.</p>'
                               + '</div>';
                    $('#tblShareDcMembers').append(emptyShare);
                }
                $('#shareDcCommitteeModal').modal('show');
            },
            error: function () {
                $('#btnShareWithSelectedMembers').hide();
                swal('Something went wrong!', 'Failed to fetch committee members.', 'error');
            }
        });
    });

    $(document).on('click', '#btnShareWithSelectedMembers', function () {
        var complaintId = $('#shareDcCommitteeModal').data('complaintId');
        var membersData = [];

        $("input[name='shareDcCheck']").each(function () {
            var flag = $(this).is(':checked') ? 'A' : 'D';
            membersData.push($(this).val() + '_' + flag);
        });

        if (membersData.length === 0) {
            swal("Warning", "No members selected.", "warning");
            return;
        }

        var Data = JSON.stringify({
            ComplaintId: complaintId,
            MemberIds: membersData
        });

        $.ajax({
            type: 'POST',
            url: "/Complaint/ShareComplaintWithMembers",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    swal("Success!", "Complaint shared successfully with selected members.", "success");
                    $('#shareDcCommitteeModal').modal('hide');
                } else {
                    swal("Failed", "Could not share complaint.", "error");
                }
            },
            error: function () {
                swal('Something went wrong!', 'Server error while sharing with committee.', 'error');
            }
        });
    });
</script>
