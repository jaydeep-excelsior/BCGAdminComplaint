@{
    ViewBag.Title = "Complaint Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="complaint-container">
    <!-- Hero Header Banner -->
    <div class="complaint-hero">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="complaint-hero-title">
                    <i class="fa-solid fa-scale-balanced"></i>
                    Complaint Management
                    <span class="complaint-hero-badge">Bar Council of Gujarat</span>
                </h2>
                <p class="complaint-hero-subtitle">
                    <i class="fa-solid fa-shield-halved"></i>
                    Advocate disciplinary proceedings, public grievances & case record tracking
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-light fw-semibold px-3 shadow-sm btn-hero-summary" id="btnOpenSummaryModal" onclick="openSummaryModal()">
                    <i class="fa-solid fa-chart-pie me-1"></i> Summary
                </button>
                <a href="/Complaint/AddComplaint" class="btn btn-light fw-bold px-3 shadow-sm btn-hero-add">
                    <i class="fa-solid fa-plus me-1 text-primary"></i> Add Complaint
                </a>
                <button type="button" class="btn btn-outline-light fw-semibold px-3 btn-hero-action" id="addfilter">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
            </div>
        </div>
    </div>


    <!-- Quick Status Filter Chips -->
    <div class="quick-chips-wrapper">
        <div class="quick-chip active-chip" data-status-filter="" onclick="applyQuickStatusChip(this, '')">
            <i class="fa-solid fa-list-check"></i> All Complaints
        </div>
        <div class="quick-chip" data-status-filter="Old" onclick="applyQuickStatusChip(this, 'Old')">
            <i class="fa-solid fa-clock-rotate-left text-warning"></i> Old
        </div>
        <div class="quick-chip" data-status-filter="New" onclick="applyQuickStatusChip(this, 'New')">
            <i class="fa-solid fa-wand-magic-sparkles text-info"></i> New
        </div>
        <div class="quick-chip" data-status-filter="Accepted" onclick="applyQuickStatusChip(this, 'Accepted')">
            <i class="fa-solid fa-circle-check text-success"></i> Accepted
        </div>
        <div class="quick-chip" data-status-filter="More Detail" onclick="applyQuickStatusChip(this, 'More Detail')">
            <i class="fa-solid fa-circle-info text-warning"></i> More Detail
        </div>
        <div class="quick-chip" data-status-filter="Rejected" onclick="applyQuickStatusChip(this, 'Rejected')">
            <i class="fa-solid fa-ban text-danger"></i> Rejected
        </div>
        <div class="quick-chip" data-status-filter="Refer to Board" onclick="applyQuickStatusChip(this, 'Refer to Board')">
            <i class="fa-solid fa-gavel text-primary"></i> Refer to Board
        </div>
        <div class="quick-chip" data-status-filter="Board Accept" onclick="applyQuickStatusChip(this, 'Board Accept')">
            <i class="fa-solid fa-clipboard-check text-info"></i> Board Accept
        </div>
        <div class="quick-chip" data-status-filter="Board Reject" onclick="applyQuickStatusChip(this, 'Board Reject')">
            <i class="fa-solid fa-file-circle-xmark text-danger"></i> Board Reject
        </div>
        <div class="quick-chip" data-status-filter="Board Has Approved" onclick="applyQuickStatusChip(this, 'Board Has Approved')">
            <i class="fa-solid fa-shield-halved text-success"></i> Board Has Approved
        </div>
        <div class="quick-chip" data-status-filter="Board Has Rejected" onclick="applyQuickStatusChip(this, 'Board Has Rejected')">
            <i class="fa-solid fa-triangle-exclamation text-danger"></i> Board Has Rejected
        </div>
    </div>

    <!-- Collapsible Advanced Filter Drawer -->
    <div class="card main_filter_div shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <div class="filter-section-title mb-0">
                    <i class="fa-solid fa-sliders text-primary"></i> Advanced Search & Filters
                </div>
                <button type="button" class="btn btn-sm btn-link text-muted p-0 close_filterdiv">
                    <i class="fa-solid fa-xmark fs-6"></i>
                </button>
            </div>
            <form action="#" onsubmit="event.preventDefault();">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">Complaint Status</label>
                        <select id="drpStatus" class="form-control select2">
                            <option value="">All Statuses</option>
                            <option value="New">New</option>
                            <option value="Old">Old</option>
                            <option value="Accepted">Accepted</option>
                            <option value="More Detail">More Detail</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Refer to Board">Refer to Board</option>
                            <option value="Board Accept">Board Accept</option>
                            <option value="Board Reject">Board Reject</option>
                            <option value="Board Has Approved">Board Has Approved</option>
                            <option value="Board Has Rejected">Board Has Rejected</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">Payment Status</label>
                        <select id="drpPaymentStatus" class="form-control select2">
                            <option value="">All Payment Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Parcel Due">Parcel Due</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">From Date</label>
                        <input name="txtFromDate" id="txtFromDate" type="date" class="form-control filter-input" max="2999-12-31">
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">To Date</label>
                        <input name="txtToDate" id="txtToDate" type="date" class="form-control filter-input" max="2999-12-31">
                    </div>

                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">Year</label>
                        <input name="txtYear" id="txtYear" type="number" placeholder="e.g. 2026" class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">From Number</label>
                        <input name="txtFromNo" id="txtFromNo" type="number" placeholder="From No." class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">To Number</label>
                        <input name="txtToNo" id="txtToNo" type="number" placeholder="To No." class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-12 col-12 d-flex align-items-end">
                        <div class="w-100 d-flex gap-2">
                            <button type="button" id="lnkFilter" class="btn btn-primary btn-sm flex-fill fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                            </button>
                            <button type="button" id="btnCancel" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold">
                                <i class="fa-solid fa-rotate-left me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Search & Actions Toolbar -->
    <div class="action-bar-card d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="quick-search-wrap">
            <i class="fa-solid fa-magnifying-glass quick-search-icon"></i>
            <input id="txtQuickSearch" class="quick-search-input quicksearchcomplaintmanagement" placeholder="Quick Search by Name, Contact, Email or Complaint No...">
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small" id="liveResultsBadge"></span>
        </div>
    </div>

    <!-- Complaint Cards List Container -->
    <div id="tblComplaintList">
        <!-- Rendered via AJAX -->
    </div>

    <!-- Pagination & Entries Info -->
    <div id="paginationDiv" class="pagination-wrapper initially-hidden">
        <div id="entriesInfo" class="entries-text"></div>
        <ul class="pagination pagination-rounded mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- ==========================================================================
     MODALS
     ========================================================================== -->

<!-- Complaint Status Summary Modal -->
<div class="modal fade" id="complaintSummaryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="summary-modal-icon-badge">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0 font-size-17">Complaints Status Summary</h5>
                        <p class="summary-modal-subtitle text-muted mb-0">Click any card to filter complaints list by that status</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnRefreshSummary" onclick="loadComplaintSummary()">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh
                    </button>
                    <button type="button" class="btn-close btn-sm" onclick="closeSummaryModal()" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-4">
                <!-- Row 1: Key Overview (Total, Old, New) -->
                <div class="row g-3 mb-3">
                    <div class="col-lg-4 col-md-4 col-12">
                        <div class="summary-metric-card card-blue" onclick="filterBySummaryStatus('')">
                            <div>
                                <div class="summary-lbl">Total Complaint</div>
                                <div class="summary-val text-primary" id="summaryTotal">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Show all complaints</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-folder-open"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="summary-metric-card card-amber" onclick="filterBySummaryStatus('Old')">
                            <div>
                                <div class="summary-lbl">Old</div>
                                <div class="summary-val text-warning" id="summaryOld">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Old complaints</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="summary-metric-card card-cyan" onclick="filterBySummaryStatus('New')">
                            <div>
                                <div class="summary-lbl">New</div>
                                <div class="summary-val text-info" id="summaryNew">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter New complaints</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Standard Statuses (Accepted, More Detail, Rejected, Refer to Board) -->
                <div class="row g-3 mb-3">
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-emerald" onclick="filterBySummaryStatus('Accepted')">
                            <div>
                                <div class="summary-lbl">Accepted</div>
                                <div class="summary-val text-success" id="summaryAccepted">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Accepted</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-orange" onclick="filterBySummaryStatus('More Detail')">
                            <div>
                                <div class="summary-lbl">More Detail</div>
                                <div class="summary-val val-orange" id="summaryMoreDetail">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter More Detail</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-circle-info"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-red" onclick="filterBySummaryStatus('Rejected')">
                            <div>
                                <div class="summary-lbl">Rejected</div>
                                <div class="summary-val text-danger" id="summaryRejected">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Rejected</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-circle-xmark"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-indigo" onclick="filterBySummaryStatus('Refer to Board')">
                            <div>
                                <div class="summary-lbl">Refer to Board</div>
                                <div class="summary-val val-indigo" id="summaryReferToBoard">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Refer to Board</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-gavel"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 3: Board Proceedings & Outcomes (Board Accept, Board Reject, Board Has Approved, Board Has Rejected) -->
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-teal" onclick="filterBySummaryStatus('Board Accept')">
                            <div>
                                <div class="summary-lbl">Board Accept</div>
                                <div class="summary-val val-teal" id="summaryBoardAccept">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Board Accept</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-rose" onclick="filterBySummaryStatus('Board Reject')">
                            <div>
                                <div class="summary-lbl">Board Reject</div>
                                <div class="summary-val val-rose" id="summaryBoardReject">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Board Reject</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-file-circle-xmark"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-green" onclick="filterBySummaryStatus('Board Has Approved')">
                            <div>
                                <div class="summary-lbl">Board Has Approved</div>
                                <div class="summary-val val-green" id="summaryBoardHasApproved">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Approved</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="summary-metric-card card-crimson" onclick="filterBySummaryStatus('Board Has Rejected')">
                            <div>
                                <div class="summary-lbl">Board Has Rejected</div>
                                <div class="summary-val val-crimson" id="summaryBoardHasRejected">0</div>
                                <div class="summary-hint"><i class="fa-solid fa-arrow-right font-size-10"></i> Filter Rejected</div>
                            </div>
                            <div class="summary-icon-box">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 px-4 d-flex justify-content-between align-items-center">
                <span class="text-muted small"><i class="fa-solid fa-arrow-pointer me-1 text-primary"></i> Click any card above to close and filter list</span>
                <button type="button" class="btn btn-secondary btn-sm px-3" onclick="closeSummaryModal()">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- PDF Full-Screen / Large Preview Modal -->
<div class="modal fade" id="pdfModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl pdf-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-pdf text-danger"></i> Document Preview
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="" id="displayPdf" class="pdf-preview-iframe"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Document List Modal -->
<div class="modal fade" id="document" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-folder-open text-primary"></i> Uploaded Complaint Documents
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tblComplaintDoc" class="initially-hidden"></div>
                <div id="tblComplaintDocEmpty" class="initially-hidden">
                    <div class="empty-state-box py-4">
                        <div class="empty-state-icon empty-state-icon-sm">
                            <i class="fa-solid fa-file-circle-xmark text-muted"></i>
                        </div>
                        <h6 class="empty-state-heading fs-6">No Documents Uploaded</h6>
                        <p class="empty-state-desc mb-0 small text-muted">
                            No affidavit copy or additional attachment has been uploaded for this complaint.<br/>
                            (કોઈ ફરિયાદ સોગંદનામાની નકલ અપલોડ કરેલ નથી)
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Adjunt / Advocate Details Modal -->
<div class="modal fade" id="Adjunt" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gavel text-primary"></i> Advocate Details (Complained Against)
                    </h5>
                    <div class="small text-muted">(જે વકીલ વિરુદ્ધ ફરિયાદ કરવામાં આવી છે તેની વિગતો)</div>
                </div>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tblComplaintAgaints"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Complaint Number Modal -->
<div class="modal fade" id="UpdateComplaintNumberModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-primary"></i> Update Complaint Number
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdfUpdateComplaintId" />
                <div class="form-group mb-3">
                    <label class="filter-input-label">Current Complaint Number</label>
                    <input type="text" id="lblCurrentComplaintNumber" class="form-control fw-bold bg-light" readonly disabled />
                </div>
                <div class="form-group mb-3">
                    <label class="filter-input-label">New Complaint Number</label>
                    <div class="input-group">
                        <span class="input-group-text fw-bold text-muted bg-light">BCG/CMP/</span>
                        <input type="number" id="txtNewComplaintNumberPart1" class="form-control" placeholder="Number (e.g. 118)" />
                        <span class="input-group-text fw-bold text-muted bg-light">/</span>
                        <select id="txtNewComplaintNumberPart2" class="form-select"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-3 fw-semibold" id="btnUpdateComplaintNumber">
                    <i class="fa-solid fa-check me-1"></i> Update Number
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Share with DC Committee Modal -->
<div class="modal fade" id="shareDcCommitteeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-users text-primary"></i> Share with D.C. Committee Members
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-scrollable-420">
                <div id="tblShareDcMembers"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-sm px-3 fw-semibold initially-hidden" id="btnShareWithSelectedMembers">
                    <i class="fa-solid fa-share-nodes me-1"></i> Share with Selected Members
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var baseFilter = {
        pageNo: 1,
        pageSize: 10,
        sortColumn: 1,
        sortOrder: 'desc',
        searchValue: ''
    };

    function initSelect2() {
        if ($.fn.select2) {
            $('#drpStatus, #drpPaymentStatus, select.select2').select2({
                allowClear: true,
                width: '100%'
            });
        }
    }

    $(document).ready(function () {
        initSelect2();
        GetComplaintList();

        $('#complaintSummaryModal').on('show.bs.modal', function () {
            loadComplaintSummary();
        });

        // Purge any gray backdrop overlay on modal close
        $('#complaintSummaryModal').on('hidden.bs.modal hide.bs.modal', function () {
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({ 'overflow': '', 'padding-right': '' });
            setTimeout(function () {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css({ 'overflow': '', 'padding-right': '' });
            }, 100);
        });

        $(document).on('hidden.bs.modal', '.modal', function () {
            if ($('.modal.show, .modal.in').length === 0) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css({ 'overflow': '', 'padding-right': '' });
            }
        });

        loadComplaintSummary();
    });

    // Helper: Compute status styling attributes
    function getStatusMeta(status) {
        var s = (status || "").toLowerCase().trim();
        if (s.indexOf("board has approved") >= 0) return { color: "approved", badgeClass: "badge-status-approved", icon: "fa-shield-halved" };
        if (s.indexOf("board has rejected") >= 0) return { color: "board-rejected", badgeClass: "badge-status-board-rejected", icon: "fa-triangle-exclamation" };
        if (s.indexOf("board accept") >= 0) return { color: "board-accept", badgeClass: "badge-status-board-accept", icon: "fa-clipboard-check" };
        if (s.indexOf("board reject") >= 0) return { color: "board-reject", badgeClass: "badge-status-board-reject", icon: "fa-file-circle-xmark" };
        if (s.indexOf("refer to board") >= 0 || s.indexOf("general board") >= 0) return { color: "board", badgeClass: "badge-status-board", icon: "fa-gavel" };
        if (s.indexOf("accepted") >= 0 || s === "accept") return { color: "accepted", badgeClass: "badge-status-accepted", icon: "fa-circle-check" };
        if (s.indexOf("rejected") >= 0 || s === "reject") return { color: "rejected", badgeClass: "badge-status-rejected", icon: "fa-ban" };
        if (s.indexOf("detail") >= 0) return { color: "detail", badgeClass: "badge-status-detail", icon: "fa-circle-info" };
        if (s.indexOf("old") >= 0) return { color: "old", badgeClass: "badge-status-old", icon: "fa-clock-rotate-left" };
        if (s.indexOf("new") >= 0) return { color: "new", badgeClass: "badge-status-new", icon: "fa-wand-magic-sparkles" };
        if (s.indexOf("payment") >= 0) return { color: "payment", badgeClass: "badge-status-payment", icon: "fa-circle-check" };
        if (s.indexOf("withdrawal") >= 0) return { color: "withdrawal", badgeClass: "badge-status-withdrawal", icon: "fa-arrow-right-from-bracket" };
        if (s.indexOf("hearing") >= 0) return { color: "hearing", badgeClass: "badge-status-hearing", icon: "fa-scale-balanced" };
        if (s.indexOf("adjunt") >= 0) return { color: "adjunt", badgeClass: "badge-status-adjunt", icon: "fa-user-shield" };
        if (s.indexOf("order") >= 0) return { color: "order", badgeClass: "badge-status-order", icon: "fa-stamp" };
        return { color: "default", badgeClass: "badge-status-default", icon: "fa-tag" };
    }

    // Helper: Get initials for avatar
    function getInitials(name) {
        if (!name) return "CP";
        var parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function GetComplaintList() {
        var Data = JSON.stringify({
            baseFilter: baseFilter,
            Status: $("#drpStatus option:selected").text() === 'All Statuses' || $("#drpStatus option:selected").text() === 'Select Status' ? "" : $("#drpStatus option:selected").text().trim(),
            PaymentStatus: $("#drpPaymentStatus option:selected").text() === 'All Payment Statuses' || $("#drpPaymentStatus option:selected").text() === 'Select Payment Status' ? "" : $("#drpPaymentStatus option:selected").text().trim(),
            FromDate: $("#txtFromDate").val(),
            ToDate: $("#txtToDate").val(),
            Year: $("#txtYear").val(),
            FromNo: $("#txtFromNo").val(),
            ToNo: $("#txtToNo").val()
        });

        // Skeleton loading state
        $("#tblComplaintList").html(
            '<div class="text-center py-5">'
            + '<div class="spinner-border text-primary mb-3 spinner-lg" role="status"></div>'
            + '<div class="text-muted fw-semibold">Loading complaint records...</div>'
            + '</div>'
        );

        $.ajax({
            type: 'POST',
            url: "/Complaint/GetComplaintList",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#tblComplaintList").empty();
                var complaintList = $("#tblComplaintList");

                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    var totalRecords = response.Data[0].TotalRecord || response.Data.length;

                    // Update Top Metric Cards
                    $("#metricTotal").text(totalRecords);
                    var newCount = 0;
                    var boardCount = 0;
                    var paidCount = 0;

                    $.each(response.Data, function (i, val) {
                        if (val.Status === 'New' || val.NewStatusCount > 0) newCount++;
                        if (val.Status === 'Refer to Board') boardCount++;
                        if (val.PaymentStatus === 'Completed' || val.PaymentStatus === 'Paid') paidCount++;
                    });

                    $("#metricNew").text(newCount > 0 ? newCount : (response.Data[0].NewStatusCount || 0));
                    $("#metricBoard").text(boardCount);
                    $("#metricPaid").text(paidCount);

                    $("#liveResultsBadge").html('<strong>' + totalRecords + '</strong> total records');

                    $.each(response.Data, function (i, value) {
                        var statusMeta = getStatusMeta(value.Status);
                        var initials = getInitials(value.FullName);

                        // Payment Status Pill
                        var paymentBadgeHtml = "";
                        var pStatus = (value.PaymentStatus || "").trim().toLowerCase();
                        if (pStatus === "completed" || pStatus === "paid") {
                            paymentBadgeHtml = '<span class="badge-payment-paid"><i class="fa-solid fa-circle-check"></i> Paid</span>';
                        } else if (pStatus === "parcel due" || pStatus === "due") {
                            paymentBadgeHtml = '<span class="badge-payment-due"><i class="fa-solid fa-triangle-exclamation"></i> Due</span>';
                        } else {
                            paymentBadgeHtml = '<span class="badge-payment-pending"><i class="fa-solid fa-clock"></i> ' + (value.PaymentStatus || "Pending") + '</span>';
                        }

                        // Complaint Status Pill
                        var statusBadgeHtml = "";
                        var rawStatus = (value.Status || "").trim();
                        if (rawStatus !== "") {
                            statusBadgeHtml = '<span class="badge-soft ' + statusMeta.badgeClass + '"><i class="fa-solid ' + statusMeta.icon + '"></i> ' + rawStatus + '</span>';
                        }

                        // Advocate strip
                        var advocateHtml = "";
                        if (value.ComplainedAgainst && value.ComplainedAgainst.trim() !== "") {
                            advocateHtml = '<div class="advocate-strip">'
                                         + '<span class="advocate-strip-label"><i class="fa-solid fa-gavel text-primary me-1"></i> Complained Against:</span>'
                                         + '<span class="advocate-strip-name">' + value.ComplainedAgainst + '</span>'
                                         + '</div>';
                        }

                        // Attachment quick chip if available
                        var attachmentChipHtml = "";
                        if (value.AffidavitFilesText || value.AdditionalFilesText) {
                            var fileName = value.AffidavitFilesText || value.AdditionalFilesText;
                            attachmentChipHtml = '<div class="attachment-chip"><i class="fa-solid fa-paperclip"></i> ' + fileName + '</div>';
                        }

                        // Card Action Buttons
                        var actionsHtml = '<div class="actions-group">';

                        if (value.NewStatusCount > 0) {
                            actionsHtml += '<button type="button" class="btn-action btn-action-warning" id="lnkOldComplaint"><i class="fa-solid fa-clock-rotate-left"></i> Mark Old</button>';
                        }
                        if (value.OldStatusCount > 0) {
                            actionsHtml += '<button type="button" class="btn-action btn-action-info" id="lnkNewComplaint"><i class="fa-solid fa-wand-magic-sparkles"></i> Mark New</button>';
                        }

                        actionsHtml += '<a class="btn-action btn-action-primary" href="/Complaint/Detail/' + value.Id + '" onclick="document.cookie=\'ComplaintId=' + value.Id + '; path=/\';"><i class="fa-solid fa-eye text-white"></i> Detail</a>';

                        actionsHtml += '<button type="button" class="btn-action" id="lnkUpdateComplaintNumber"><i class="fa-solid fa-pen-to-square text-primary"></i> Edit Number</button>';

                        if (value.Status === 'Refer to Board') {
                            actionsHtml += '<button type="button" class="btn-action btn-action-dc" id="lnkShareWithDC"><i class="fa-solid fa-share-nodes"></i> Share with D.C.</button>';
                        }

                        actionsHtml += '<button type="button" class="btn-action" id="lnkViewDocument" data-bs-toggle="modal" data-bs-target="#document" data-toggle="modal" data-target="#document"><i class="fa-solid fa-file-lines text-primary"></i> Documents</button>';
                        actionsHtml += '<button type="button" class="btn-action" id="lnkViewAdjunt" data-bs-toggle="modal" data-bs-target="#Adjunt" data-toggle="modal" data-target="#Adjunt"><i class="fa-solid fa-user-shield text-primary"></i> Adjunt Details</button>';
                        actionsHtml += '<button type="button" class="btn-action btn-action-danger ms-auto" id="lnkDeleteComplaint"><i class="fa-solid fa-trash-can"></i> Delete</button>';
                        actionsHtml += '</div>';

                        var dueDisplay = value.DueAmount != null && value.DueAmount > 0 
                                       ? '<span class="text-danger fw-bold">₹' + value.DueAmount + '</span>' 
                                       : '<span class="text-success fw-semibold">₹0</span>';

                        // Status Ribbon (New / Old status indicator)
                        var ribbonHtml = "";
                        var hasRibbonClass = "";
                        if (value.NewStatusCount > 0) {
                            ribbonHtml = '<div class="corner-ribbon ribbon-new bg-info text-white">New</div>';
                            hasRibbonClass = " has-ribbon";
                        } else if (value.OldStatusCount > 0) {
                            ribbonHtml = '<div class="corner-ribbon ribbon-old bg-warning text-dark">Old</div>';
                            hasRibbonClass = " has-ribbon";
                        }

                        var cardStatusColor = statusMeta.color;

                        var finalCard = ''
                            + '<div class="complaint-card main_card_list ribbon-wrapper' + hasRibbonClass + '" data-status-color="' + cardStatusColor + '" data-complaint-no="' + (value.ComplaintNumber || '') + '">'
                                + ribbonHtml
                                + '<div id="HdfId" class="hidden-field">' + value.Id + '</div>'
                                + '<div class="complaint-card-header">'
                                    + '<div class="d-flex align-items-center gap-3">'
                                        + '<div class="complaint-index-badge">' + (value.SrNo || (i + 1)) + '</div>'
                                        + '<div class="complaint-number-box complaint_number">'
                                            + '<a class="complaint-number-link description" href="/Complaint/Detail/' + value.Id + '" onclick="document.cookie=\'ComplaintId=' + value.Id + '; path=/\';">'
                                                + '<i class="fa-solid fa-folder-closed text-primary complaint-folder-icon"></i>'
                                                + '<span class="complaint-number-text">' + value.ComplaintNumber + '</span>'
                                                + '<i class="fa-solid fa-arrow-up-right-from-square text-muted ms-1 complaint-link-icon"></i>'
                                            + '</a>'
                                        + '</div>'
                                    + '</div>'
                                    + '<div class="complaint-card-meta">'
                                        + statusBadgeHtml
                                        + '<span class="complaint-date-text"><i class="fa-regular fa-calendar-days"></i> ' + (value.ComplaintsCreateDate || '') + '</span>'
                                    + '</div>'
                                + '</div>'
                                + '<div class="complaint-card-body">'
                                    + '<div class="row align-items-center g-3">'
                                        + '<div class="col-lg-7 col-md-12">'
                                            + '<div class="d-flex align-items-start gap-3">'
                                                + '<div class="complainant-avatar">' + initials + '</div>'
                                                + '<div class="flex-grow-1">'
                                                    + '<div class="complainant-name">' + (value.FullName || 'Unnamed Complainant') + '</div>'
                                                    + '<div class="contact-pill-wrap">'
                                                        + (value.ContactNumber ? '<a href="tel:' + value.ContactNumber + '" class="contact-pill"><i class="fa-solid fa-phone"></i> ' + value.ContactNumber + '</a>' : '')
                                                        + (value.EmailAddress ? '<a href="mailto:' + value.EmailAddress + '" class="contact-pill"><i class="fa-solid fa-envelope"></i> ' + value.EmailAddress + '</a>' : '')
                                                    + '</div>'
                                                + '</div>'
                                            + '</div>'
                                            + advocateHtml
                                            + attachmentChipHtml
                                        + '</div>'
                                        + '<div class="col-lg-5 col-md-12">'
                                            + '<div class="financial-box">'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Total Fee</div>'
                                                    + '<div class="financial-value">₹' + (value.TotalAmount != null ? value.TotalAmount : 0) + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Paid</div>'
                                                    + '<div class="financial-value text-success">₹' + (value.PaidAmount != null ? value.PaidAmount : 0) + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Due</div>'
                                                    + '<div class="financial-value">' + dueDisplay + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col financial-col-last">'
                                                    + '<div class="financial-title">Status</div>'
                                                    + '<div class="mt-1">' + paymentBadgeHtml + '</div>'
                                                + '</div>'
                                            + '</div>'
                                        + '</div>'
                                    + '</div>'
                                + '</div>'
                                + '<div class="complaint-card-footer">'
                                    + actionsHtml
                                + '</div>'
                            + '</div>';

                        complaintList.append(finalCard);
                    });

                    $("#paginationDiv").css("display", "flex");
                    RenderPagination(totalRecords);
                } else {
                    $("#metricTotal").text("0");
                    $("#metricNew").text("0");
                    $("#metricBoard").text("0");
                    $("#metricPaid").text("0");
                    $("#liveResultsBadge").html('0 records');

                    var emptyHtml = '<div class="empty-state-box">'
                                  + '<div class="empty-state-icon">'
                                      + '<i class="fa-solid fa-clipboard-question"></i>'
                                  + '</div>'
                                  + '<h4 class="empty-state-heading">No Complaints Found</h4>'
                                  + '<p class="empty-state-desc">We couldn\'t find any complaints matching your active filter criteria. Try clearing search terms or selecting "All Complaints".</p>'
                                  + '<button type="button" class="btn btn-outline-primary btn-sm fw-semibold px-3" onclick="resetAllFilters()">'
                                      + '<i class="fa-solid fa-rotate-left me-1"></i> Clear All Filters'
                                  + '</button>'
                              + '</div>';
                    complaintList.append(emptyHtml);
                    $("#paginationDiv").hide();
                    $("#paginationList").empty();
                    $("#entriesInfo").empty();
                }
            },
            error: function () {
                swal('Something went wrong!', 'Unable to fetch complaint list. Please try again.', 'error');
            }
        });
    }

