    /* Update Complaint Number */
    $('body').on('click', '#lnkUpdateComplaintNumber', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();
        var oldComplaintNumber = currow.attr('data-complaint-no') || currow.find('.complaint_number .description').first().text().trim();

        $('#hdfUpdateComplaintId').val(CId);
        $('#lblCurrentComplaintNumber').val(oldComplaintNumber);
        $('#txtNewComplaintNumberPart1').val('');

        if ($('#txtNewComplaintNumberPart2 option').length === 0) {
            var currentYear = new Date().getFullYear();
            for (var i = 0; i <= 10; i++) {
                $('#txtNewComplaintNumberPart2').append('<option value="' + (currentYear - i) + '">' + (currentYear - i) + '</option>');
            }
        }
        $('#txtNewComplaintNumberPart2').val(new Date().getFullYear());

        $('#UpdateComplaintNumberModal').modal('show');
    });

    $('#btnUpdateComplaintNumber').click(function () {
        var complaintId = $('#hdfUpdateComplaintId').val();
        var part1 = $('#txtNewComplaintNumberPart1').val().trim();
        var part2 = $('#txtNewComplaintNumberPart2').val().trim();

        if (part1 === "" || part2 === "") {
            swal("Validation Error", "Please enter the number and select a year.", "warning");
            return;
        }

        var formatRegex1 = /^\d+$/;
        if (!formatRegex1.test(part1)) {
            swal("Invalid Format", "Please enter a valid numeric value for the number part.", "error");
            return;
        }

        var fullComplaintNumber = "BCG/CMP/" + part1 + "/" + part2;

        $.ajax({
            type: 'POST',
            url: "/Complaint/ComplaintNumberUpdate",
            data: { ComplaintId: complaintId, ComplaintNumberCode: part1, ComplaintNumber: fullComplaintNumber },
            success: function (response) {
