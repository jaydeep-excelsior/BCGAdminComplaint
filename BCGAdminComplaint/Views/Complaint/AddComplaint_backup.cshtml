    $('#lnkSubmit').on('click', function () {

        if ($('#txtFullName').val() == "" || $('#txtFullName').val() == null) {
            swal("Please Enter Name", "", "error");
            return;
        }

        if ($('#txtMobile').val() == "" || $('#txtMobile').val() == null) {
            swal("Please Enter Mobile No", "", "error");
            return;
        }

        var VReceiptNumber = $('#txtReceiptNumber').val() == null ? '' : $.trim($('#txtReceiptNumber').val());
        var VReceiptDate = $('#txtReceiptDate').val() == null ? '' : $.trim($('#txtReceiptDate').val());
        var VPaymentMode = $('#ddlPaymentMode').val() == null ? '' : $('#ddlPaymentMode').val() == 'Select' ? '' : $('#ddlPaymentMode').val() == '0' ? '' : $('#ddlPaymentMode').val();
        var VTransactionNumber = $('#txtTransactionNumber').val() == null ? '' : $.trim($('#txtTransactionNumber').val());
        var VTransactionDate = $('#txtTransactionDate').val() == null ? '' : $.trim($('#txtTransactionDate').val());
        var VBankId = $('#ddlBank').val() == null ? '0' : $('#ddlBank').val() == 'Select' ? '0' : $('#ddlBank').val() == '' ? '0' : $('#ddlBank').val();

        if (VReceiptNumber == '') {
            swal("Please input receipt number.", "", "error");
            IsSave = 0;
            return;
        }

        if (VReceiptDate == '') {
            swal("Please input receipt date.", "", "error");
            IsSave = 0;
            return;
        }

        if (VPaymentMode == '') {
            swal("Please select receipt by.", "", "error");
            IsSave = 0;
            return;
        }

        if (VPaymentMode == 'CASH') {
            if (VTransactionDate == '') {
                swal("Please input transaction date.", "", "error");
                IsSave = 0;
                return;
            }
        } else if (VPaymentMode == 'D.D.' || VPaymentMode == 'OUTSTANDING' || VPaymentMode == 'RTGS' || VPaymentMode == 'JOURNAL') {
            if (VTransactionDate == '') {
                swal("Please input transaction date.", "", "error");
                IsSave = 0;
                return;
            }
            if (VTransactionNumber == '') {
                swal("Please input transaction number.", "", "error");
                IsSave = 0;
                return;
            }
            if (parseInt(VBankId) == 0) {
                swal("Please select bank.", "", "error");
                IsSave = 0;
                return;
            }
        }

        var DefendantListArr = [];
        DefendantListArr.length = 0;

        var VFinalListCount = $('#finalList .FinalList').length;

        for (var i = 0; i < VFinalListCount; i++) {

            var no = i + 1;
            var name = $('#lblName' + no).text();
            var advocate = $('#hdfDetailsAdvocateId' + no).text();
            var EnrollmentNo = $('#hdfEnrollNoFinal' + no).html();
            var ContactNumber = "0";
            var Amount = $('#lblAmount' + no).text().replace("Rs. ", '');
            var IsKnown = $("#rdYes:checked").val();

            DefendantListArr.push({
                Name: name,
                AdvocateId: advocate,
                EnrollmentNo: EnrollmentNo,
                ContactNumber: ContactNumber,
                Amount: Amount,
                IsKnown: IsKnown
            });
        }

        var DefendantManualListArr = [];
        DefendantManualListArr.length = 0;

        for (var i = 0; i < $('#dvDefendantList .DefendantList').length; i++) {
            var id = i + 1;
            var advocatename = $('#advocateName' + id).text();
            var City = $('#city' + id).text();
            var ContactNumber = $('#mobileNo' + id).text();
            var Amount = $('#lblAmount' + id).text().replace('Rs. ', '');
            var IsKnown = $("#rdNo:checked").val();

            DefendantManualListArr.push({
                AdvocateName: advocatename,
                City: City,
                ContactNumber: ContactNumber,
                Amount: Amount,
                IsKnown: IsKnown
            });
        }

        var FileUploadArr = [];
        FileUploadArr.length = 0;

        for (var i = 0; i < $("#dvComplaintFiles .uploadfiledata").length; i++) {

            var num = i + 1;
            var path = $('#FilePath' + num).attr('href');
            var name = $('#lblFileName' + num).text();
            var description = $('#lblDescription' + num).text();
            var FileExtension = name.substr((name.lastIndexOf('.') + 1));

            FileUploadArr.push({
                FileTitle: '',
                FilePath: path,
                FileName: name,
                Description: description,
                FileExtension: FileExtension,
            });
        }

        var ComplaintPaymentArr = [];
        ComplaintPaymentArr.length = 0;

        ComplaintPaymentArr.push({
            PaidAmount: $("#lblGrandTotalAmount").text(),
            ReceiptNumber: VReceiptNumber,
            ReceiptDate: VReceiptDate,
            PaidOn: VReceiptDate,
            PaymentMode: VPaymentMode == 'Select' ? '' : VPaymentMode,
            TransactionNumber: VTransactionNumber,
            TransactionDate: VTransactionDate,
            BankId: VBankId
        });

        var Data = JSON.stringify({
            Name: $('#txtFullName').val(),
            Email: $('#txtEmailAddress').val(),
            MobileNo: $('#txtMobile').val(),
            Address: $('#txtAddress').val(),
            Summary: '',
            DetailComplaint: '',
            TotalAmount: $('#lblGrandTotalAmount').text().trim() == "" ? "" : $('#lblGrandTotalAmount').text().trim() == null ? "" : $('#lblGrandTotalAmount').text().trim(),
            DefendantDetails: DefendantListArr.length == 0 ? DefendantManualListArr : DefendantListArr,
            FileDetails: FileUploadArr,
            AffidavitFileName: $('#hdfaffiFileName').val(),
            AffidavitFilePath: $('#hdfaffiB64ImagePath').val(),
            ComplaintPayment: ComplaintPaymentArr
        });

        console.log(Data);

        $.ajax({
            type: "POST",
            url: "/Complaint/SaveComplaint",
            contentType: "application/json; charset=utf-8",
            data: Data,
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    swal("Your Complaint Send Successfully.", "", "success");
                    clearData();
                    var url = '/Complaint/ComplaintManagement';
                    location.href = url;
                }
                else {
                    swal("Something went wrong!", "", "error");
                }
            },
            failure: function (response) {
                $("#overlay").hide();
                swal(response.d, "", "error");
            },
            error: function (response) {
                $("#overlay").hide();
            }
        });
    });
</script>

