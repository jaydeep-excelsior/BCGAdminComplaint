<script>
    function mobileCheck(evt, element) {
        if (element.value.length != 10) {
            element.value = "";
            swal("Please enter valid mobile numbers.", "", "error");
            element.focus();
            return false;
        }
        return true;
    }

    function isNumberKey(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode >= 48 && charCode <= 57)
            return true;
        else {
            swal("Please enter numbers.", "", "error");
            return false;
        }
    }

    function isEmail(mail) {
        var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        if (mail.value.length == 0)
            return true;
        else {
            var isValid = expr.test(mail.value);
            if (isValid == false) {
                swal('Please Enter Valid Email Address.', "", "error");
                mail.value = "";
                $("#txtEmail").focus();
                return false;
            }
            return true;
        }
    }

    $(document).ready(function () {
        GetComplaintBankList();

        $('#rdYes').on('click', function () {
            $('#rdYes').prop('checked', true);
            $('#rdNo').prop('checked', false);
            $('#selectDetails').removeClass('hide-element');
            $('#addDetails').addClass('hide-element');
            $('#dvDefendantList').addClass('hide-element');
            $('#dynamicDataList').removeClass('hide-element');

            $('#dvDefendantList').empty();
            var sum = 0;
            jQuery('#finalList .text-danger').each(function () {
                var text = $(this).text().replace("Rs. ", '');
                sum += parseFloat(text);
            });
            jQuery("#lblGrandTotalAmount").html(sum.toFixed(2));

            if ($('#finalList .FinalList').length === 0) {
                $('#defendantHeader').addClass('hide-element');
            } else {
                $('#dynamicHeaderRow').html('<div class="col-lg-4 px-2"><p class="mb-0 fw-bold">Advocate Name</p></div><div class="col-lg-3 px-2"><p class="mb-0 fw-bold">Enrollment No</p></div><div class="col-lg-3 px-2"><p class="mb-0 fw-bold">Amount</p></div><div class="col-lg-2 px-2 text-center"><p class="mb-0 fw-bold">Action</p></div>');
                $('#defendantHeader').removeClass('hide-element');
            }
        });

        $('#rdNo').on('click', function () {
            $('#rdYes').prop('checked', false);
            $('#rdNo').prop('checked', true);
            $('#addDetails').css('display', 'block');
            $('#selectDetails').css('display', 'none');
            $('#dvDefendantList').removeClass('hide-element');
            $('#dynamicDataList').addClass('hide-element');
        });

        $('#btnAddDefendant').on('click', function () {
            var advocateName = $('#txtAdvocateName').val();
            var city = $('#txtCity').val();
            var mobileNo = $('#txtMobileNo').val();

            if (!advocateName) { swal("Please Enter Advocate Name", "", "error"); return; }
            if (!city) { swal("Please Enter City", "", "error"); return; }

            var amount = 500;
            if ($('.DefendantList').length == 0) amount = 1000;
            else if ($('.DefendantList').length == 1) amount = 0;

            var srNo = $('.DefendantList').length + 1;

            $('#dvDefendantList').append('<div class="col-12 DefendantList">'
             + '<div class="Details">'
             + '<div class="d-flex align-items-center w-100">'
             + '<span class="btn-span defendantlistsrno" id="srno">' + srNo + '</span>'
             + '<div class="ms-2 row w-100 align-items-center m-0 flex-grow-1">'
             + '<div class="col-12 col-lg-3 px-2 mb-1 mb-lg-0"><p class="mb-0 text-break" id="advocateName' + srNo + '">' + advocateName + '</p></div>'
             + '<div class="col-12 col-lg-3 px-2 mb-1 mb-lg-0"><p class="mb-0 text-break" id="city' + srNo + '">' + city + '</p></div>'
             + '<div class="col-12 col-lg-2 px-2 mb-1 mb-lg-0"><p class="mb-0 text-break" id="mobileNo' + srNo + '">' + mobileNo + '</p></div>'
             + '<div class="col-12 col-lg-2 px-2 mb-1 mb-lg-0 text-end">'
             + '<p class="mb-0 d-lg-none me-2 d-inline">Amount :</p>'
             + '<span class="text-danger fw-bold" id="lblAmount' + srNo + '">Rs. ' + amount + '</span>'
             + '</div>'
             + '<div class="col-12 col-lg-2 px-2 text-lg-center">'
             + '<a href="javascript:void(0);" onclick="removeDefendant(this)" class="text-danger" title="Remove" class="text-decoration-none"><i class="fa-solid fa-trash-can"></i> <span class="d-lg-none">Remove</span></a>'
             + '</div></div></div></div></div>');

            $('#dynamicHeaderRow').html('<div class="col-lg-3 px-2"><p class="mb-0 fw-bold">Advocate Name</p></div><div class="col-lg-3 px-2"><p class="mb-0 fw-bold">City</p></div><div class="col-lg-2 px-2"><p class="mb-0 fw-bold">Mobile No.</p></div><div class="col-lg-2 px-2 text-end"><p class="mb-0 fw-bold">Amount</p></div><div class="col-lg-2 px-2 text-center"><p class="mb-0 fw-bold">Action</p></div>');
            $('#defendantHeader').removeClass('hide-element');

            var sum = 0;
            $('.text-danger').each(function () {
                var text = $(this).text().replace("Rs. ", '');
                if (!isNaN(text) && text.length != 0) sum += parseFloat(text);
            });
            $("#lblGrandTotalAmount").html(sum.toFixed(2));

            $('#txtAdvocateName').val('');
            $('#txtCity').val('');
            $('#txtMobileNo').val('');
        });

        var searchPageNo = 1;
        var searchPageSize = 10;
        var isSearchLoading = false;
        var hasMoreSearchData = true;
        var currentSearchValue = "";
        var searchDebounceTimer;

        $('#txtSearch').on('input', function () {
            clearTimeout(searchDebounceTimer);
            var searchValue = $('#txtSearch').val().trim();

            if (searchValue === "") {
                $("#dvDefendantSearchList").empty();
                searchPageNo = 1;
                hasMoreSearchData = true;
                currentSearchValue = "";
                return;
            }

            // Reset pagination when search text changes
            currentSearchValue = searchValue;
            searchPageNo = 1;
            hasMoreSearchData = true;
            $("#dvDefendantSearchList").empty();

            searchDebounceTimer = setTimeout(function () {
                loadSearchData(searchValue, true);
            }, 500);
        });

        // Scroll event on the search results container for lazy loading
        $('#dvDefendantSearchList').on('scroll', function () {
            var container = $(this);
            if (container.scrollTop() + container.innerHeight() >= container[0].scrollHeight - 20) {
                if (!isSearchLoading && hasMoreSearchData && currentSearchValue !== "") {
                    searchPageNo++;
                    loadSearchData(currentSearchValue, false);
                }
            }
        });

        function loadSearchData(searchValue, isNewSearch) {
            if (isSearchLoading) return;
            isSearchLoading = true;

            // Show loading indicator
            if (isNewSearch) {
                $("#dvDefendantSearchList").empty();
            }
            $("#dvDefendantSearchList").append('<div id="searchLoader" class="text-center py-2"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</div>');

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSearchData", "Complaint")',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ SearchTitle: searchValue, PageNo: searchPageNo, PageSize: searchPageSize }),
                dataType: "json",
                success: function (response) {
                    $('#searchLoader').remove();
                    isSearchLoading = false;

                    if (response.data && response.data.length > 0) {
                        var startIndex = isNewSearch ? 0 : $('#dvDefendantSearchList .FinalList').length;
                        $.each(response.data, function (i, row) {
                            var SrNo = startIndex + i + 1;
                            var RowItem = '<div class="col-12 FinalList">'
                                    + '<div class="Details">'
                                    + '<div class="d-flex align-items-center w-100">'
                                    + '<span class="btn-span" id="srno">' + SrNo + '</span>'
                                    + '<div class="ms-2 row w-100 align-items-center m-0 flex-grow-1">'
                                    + '<div class="col-12 col-lg-4 px-2">'
                                    + '<label id="hdfEId' + SrNo + '" hidden>' + row.EId + '</label>'
                                    + '<label id="hdfFullName' + SrNo + '" hidden>' + row.FullName + '</label>'
                                    + '<label id="hdfEnroNumber' + SrNo + '" hidden>' + row.EnroNumber + '</label>'
                                    + '<p class="mb-0 text-break">' + row.FullName + '</p></div>'
                                    + '<div class="col-12 col-lg-3 px-2"><p class="mb-0 text-break">' + row.EnroNumber + '</p></div>'
                                    + '<div class="col-12 col-lg-3 px-2"><p class="mb-0 text-break">' + (row.ContactNumber || '') + '</p></div>'
                                    + '<div class="col-12 col-lg-2 px-2 text-lg-center">'
                                    + '<a class="btn btn-sm btn-danger text-white" id="lnkAddToList" onclick="addToFinal(' + SrNo + ')">Select</a>'
                                    + '</div></div></div></div></div>';
                            $("#dvDefendantSearchList").append(RowItem);
                        });

                        // Check if we have more data to load
                        var totalLoaded = $('#dvDefendantSearchList .FinalList').length;
                        var totalRecord = response.totalRecord || 0;
                        if (totalLoaded >= totalRecord || response.data.length < searchPageSize) {
                            hasMoreSearchData = false;
                        }
                    } else {
                        hasMoreSearchData = false;
                        if (isNewSearch) {
                            $("#dvDefendantSearchList").append('<div class="text-center py-2 text-muted">No advocates found.</div>');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    $('#searchLoader').remove();
                    isSearchLoading = false;
                    console.log("AJAX Error: ", error);
                    console.log("Response: ", xhr.responseText);
                }
            });
        }
    });

    function ddlPaymentModeChange() {
        var val = $('#ddlPaymentMode').val();
        if (val == "D.D." || val == "OUTSTANDING" || val == "RTGS" || val == "JOURNAL") {
            $('#divTransactionNumber').removeClass('hide-element');
            $('#divBank').removeClass('hide-element');
        } else {
            $('#divTransactionNumber').addClass('hide-element');
            $('#divBank').addClass('hide-element');
        }
    }

    function GetComplaintBankList() {
        $.ajax({
            type: "POST",
            url: "/Complaint/GetComplaintBankList",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
                if (response.IsSuccess) {
                    if (response.Data != null) {
                        if (response.Data != '') {

                            $.each(response.Data, function (i, item) {
                                $("#ddlBank").append('<option value="' + item.Id + '">' + item.BankName + '</option>');
                            });
                        }
                        else {
                            $("#ddlBank").empty();
                            $("#ddlBank").append('<option value="0">Select</option>');
                        }
                    }
                    else {
                        $("#ddlBank").empty();
                        $("#ddlBank").append('<option value="0">Select</option>');
                    }
                }
                else {
                    $("#ddlBank").empty();
                    $("#ddlBank").append('<option value="0">Select</option>');
                }
            }, failure: function (result) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
            },
            error: function (result) {
                $("#ddlBank").empty();
                $("#ddlBank").append('<option value="0">Select</option>');
            }
        });
    }

    function addToFinal(id) {
        var AddAdvocateCount = parseInt($('#hdfAddAdvocateCount').val() || '0');
        var srNo = AddAdvocateCount + 1;
        var Id = $('#hdfEId' + id).text();
        var name = $('#hdfFullName' + id).text();
        var enronumber = $('#hdfEnroNumber' + id).text();

        var amount = 500;
        if (AddAdvocateCount == 0) amount = 1000;
        else if (AddAdvocateCount == 1) amount = 0;

        $('#finalList').append('<div class="col-12 FinalList" id="divFinalList">'
             + '<div class="Details">'
             + '<div class="d-flex align-items-center w-100">'
             + '<span class="btn-span defendantlistsrno" id="srno">' + srNo + '</span>'
             + '<div class="ms-2 row w-100 align-items-center m-0 flex-grow-1">'
             + '<div class="col-12 col-lg-4 px-2 mb-1 mb-lg-0"><p class="mb-0 text-break" id="lblName' + srNo + '">' + name + '</p></div>'
             + '<div class="col-12 col-lg-3 px-2 mb-1 mb-lg-0"><p class="mb-0 text-break" id="hdfEnrollNoFinal' + srNo + '">' + enronumber + '</p></div>'
             + '<label id="hdfDetailsAdvocateId' + srNo + '" hidden>' + Id + '</label>'
             + '<div class="col-12 col-lg-3 px-2 mb-1 mb-lg-0 text-end">'
             + '<p class="mb-0 d-lg-none me-2 d-inline">Amount :</p>'
             + '<span class="text-danger fw-bold" id="lblAmount' + srNo + '">Rs. ' + amount + '</span>'
             + '</div>'
             + '<div class="col-12 col-lg-2 px-2 text-center">'
             + '<a href="javascript:void(0);" onclick="removeDefendant(this)" class="text-danger" title="Remove" class="text-decoration-none"><i class="fa-solid fa-trash-can"></i></a>'
             + '</div></div></div></div></div>');

        $('#dynamicHeaderRow').html('<div class="col-lg-4 px-2"><p class="mb-0 fw-bold">Advocate Name</p></div><div class="col-lg-3 px-2"><p class="mb-0 fw-bold">Enrollment No</p></div><div class="col-lg-3 px-2 text-end"><p class="mb-0 fw-bold">Amount</p></div><div class="col-lg-2 px-2 text-center"><p class="mb-0 fw-bold">Action</p></div>');
        $('#defendantHeader').removeClass('hide-element');

        var sum = 0;
        $('.text-danger').each(function () {
            var text = $(this).text().replace("Rs. ", '');
            if (!isNaN(text) && text.length != 0) sum += parseFloat(text);
        });
        $("#lblGrandTotalAmount").html(sum.toFixed(2));

        $('#hdfAddAdvocateCount').val(AddAdvocateCount + 1);
        $('#txtSearch').val('');
        $('#dvDefendantSearchList').empty();
    }

    function removeDefendant(btn) {
        var isFinalList = $(btn).closest('#finalList').length > 0;
        $(btn).closest(isFinalList ? '.FinalList' : '.DefendantList').remove();

        if (isFinalList) {
            var currentCount = parseInt($('#hdfAddAdvocateCount').val() || '0');
            if (currentCount > 0) $('#hdfAddAdvocateCount').val(currentCount - 1);

            $('#finalList .FinalList').each(function (index) {
                var srNo = index + 1;
                var amount = (srNo === 1) ? 1000 : ((srNo === 2) ? 0 : 500);

                $(this).find('.btn-span').text(srNo);
                $(this).find('[id^="lblName"]').attr('id', 'lblName' + srNo);
                $(this).find('[id^="hdfEnrollNoFinal"]').attr('id', 'hdfEnrollNoFinal' + srNo);
                $(this).find('[id^="hdfDetailsAdvocateId"]').attr('id', 'hdfDetailsAdvocateId' + srNo);
                $(this).find('[id^="lblAmount"]').attr('id', 'lblAmount' + srNo).text('Rs. ' + amount);
            });
        } else {
            $('#dvDefendantList .DefendantList').each(function (index) {
                var srNo = index + 1;
                var amount = (srNo === 1) ? 1000 : ((srNo === 2) ? 0 : 500);

                $(this).find('.defendantlistsrno').text(srNo);
                $(this).find('[id^="advocateName"]').attr('id', 'advocateName' + srNo);
                $(this).find('[id^="city"]').attr('id', 'city' + srNo);
                $(this).find('[id^="mobileNo"]').attr('id', 'mobileNo' + srNo);
                $(this).find('[id^="lblAmount"]').attr('id', 'lblAmount' + srNo).text('Rs. ' + amount);
            });
        }

        var sum = 0;
        $('.text-danger').each(function () {
            var text = $(this).text().replace("Rs. ", '');
            if (!isNaN(text) && text.length != 0) sum += parseFloat(text);
        });
        $("#lblGrandTotalAmount").html(sum.toFixed(2));

        if ($('#dvDefendantList .DefendantList').length === 0 && $('#finalList .FinalList').length === 0) {
            $('#defendantHeader').addClass('hide-element');
        }
    }

