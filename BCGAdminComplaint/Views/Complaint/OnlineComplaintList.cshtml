@{
    ViewBag.Title = "Online Complaint Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="complaint-container">
    <!-- Hero Header Banner -->
    <div class="complaint-hero">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="complaint-hero-title">
                    <i class="fa-solid fa-globe"></i>
                    Online Complaint Management
                    <span class="complaint-hero-badge">Public Portal Submissions</span>
                </h2>
                <p class="complaint-hero-subtitle">
                    <i class="fa-solid fa-cloud-arrow-down"></i>
                    Digital grievance filings, citizen applications & administrative verification
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Complaint/AddComplaint" class="btn btn-light fw-bold px-3 shadow-sm btn-hero-add">
                    <i class="fa-solid fa-plus me-1 text-primary"></i> Add Complaint
                </a>
                <button type="button" class="btn btn-outline-light fw-semibold px-3 btn-hero-action" id="addfilter">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
            </div>
        </div>
    </div>

    <!-- KPI Metric Cards Overview -->
    <div class="row g-3 metric-card-wrap" id="metricSummaryRow">
        <div class="col-md-3 col-sm-6 col-12">
            <div class="metric-card metric-blue" onclick="quickFilterByStatus('')">
                <div>
                    <div class="metric-val" id="metricTotal">...</div>
                    <div class="metric-lbl">Total Online</div>
                </div>
                <div class="metric-icon-box">
                    <i class="fa-solid fa-inbox"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-12">
            <div class="metric-card metric-amber" onclick="quickFilterByStatus('Pending')">
                <div>
                    <div class="metric-val" id="metricPending">...</div>
                    <div class="metric-lbl">Pending Review</div>
                </div>
                <div class="metric-icon-box">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-12">
            <div class="metric-card metric-emerald" onclick="quickFilterByStatus('Accepted')">
                <div>
                    <div class="metric-val" id="metricAccepted">...</div>
                    <div class="metric-lbl">Accepted</div>
                </div>
                <div class="metric-icon-box">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-12">
            <div class="metric-card metric-rose" onclick="quickFilterByStatus('Rejected')">
                <div>
                    <div class="metric-val" id="metricRejected">...</div>
                    <div class="metric-lbl">Rejected</div>
                </div>
                <div class="metric-icon-box">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Status Filter Chips -->
    <div class="quick-chips-wrapper">
        <div class="quick-chip active-chip" data-status-filter="" onclick="applyQuickStatusChip(this, '')">
            <i class="fa-solid fa-list-check"></i> All Online Complaints
        </div>
        <div class="quick-chip" data-status-filter="Pending" onclick="applyQuickStatusChip(this, 'Pending')">
            <i class="fa-solid fa-clock text-warning"></i> Pending Review
        </div>
        <div class="quick-chip" data-status-filter="Accepted" onclick="applyQuickStatusChip(this, 'Accepted')">
            <i class="fa-solid fa-circle-check text-success"></i> Accepted
        </div>
        <div class="quick-chip" data-status-filter="Rejected" onclick="applyQuickStatusChip(this, 'Rejected')">
            <i class="fa-solid fa-circle-xmark text-danger"></i> Rejected
        </div>
        <div class="quick-chip" data-status-filter="Due" onclick="applyQuickPaymentChip(this, 'Parcel Due')">
            <i class="fa-solid fa-triangle-exclamation text-danger"></i> Payment Due
        </div>
    </div>

    <!-- Collapsible Advanced Filter Drawer -->
    <div class="card main_filter_div shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <div class="filter-section-title mb-0">
                    <i class="fa-solid fa-sliders text-primary"></i> Advanced Online Complaint Search & Filters
                </div>
                <button type="button" class="btn btn-sm btn-link text-muted p-0 close_filterdiv">
                    <i class="fa-solid fa-xmark fs-6"></i>
                </button>
            </div>
            <form action="#" onsubmit="event.preventDefault();">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">Complaint Status</label>
                        <select id="drpStatus" class="form-control select2">
                            <option value="">All Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Accepted">Accepted</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">Payment Status</label>
                        <select id="drpPaymentStatus" class="form-control select2">
                            <option value="">All Payment Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Parcel Due">Parcel Due</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">From Date</label>
                        <input name="txtFromDate" id="txtFromDate" type="date" class="form-control filter-input" max="2999-12-31">
                    </div>
                    <div class="col-lg-3 col-md-6 col-12">
                        <label class="filter-input-label">To Date</label>
                        <input name="txtToDate" id="txtToDate" type="date" class="form-control filter-input" max="2999-12-31">
                    </div>

                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">Year</label>
                        <input name="txtYear" id="txtYear" type="number" placeholder="e.g. 2026" class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">From Number</label>
                        <input name="txtFromNo" id="txtFromNo" type="number" placeholder="From No." class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-4 col-12">
                        <label class="filter-input-label">To Number</label>
                        <input name="txtToNo" id="txtToNo" type="number" placeholder="To No." class="form-control filter-input">
                    </div>
                    <div class="col-lg-3 col-md-12 col-12 d-flex align-items-end">
                        <div class="w-100 d-flex gap-2">
                            <button type="button" id="lnkFilter" class="btn btn-primary btn-sm flex-fill fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                            </button>
                            <button type="button" id="btnCancel" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold">
                                <i class="fa-solid fa-rotate-left me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Search & Actions Toolbar -->
    <div class="action-bar-card d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="quick-search-wrap">
            <i class="fa-solid fa-magnifying-glass quick-search-icon"></i>
            <input id="txtQuickSearch" class="quick-search-input quicksearchcomplaintmanagement" placeholder="Quick Search by Complainant Name, Contact, Email or Complaint No...">
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small" id="liveResultsBadge"></span>
        </div>
    </div>

    <!-- Complaint Cards List Container -->
    <div id="tblComplaintList">
        <!-- Rendered via AJAX -->
    </div>

    <!-- Pagination & Entries Info -->
    <div id="paginationDiv" class="pagination-wrapper initially-hidden">
        <div id="entriesInfo" class="entries-text"></div>
        <ul class="pagination pagination-rounded mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- ==========================================================================
     MODALS
     ========================================================================== -->

<!-- PDF Full-Screen / Large Preview Modal -->
<div class="modal fade" id="pdfModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl pdf-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-pdf text-danger"></i> Document Preview
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="" id="displayPdf" class="pdf-preview-iframe"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Document List Modal -->
<div class="modal fade" id="document" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fa-solid fa-folder-open text-primary"></i> Uploaded Complaint Documents
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tblComplaintDoc" class="initially-hidden"></div>
                <div id="tblComplaintDocEmpty" class="initially-hidden">
                    <div class="empty-state-box py-4">
                        <div class="empty-state-icon empty-state-icon-sm">
                            <i class="fa-solid fa-file-circle-xmark text-muted"></i>
                        </div>
                        <h6 class="empty-state-heading fs-6">No Documents Uploaded</h6>
                        <p class="empty-state-desc mb-0 small text-muted">
                            No affidavit copy or additional attachment has been uploaded for this complaint.<br />
                            (કોઈ ફરિયાદ સોગંદનામાની નકલ અપલોડ કરેલ નથી)
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Adjunt / Advocate Details Modal -->
<div class="modal fade" id="Adjunt" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gavel text-primary"></i> Advocate Details (Complained Against)
                    </h5>
                    <div class="small text-muted">(જે વકીલ વિરુદ્ધ ફરિયાદ કરવામાં આવી છે તેની વિગતો)</div>
                </div>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tblComplaintAgaints"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var baseFilter = {
        pageNo: 1,
        pageSize: 10,
        sortColumn: 1,
        sortOrder: 'desc',
        searchValue: ''
    };

    function initSelect2() {
        if ($.fn.select2) {
            $('#drpStatus, #drpPaymentStatus, select.select2').select2({
                allowClear: true,
                width: '100%'
            });
        }
    }

    $(document).ready(function () {
        initSelect2();
        GetOnlineComplaintList();
    });

    // Helper: Compute status styling attributes for online complaints
    function getStatusMeta(status) {
        var s = (status || "").toLowerCase().trim();
        if (s === "pending") return { color: "pending", badgeClass: "badge-status-pending", icon: "fa-clock" };
        if (s === "accepted") return { color: "accepted", badgeClass: "badge-status-accepted", icon: "fa-circle-check" };
        if (s === "rejected") return { color: "rejected", badgeClass: "badge-status-rejected", icon: "fa-circle-xmark" };
        return { color: "default", badgeClass: "badge-status-default", icon: "fa-tag" };
    }

    // Helper: Get initials for avatar
    function getInitials(name) {
        if (!name) return "OC";
        var parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function GetOnlineComplaintList() {
        var Data = JSON.stringify({
            baseFilter: baseFilter,
            Status: $("#drpStatus option:selected").text() === 'All Statuses' || $("#drpStatus option:selected").text() === 'Select Status' ? "" : $("#drpStatus option:selected").text().trim(),
            PaymentStatus: $("#drpPaymentStatus option:selected").text() === 'All Payment Statuses' || $("#drpPaymentStatus option:selected").text() === 'Select Payment Status' ? "" : $("#drpPaymentStatus option:selected").text().trim(),
            FromDate: $("#txtFromDate").val(),
            ToDate: $("#txtToDate").val(),
            Year: $("#txtYear").val(),
            FromNo: $("#txtFromNo").val(),
            ToNo: $("#txtToNo").val()
        });

        // Skeleton loading state
        $("#tblComplaintList").html(
            '<div class="text-center py-5">'
            + '<div class="spinner-border text-primary mb-3 spinner-lg" role="status"></div>'
            + '<div class="text-muted fw-semibold">Loading online complaint records...</div>'
            + '</div>'
        );

        $.ajax({
            type: 'POST',
            url: "/Complaint/GetOnlineComplaintList",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#tblComplaintList").empty();
                var complaintList = $("#tblComplaintList");

                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    var totalRecords = response.Data[0].TotalRecord || response.Data.length;

                    // Update Top Metric Cards
                    $("#metricTotal").text(totalRecords);
                    var pendingCount = 0;
                    var acceptedCount = 0;
                    var rejectedCount = 0;

                    $.each(response.Data, function (i, val) {
                        var st = (val.Status || "").toLowerCase();
                        if (st === 'pending') pendingCount++;
                        if (st === 'accepted') acceptedCount++;
                        if (st === 'rejected') rejectedCount++;
                    });

                    $("#metricPending").text(pendingCount);
                    $("#metricAccepted").text(acceptedCount);
                    $("#metricRejected").text(rejectedCount);

                    $("#liveResultsBadge").html('<strong>' + totalRecords + '</strong> online submissions');

                    $.each(response.Data, function (i, value) {
                        var statusMeta = getStatusMeta(value.Status);
                        var initials = getInitials(value.FullName);

                        // Payment Status Pill
                        var paymentBadgeHtml = "";
                        var pStatus = (value.PaymentStatus || "").trim().toLowerCase();
                        if (pStatus === "completed" || pStatus === "paid") {
                            paymentBadgeHtml = '<span class="badge-payment-paid"><i class="fa-solid fa-circle-check"></i> Paid</span>';
                        } else if (pStatus === "parcel due" || pStatus === "due") {
                            paymentBadgeHtml = '<span class="badge-payment-due"><i class="fa-solid fa-triangle-exclamation"></i> Due</span>';
                        } else {
                            paymentBadgeHtml = '<span class="badge-payment-pending"><i class="fa-solid fa-clock"></i> ' + (value.PaymentStatus || "Pending") + '</span>';
                        }

                        // Complaint Status Pill
                        var statusBadgeHtml = "";
                        var rawStatus = (value.Status || "").trim();
                        if (rawStatus !== "") {
                            statusBadgeHtml = '<span class="badge-soft ' + statusMeta.badgeClass + '"><i class="fa-solid ' + statusMeta.icon + '"></i> ' + rawStatus + '</span>';
                        }

                        // Advocate strip
                        var advocateHtml = "";
                        if (value.ComplainedAgainst && value.ComplainedAgainst.trim() !== "") {
                            advocateHtml = '<div class="advocate-strip">'
                                         + '<span class="advocate-strip-label"><i class="fa-solid fa-gavel text-primary me-1"></i> Complained Against:</span>'
                                         + '<span class="advocate-strip-name">' + value.ComplainedAgainst + '</span>'
                                         + '</div>';
                        }

                        // Attachment quick chip if available
                        var attachmentChipHtml = "";
                        if (value.AffidavitFilesText || value.AdditionalFilesText) {
                            var fileName = value.AffidavitFilesText || value.AdditionalFilesText;
                            attachmentChipHtml = '<div class="attachment-chip"><i class="fa-solid fa-paperclip"></i> ' + fileName + '</div>';
                        }

                        // Card Action Buttons
                        var actionsHtml = '<div class="actions-group">';

                        var isPending = value.Status && value.Status.trim().toLowerCase() === 'pending';
                        if (isPending) {
                            actionsHtml += '<button type="button" class="btn-action btn-action-success" id="lnkAcceptComplaint"><i class="fa-solid fa-circle-check"></i> Accept</button>';
                            actionsHtml += '<button type="button" class="btn-action btn-action-danger" id="lnkRejectComplaint"><i class="fa-solid fa-circle-xmark"></i> Reject</button>';
                        }

                        actionsHtml += '<button type="button" class="btn-action" id="lnkViewDocument" data-bs-toggle="modal" data-bs-target="#document" data-toggle="modal" data-target="#document"><i class="fa-solid fa-file-lines text-primary"></i> Documents</button>';
                        actionsHtml += '<button type="button" class="btn-action" id="lnkViewAdjunt" data-bs-toggle="modal" data-bs-target="#Adjunt" data-toggle="modal" data-target="#Adjunt"><i class="fa-solid fa-user-shield text-primary"></i> Adjunt Details</button>';
                        actionsHtml += '<button type="button" class="btn-action btn-action-danger ms-auto" id="lnkDeleteComplaint"><i class="fa-solid fa-trash-can"></i> Delete</button>';
                        actionsHtml += '</div>';

                        var dueDisplay = value.DueAmount != null && value.DueAmount > 0
                                       ? '<span class="text-danger fw-bold">₹' + value.DueAmount + '</span>'
                                       : '<span class="text-success fw-semibold">₹0</span>';

                        // Status Ribbon (New / Old status indicator)
                        var ribbonHtml = "";
                        var hasRibbonClass = "";
                        if (value.NewStatusCount > 0) {
                            ribbonHtml = '<div class="corner-ribbon ribbon-new bg-info text-white">New</div>';
                            hasRibbonClass = " has-ribbon";
                        } else if (value.OldStatusCount > 0) {
                            ribbonHtml = '<div class="corner-ribbon ribbon-old bg-warning text-dark">Old</div>';
                            hasRibbonClass = " has-ribbon";
                        }

                        var cardStatusColor = statusMeta.color;

                        var finalCard = ''
                            + '<div class="complaint-card main_card_list ribbon-wrapper' + hasRibbonClass + '" data-status-color="' + cardStatusColor + '" data-complaint-no="' + (value.ComplaintNumber || '') + '">'
                                + ribbonHtml
                                + '<div id="HdfId" class="hidden-field">' + value.Id + '</div>'
                                + '<div class="complaint-card-header">'
                                    + '<div class="d-flex align-items-center gap-3">'
                                        + '<div class="complaint-index-badge">' + (value.SrNo || (i + 1)) + '</div>'
                                        + '<div class="complaint-number-box complaint_number">'
                                            + '<span class="complaint-number-static description">'
                                                + '<i class="fa-solid fa-globe text-primary complaint-header-icon"></i>'
                                                + '<span class="complaint-number-text">' + value.ComplaintNumber + '</span>'
                                            + '</span>'
                                        + '</div>'
                                    + '</div>'
                                    + '<div class="complaint-card-meta">'
                                        + statusBadgeHtml
                                        + '<span class="complaint-date-text"><i class="fa-regular fa-calendar-days"></i> ' + (value.ComplaintsCreateDate || '') + '</span>'
                                    + '</div>'
                                + '</div>'
                                + '<div class="complaint-card-body">'
                                    + '<div class="row align-items-center g-3">'
                                        + '<div class="col-lg-7 col-md-12">'
                                            + '<div class="d-flex align-items-start gap-3">'
                                                + '<div class="complainant-avatar">' + initials + '</div>'
                                                + '<div class="flex-grow-1">'
                                                    + '<div class="complainant-name">' + (value.FullName || 'Online Complainant') + '</div>'
                                                    + '<div class="contact-pill-wrap">'
                                                        + (value.ContactNumber ? '<a href="tel:' + value.ContactNumber + '" class="contact-pill"><i class="fa-solid fa-phone"></i> ' + value.ContactNumber + '</a>' : '')
                                                        + (value.EmailAddress ? '<a href="mailto:' + value.EmailAddress + '" class="contact-pill"><i class="fa-solid fa-envelope"></i> ' + value.EmailAddress + '</a>' : '')
                                                    + '</div>'
                                                + '</div>'
                                            + '</div>'
                                            + advocateHtml
                                            + attachmentChipHtml
                                        + '</div>'
                                        + '<div class="col-lg-5 col-md-12">'
                                            + '<div class="financial-box">'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Total Fee</div>'
                                                    + '<div class="financial-value">₹' + (value.TotalAmount != null ? value.TotalAmount : 0) + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Paid</div>'
                                                    + '<div class="financial-value text-success">₹' + (value.PaidAmount != null ? value.PaidAmount : 0) + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col">'
                                                    + '<div class="financial-title">Due</div>'
                                                    + '<div class="financial-value">' + dueDisplay + '</div>'
                                                + '</div>'
                                                + '<div class="financial-col financial-col-last">'
                                                    + '<div class="financial-title">Status</div>'
                                                    + '<div class="mt-1">' + paymentBadgeHtml + '</div>'
                                                + '</div>'
                                            + '</div>'
                                        + '</div>'
                                    + '</div>'
                                + '</div>'
                                + '<div class="complaint-card-footer">'
                                    + actionsHtml
                                + '</div>'
                            + '</div>';

                        complaintList.append(finalCard);
                    });

                    $("#paginationDiv").css("display", "flex");
                    RenderPagination(totalRecords);
                } else {
                    $("#metricTotal").text("0");
                    $("#metricPending").text("0");
                    $("#metricAccepted").text("0");
                    $("#metricRejected").text("0");
                    $("#liveResultsBadge").html('0 records');

                    var emptyHtml = '<div class="empty-state-box">'
                                  + '<div class="empty-state-icon">'
                                      + '<i class="fa-solid fa-inbox"></i>'
                                  + '</div>'
                                  + '<h4 class="empty-state-heading">No Online Complaints Found</h4>'
                                  + '<p class="empty-state-desc">We couldn\'t find any online complaints matching your active search criteria. All online citizen submissions have been reviewed.</p>'
                                  + '<button type="button" class="btn btn-outline-primary btn-sm fw-semibold px-3" onclick="resetAllFilters()">'
                                      + '<i class="fa-solid fa-rotate-left me-1"></i> Clear All Filters'
                                  + '</button>'
                              + '</div>';
                    complaintList.append(emptyHtml);
                    $("#paginationDiv").hide();
                    $("#paginationList").empty();
                    $("#entriesInfo").empty();
                }
            },
            error: function () {
                swal('Something went wrong!', 'Unable to fetch online complaints.', 'error');
            }
        });
    }

    // Quick filter chips click handler
    function applyQuickStatusChip(elem, statusValue) {
        $(".quick-chip").removeClass("active-chip");
        $(elem).addClass("active-chip");
        $("#drpStatus").val(statusValue).trigger('change');
        baseFilter.pageNo = 1;
        GetOnlineComplaintList();
    }

    function applyQuickPaymentChip(elem, paymentValue) {
        $(".quick-chip").removeClass("active-chip");
        $(elem).addClass("active-chip");
        $("#drpPaymentStatus").val(paymentValue).trigger('change');
        baseFilter.pageNo = 1;
        GetOnlineComplaintList();
    }

    function quickFilterByStatus(statusVal) {
        $(".quick-chip").removeClass("active-chip");
        $('.quick-chip[data-status-filter="' + statusVal + '"]').addClass("active-chip");
        $("#drpStatus").val(statusVal).trigger('change');
        baseFilter.pageNo = 1;
        GetOnlineComplaintList();
    }

    function resetAllFilters() {
        $(".quick-chip").removeClass("active-chip");
        $('.quick-chip[data-status-filter=""]').addClass("active-chip");
        baseFilter.pageNo = 1;
        baseFilter.searchValue = '';
        $('#txtQuickSearch').val('');
        $('#drpStatus').val('').trigger('change');
        $('#drpPaymentStatus').val('').trigger('change');
        $('#txtFromDate').val('');
        $('#txtToDate').val('');
        $('#txtYear').val('');
        $('#txtFromNo').val('');
        $('#txtToNo').val('');
        GetOnlineComplaintList();
    }

    /* Documents Preview Ajax */
    $('body').on('click', '#lnkViewDocument', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();

        $.ajax({
            type: 'POST',
            url: "/Complaint/GetOnlineDocument",
            data: { ComplaintId: CId },
            success: function (response) {
                $("#tblComplaintDoc").empty();
                var complaintDocList = $("#tblComplaintDoc");
                var complaintDocEmpty = $("#tblComplaintDocEmpty");

                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    complaintDocEmpty.hide();
                    complaintDocList.show();
                    $.each(response.Data, function (i, value) {
                        var NhdfFilePathId = 'hdfFilePath' + i;
                        var isMissing = !value.FilePath || value.FilePath === '';
                        var ext = (value.FileName || "").split('.').pop().toLowerCase();
                        var iconClass = ext === 'pdf' ? 'fa-file-pdf text-danger' : (ext === 'jpg' || ext === 'png' || ext === 'jpeg' ? 'fa-file-image text-primary' : 'fa-file-lines text-muted');

                        var cardHtml = '<div class="file-preview-card">'
                                     + '<div class="file-preview-info">'
                                         + '<div class="file-icon-box"><i class="fa-solid ' + iconClass + '"></i></div>'
                                         + '<div>'
                                             + '<div class="file-name-text">' + (value.FileName || 'Attachment File') + '</div>'
                                             + (value.Description ? '<div class="file-note-text"><i class="fa-solid fa-comment-dots text-muted me-1"></i> ' + value.Description + '</div>' : '')
                                         + '</div>'
                                     + '</div>';

                        if (!isMissing) {
                            cardHtml += '<input name="' + NhdfFilePathId + '" id="' + NhdfFilePathId + '" type="hidden" value="' + value.FilePath + '">'
                                      + '<button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-3" onclick="getFile(' + i + ')">'
                                          + '<i class="fa-solid fa-eye me-1"></i> Preview'
                                      + '</button>';
                        } else {
                            cardHtml += '<span class="badge bg-danger-subtle text-danger">File Unavailable</span>';
                        }
                        cardHtml += '</div>';

                        complaintDocList.append(cardHtml);
                    });
                } else {
                    complaintDocList.hide();
                    complaintDocEmpty.show();
                }
            },
            error: function () {
                swal('Something went wrong!', 'Failed to fetch online documents.', 'error');
            }
        });
    });

    function getFile(RowId) {
        var VFilePathId = '#hdfFilePath' + RowId;
        var VFilePath = $(VFilePathId).val();

        if (VFilePath && VFilePath !== "") {
            $('#displayPdf').attr('src', VFilePath);
            $('#pdfModal').modal('show');
        }
    }

    $('#pdfModal').on('hidden.bs.modal', function () {
        if ($('#document').is(':visible')) {
            $('body').addClass('modal-open');
        }
    });

    /* Adjunt Details Ajax */
    $('body').on('click', '#lnkViewAdjunt', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();

        $.ajax({
            type: 'POST',
            url: "/Complaint/GetOnlineAdjuntDetails",
            data: { ComplaintId: CId },
            success: function (response) {
                $("#tblComplaintAgaints").empty();
                var complaintAgaintsList = $("#tblComplaintAgaints");

                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    $.each(response.Data, function (data, value) {
                        var SrNo = data + 1;
                        var enrNo = value.EnrollmentNo || value.EnrollmentNumber || 'N/A';
                        var name = value.Name || 'Advocate Name';
                        var amount = value.Amount || 0;

                        var adjuntItem = ''
                            + '<div class="card border mb-3 rounded-3 shadow-none">'
                                + '<div class="card-body p-3">'
                                    + '<div class="d-flex align-items-center justify-content-between mb-2">'
                                        + '<div class="d-flex align-items-center gap-2">'
                                            + '<span class="badge bg-primary rounded-pill px-2">#' + SrNo + '</span>'
                                            + '<h6 class="mb-0 fw-bold text-dark">' + name + '</h6>'
                                        + '</div>'
                                        + '<span class="badge bg-light text-dark border fw-bold px-3 py-2">₹' + amount + '</span>'
                                    + '</div>'
                                    + '<div class="text-muted small">'
                                        + '<i class="fa-solid fa-id-card text-primary me-1"></i> Enrollment No: <strong class="text-dark">' + enrNo + '</strong>'
                                    + '</div>'
                                + '</div>'
                            + '</div>';
                        complaintAgaintsList.append(adjuntItem);
                    });
                } else {
                    var emptyAdjunt = '<div class="empty-state-box py-4 my-2">'
                                    + '<div class="empty-state-icon empty-state-icon-sm">'
                                        + '<i class="fa-solid fa-user-xmark text-muted"></i>'
                                    + '</div>'
                                    + '<h6 class="empty-state-heading fs-6">No Adjunt Records Found</h6>'
                                    + '<p class="empty-state-desc mb-0 small text-muted">No additional advocate details are recorded for this online complaint.</p>'
                                + '</div>';
                    complaintAgaintsList.append(emptyAdjunt);
                }
            },
            error: function () {
                swal('Something went wrong!', 'Failed to fetch adjunt details.', 'error');
            }
        });
    });

    /* Delete Online Complaint */
    $('body').on('click', '#lnkDeleteComplaint', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();
        var complaintNo = currow.attr('data-complaint-no') || 'this complaint';

        swal({
            title: "Delete Online Complaint?",
            text: "Are you sure you want to delete " + complaintNo + "? This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc2626",
            confirmButtonText: "Yes, Delete It",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: 'POST',
                    url: "/Complaint/DeleteOnlineComplaint",
                    data: { ComplaintId: CId },
                    success: function (response) {
                        if (response.IsSuccess && response.Data === "DE") {
                            swal("Deleted!", "Online complaint deleted successfully.", "success");
                            GetOnlineComplaintList();
                        } else {
                            swal("Failed", "Could not delete online complaint.", "error");
                        }
                    },
                    error: function () {
                        swal("Error", "Server error while deleting online complaint.", "error");
                    }
                });
            }
        });
    });

    /* Accept Online Complaint */
    $('body').on('click', '#lnkAcceptComplaint', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();

        Swal.fire({
            title: "Accept Online Complaint",
            html: '<p class="text-start text-muted mb-2">Are you sure you want to accept and register this online complaint?</p>',
            icon: "question",
            input: 'textarea',
            inputPlaceholder: "Enter optional acceptance remark...",
            showCancelButton: true,
            confirmButtonColor: "#059669",
            confirmButtonText: "Yes, Accept Complaint",
            cancelButtonText: "Cancel"
        }).then(function (result) {
            if (result.isConfirmed) {
                var reason = result.value || 'Complaint has been successfully registered in the system. It is currently under initial administrative verification and scrutiny.';
                $.ajax({
                    type: 'POST',
                    url: "/Complaint/OnlineComplaintStatusUpdate",
                    data: {
                        ComplaintId: CId,
                        Remark: reason,
                        Mode: "Accepted"
                    },
                    success: function (response) {
                        if (response.IsSuccess) {
                            Swal.fire("Accepted!", "Complaint accepted and registered successfully!", "success");
                            GetOnlineComplaintList();
                        } else {
                            Swal.fire("Error!", response.Message || "Failed to accept complaint.", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error!", "Error updating complaint status.", "error");
                    }
                });
            }
        });
    });

    /* Reject Online Complaint */
    $('body').on('click', '#lnkRejectComplaint', function () {
        var currow = $(this).closest('.main_card_list');
        var CId = currow.find('#HdfId').text().trim();

        Swal.fire({
            title: "Reject Online Complaint",
            html: '<p class="text-start text-muted mb-2">Please enter the reason for rejecting this online complaint: <span class="text-danger fw-bold">*</span></p>',
            icon: "warning",
            input: 'textarea',
            inputPlaceholder: "Enter rejection reason here (required)...",
            showCancelButton: true,
            confirmButtonColor: "#dc2626",
            confirmButtonText: "Reject Complaint",
            cancelButtonText: "Cancel",
            inputValidator: function (value) {
                if (!value || !value.trim()) {
                    return 'A rejection reason is required!';
                }
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                var reason = result.value;
                $.ajax({
                    type: 'POST',
                    url: "/Complaint/OnlineComplaintStatusUpdate",
                    data: {
                        ComplaintId: CId,
                        Remark: reason,
                        Mode: "Rejected"
                    },
                    success: function (response) {
                        if (response.IsSuccess) {
                            Swal.fire("Rejected!", "Online complaint has been rejected.", "success");
                            GetOnlineComplaintList();
                        } else {
                            Swal.fire("Error!", response.Message || "Failed to reject complaint.", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error!", "Error updating complaint status.", "error");
                    }
                });
            }
        });
    });

    /* Filter Drawer Actions */
    $('#lnkFilter').click(function () {
        baseFilter.pageNo = 1;
        baseFilter.searchValue = $("#txtQuickSearch").val();
        GetOnlineComplaintList();
    });

    $('#txtQuickSearch').on('input', function () {
        baseFilter.pageNo = 1;
        baseFilter.searchValue = $(this).val();
        GetOnlineComplaintList();
    });

    $('#btnCancel').click(function () {
        resetAllFilters();
    });

    $('#addfilter').click(function () {
        $(".main_filter_div").slideToggle(200, function () {
            initSelect2();
        });
    });

    $('.close_filterdiv').click(function () {
        $(".main_filter_div").slideUp(200);
    });

    /* Pagination */
    function RenderPagination(totalRecords) {
        if (!totalRecords || totalRecords <= 0) {
            $("#paginationDiv").hide();
            $("#entriesInfo").empty();
            $("#paginationList").empty();
            return;
        }
        $("#paginationDiv").css("display", "flex");
        var totalPages = Math.ceil(totalRecords / baseFilter.pageSize);
        var paginationHtml = '';
        $("#paginationList").empty();

        var startEntry = totalRecords > 0 ? ((baseFilter.pageNo - 1) * baseFilter.pageSize + 1) : 0;
        var endEntry = Math.min(baseFilter.pageNo * baseFilter.pageSize, totalRecords);
        $("#entriesInfo").html('Showing <strong class="text-dark">' + startEntry + '</strong> to <strong class="text-dark">' + endEntry + '</strong> of <strong class="text-dark">' + totalRecords + '</strong> online complaints');

        if (totalPages > 1) {
            var isFirst = baseFilter.pageNo <= 1;
            var prevDisabled = isFirst ? 'disabled' : '';
            var firstClick = isFirst ? '' : 'onclick="ChangePage(1)"';
            var prevClick = isFirst ? '' : 'onclick="ChangePage(' + (baseFilter.pageNo - 1) + ')"';

            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" ' + firstClick + ' title="First Page" aria-label="First"><i class="fa-solid fa-angles-left"></i></a></li>';
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" ' + prevClick + ' title="Previous Page" aria-label="Previous"><i class="fa-solid fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, baseFilter.pageNo - 2);
            var endPage = Math.min(totalPages, baseFilter.pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === baseFilter.pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + i + ')">' + i + '</a></li>';
            }

            var isLast = baseFilter.pageNo >= totalPages;
            var nextDisabled = isLast ? 'disabled' : '';
            var nextClick = isLast ? '' : 'onclick="ChangePage(' + (baseFilter.pageNo + 1) + ')"';
            var lastClick = isLast ? '' : 'onclick="ChangePage(' + totalPages + ')"';

            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" ' + nextClick + ' title="Next Page" aria-label="Next"><i class="fa-solid fa-chevron-right"></i></a></li>';
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" ' + lastClick + ' title="Last Page" aria-label="Last"><i class="fa-solid fa-angles-right"></i></a></li>';
        }

        $("#paginationList").html(paginationHtml);
    }

    function ChangePage(page) {
        baseFilter.pageNo = page;
        GetOnlineComplaintList();
        $('html, body').animate({ scrollTop: $(".complaint-hero").offset().top }, 200);
    }
</script>
