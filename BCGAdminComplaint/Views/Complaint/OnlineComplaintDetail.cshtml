                        } else {
                            Swal.fire("Failed!", "Failed to delete GB Meeting Details.", "error");
                        }
                    },
                    error: function (result) {
                        Swal.fire("Error!", "Error deleting GB Meeting Details.", "error");
                    }
                });
            }
        });
    }

    function getGBMeetingLogs(complaintId) {
        if (!complaintId || complaintId === "0") {
            $('#dvGBMeetingList').empty();
            return;
        }
        $.ajax({
            type: 'POST',
            url: "/Complaint/GetComplaintGBMeetingLogList",
            data: { ComplaintId: complaintId },
            dataType: "json",
            success: function (response) {
                var $container = $('#dvGBMeetingList');
                $container.empty();
                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    $.each(response.Data, function (i, item) {
                        var html = '<div class="gb-meeting-card">'
                            + '<div class="gb-header-row">'
                                + '<div>'
                                    + '<span class="gb-date-badge"><i class="fa-regular fa-calendar me-1"></i> <span class="meeting-date-content">' + (item.MeetingDate || '') + '</span></span>'
                                    + '<h6 class="gb-title meeting-title-content">' + (item.MeetingTitle || '') + '</h6>'
                                + '</div>'
                                + '<div class="gb-actions">'
                                    + '<button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="viewMeetingNote(this)"><i class="fa-solid fa-eye me-1"></i> View</button>'
                                    + '<button type="button" class="btn btn-outline-info btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="editGBMeetingLog(\'' + item.Id + '\', this)"><i class="fa-solid fa-pen-to-square me-1"></i> Edit</button>'
                                    + '<button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="deleteGBMeetingLog(\'' + item.Id + '\')"><i class="fa-solid fa-trash me-1"></i> Delete</button>'
                                + '</div>'
                            + '</div>'
                            + '<div class="gb-note-box">'
                                + '<div class="gb-note-label"><i class="fa-regular fa-note-sticky text-indigo me-1"></i> Meeting Note (બેઠકની નોંધ)</div>'
                                + '<p class="gb-note-content meeting-note-content">' + (item.MeetingNote || '') + '</p>'
                            + '</div>'
                        + '</div>';
                        $container.append(html);
                    });
                } else {
                    $container.html('<div class="empty-doc-placeholder text-center"><div class="empty-icon-circle"><i class="fa-regular fa-calendar-xmark"></i></div><div class="text-dark fw-semibold font-size-13">No General Board meeting records added yet.</div><div class="text-muted font-size-12">Click "Add Meeting" to log an official board meeting entry.</div></div>');
                }
            },
            error: function () {
                $('#dvGBMeetingList').html('<div class="empty-doc-placeholder text-center"><div class="empty-icon-circle"><i class="fa-regular fa-calendar-xmark"></i></div><div class="text-dark fw-semibold font-size-13">No General Board meeting records added yet.</div><div class="text-muted font-size-12">Click "Add Meeting" to log an official board meeting entry.</div></div>');
            }
        });
    }

    function applyStatusBadgeStyle(status) {
        var $badge = $('#txtComplaintStatus');
        $badge.removeClass('badge-status-new badge-status-accepted badge-status-rejected badge-status-warning badge-status-info badge-status-purple');
        var s = (status || '').toString().trim().toLowerCase();
        if (s.indexOf('accept') !== -1 || s.indexOf('approved') !== -1) {
            $badge.addClass('badge-status-accepted');
        } else if (s.indexOf('reject') !== -1) {
            $badge.addClass('badge-status-rejected');
        } else if (s.indexOf('more detail') !== -1 || s.indexOf('pending') !== -1 || s.indexOf('payment') !== -1) {
            $badge.addClass('badge-status-warning');
        } else if (s.indexOf('board') !== -1) {
            $badge.addClass('badge-status-info');
        } else if (s.indexOf('order') !== -1) {
            $badge.addClass('badge-status-purple');
        } else {
            $badge.addClass('badge-status-new');
        }
    }

    function updateActionButtonsUI(status) {
        var html = '';
        var s = (status || '').toString().trim().toLowerCase();
        applyStatusBadgeStyle(status);
        if (s === 'new' || s === 'old' || s === 'more detail' || s === 'payment done') {
            html = '<a href="javascript:void(0);" class="btn btn-outline-success waves-effect waves-light white-space-nowrap btn-sm me-2" onclick="updateStatusDirectly(\'Accepted\')"><i class="fa-solid fa-check me-1"></i> Accept</a>' +
                   '<a href="javascript:void(0);" class="btn btn-outline-warning waves-effect waves-light white-space-nowrap btn-sm me-2" onclick="updateStatusWithReason(\'More Detail\')"><i class="fa-solid fa-info-circle me-1"></i> More Detail</a>' +
                   '<a href="javascript:void(0);" class="btn btn-outline-danger waves-effect waves-light white-space-nowrap btn-sm me-2" onclick="updateStatusWithReason(\'Rejected\')"><i class="fa-solid fa-times me-1"></i> Reject</a>' +
                   '<a href="javascript:void(0);" class="btn btn-outline-secondary waves-effect waves-light white-space-nowrap btn-sm" onclick="updateStatusWithReason(\'Withdrawal Granted\')"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Withdrawal Granted</a>';
        } else if (s === 'accepted') {
            html = '<a href="javascript:void(0);" class="btn btn-outline-info waves-effect waves-light white-space-nowrap btn-sm" onclick="updateStatusDirectly(\'Refer to Board\')"><i class="fa-solid fa-gavel me-1"></i> Refer to Board</a>';
        } else if (s === 'next general board' || s === 'refer to board') {
            html = '<a href="javascript:void(0);" class="btn btn-outline-success waves-effect waves-light white-space-nowrap btn-sm me-2" onclick="updateStatusDirectly(\'Board Accept\')"><i class="fa-solid fa-check-double me-1"></i> Board Accept</a>' +
                   '<a href="javascript:void(0);" class="btn btn-outline-danger waves-effect waves-light white-space-nowrap btn-sm" onclick="updateStatusWithReason(\'Board Reject\')"><i class="fa-solid fa-ban me-1"></i> Board Reject</a>';
        } else if (s === 'board accept') {
            html = '<a href="javascript:void(0);" class="btn btn-outline-success waves-effect waves-light white-space-nowrap btn-sm me-2" onclick="triggerBoardHasApproved()"><i class="fa-solid fa-check-double me-1"></i> Board Has Approved</a>' +
                   '<a href="javascript:void(0);" class="btn btn-outline-danger waves-effect waves-light white-space-nowrap btn-sm" onclick="updateStatusWithReason(\'Board Has Rejected\')"><i class="fa-solid fa-ban me-1"></i> Board Has Rejected</a>';
        }

        $('#divActionButtons').html(html);
        if (!html || html.trim() === '') {
            $('#divActionButtons').empty().hide();
            $('#heroActionBarRow').addClass('is-hidden').hide();
        } else {
            $('#divActionButtons').show();
            $('#heroActionBarRow').removeClass('is-hidden').show();
        }
    }

    function triggerBoardHasApproved() {
        GetDcNumberList();
        // Move the #boardAccept div into the small standalone modal popup
        $('#boardAcceptOnlyModalBody').append($('#boardAccept'));
        $('#boardAccept').removeClass('hide-element').show(); // remove hide-element class (!important) and ensure it's visible

        // Show the new modal popup
        $('#boardAcceptOnlyModal').modal('show');
    }

    function updateStatusWithReason(status) {
        var title = status;
        var labelText = "Please enter reason/detail:";
        var placeholderText = "Enter details here...";
        var confirmColor = "#DD6B55";
        var confirmBtnText = "Submit";
        var iconType = "warning";

        if (status === 'Rejected' || status === 'Board Has Rejected' || status === 'Board Reject') {
            var isBoardReject = (status === 'Board Has Rejected' || status === 'Board Reject');
            title = isBoardReject ? "Board Reject" : "Reject Complaint";
            labelText = isBoardReject ? "Please enter reason for board rejection:" : "Please enter reason for rejection:";
            placeholderText = isBoardReject ? "Enter board rejection reason here..." : "Enter rejection reason here...";
            confirmBtnText = "Reject";
        } else if (status === 'More Detail') {
            title = "More Detail";
            labelText = "Please enter reason/detail:";
            placeholderText = "Enter more details here...";
            confirmColor = "#ffb822";
            confirmBtnText = "Submit";
            iconType = "info";
        } else if (status === 'Withdrawal Granted') {
            title = "Withdrawal Granted";
            labelText = "Please enter reason for withdrawal:";
            placeholderText = "Enter withdrawal reason here...";
            confirmColor = "#6c757d";
            confirmBtnText = "Submit";
            iconType = "info";
        }

        Swal.fire({
            title: title,
            html: '<p class="text-start">' + labelText + ' <span class="text-danger fw-bold">*</span></p>',
            icon: iconType,
            input: 'textarea',
            inputPlaceholder: placeholderText,
            showCancelButton: true,
            confirmButtonColor: confirmColor,
            confirmButtonText: confirmBtnText,
            cancelButtonText: "Cancel",
            customClass: {
                popup: 'swal2-reason-modal'
            },
            inputValidator: function (value) {
                if (!value || !value.trim()) {
                    return (status === 'Board Has Rejected' || status === 'Board Reject')
                        ? 'Please enter reason for board rejection is required'
                        : 'Please enter reason is required';
                }
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                var reason = result.value.trim();
                var Data = JSON.stringify({
                    NextDate: "",
                    Summary: reason,
                    ComplaintId: $("#hdfComplaintId").val(),
                    CompalintStatus: status,
                    OrderFileName: "",
                    OrderFilePath: ""
                });

                $.ajax({
                    type: 'POST',
                    url: "/Complaint/SaveComplaintStatusLog",
                    contentType: "application/json; charset=utf-8",
                    data: Data,
                    dataType: "json",
                    success: function (response) {
                        if (response.IsSuccess) {
                            Swal.fire("Success!", "Status updated successfully.", "success");
                            GetComplaintCurrentStatus();
                            GetLogList();
                        } else {
                            Swal.fire("Error!", response.Message || "Something went wrong!", "error");
                        }
                    },
                    error: function () {
                        Swal.fire('Something went wrong!', '', 'error');
                    }
                });
            }
        });
    }

    function rejectComplaint(status) {
        updateStatusWithReason(status || 'Rejected');
    }

    function updateStatusWithNote(status) {
        updateStatusWithReason(status);
    }

    function updateStatusDirectly(status) {
        if (status === 'Rejected' || status === 'Board Has Rejected' || status === 'More Detail' || status === 'Withdrawal Granted') {
            updateStatusWithReason(status);
            return;
        }

        Swal.fire({
            title: "Are you sure?",
            text: "You want to change the status to " + status + "?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes",
            cancelButtonText: "No"
        }).then((result) => {
            if (result.isConfirmed) {
                var Data = JSON.stringify({
                    ComplaintId: $("#hdfComplaintId").val(),
                    Status: status
                });

                $.ajax({
                    type: 'POST',
                    url: "/Complaint/StatusUpdate",
                    contentType: "application/json; charset=utf-8",
                    data: Data,
                    dataType: "json",
                    success: function (response) {
                        if (response.IsSuccess) {
                            Swal.fire("Success!", "Status updated successfully.", "success");
                            GetComplaintCurrentStatus();
                            GetLogList();
                        } else {
                            Swal.fire("Error!", response.Message || "Something went wrong!", "error");
                        }
                    },
                    failure: function (result) {
                        Swal.fire('Something went wrong!', '', 'error');
                    },
                    error: function (result) {
                        Swal.fire('Something went wrong!', '', 'error');
                    }
                });
            }
        });
    }

    function sendComplaintLink(dcId, mobileNumber, emailAddress) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Sending Link...',
                text: 'Please wait while sending the complaint link to ' + (emailAddress || 'member') + '...',
                allowOutsideClick: false,
                didOpen: function () {
                    Swal.showLoading();
                }
            });
        }

        $.ajax({
            type: "POST",
            url: "/Complaint/SendComplaintLinkSMS",
            data: JSON.stringify({ dcId: dcId, mobileNumber: mobileNumber, emailAddress: emailAddress || "" }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire("Sent!", response.Message, "success");
                    } else {
                        swal("Sent!", response.Message, "success");
                    }
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire("Error!", response.Message || "Something went wrong!", "error");
                    } else {
                        swal("Error!", response.Message || "Something went wrong!", "error");
                    }
                }
            },
            error: function (result) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Something went wrong!', '', 'error');
                } else {
                    swal('Something went wrong!', '', 'error');
                }
            }
        });
    }

    $(document).ready(function () {
        if (window.history && window.history.replaceState) {
            var currentPath = window.location.pathname.toLowerCase();
            if (currentPath.indexOf('/Complaint/OnlineComplaintDetail/') !== -1 ||  window.location.search.toLowerCase().indexOf('id=') !== -1) {
                window.history.replaceState(null, '', '/Complaint/OnlineComplaintDetail');
            }
        }

        updateActionButtonsUI('@ViewBag.Status');

        $('#boardAcceptOnlyModal').on('hidden.bs.modal', function () {
            // Restore #boardAccept to its original place right before #logDetails
            $('#logDetails').before($('#boardAccept'));
            $('#boardAccept').addClass('hide-element').hide(); // Re-add hide-element class and hide it since the popup closed
        });
    });
</script>
