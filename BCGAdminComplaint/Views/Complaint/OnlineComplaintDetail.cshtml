    function getStatusTheme(status) {
        var s = (status || '').toString().trim().toLowerCase();
        if (s === 'rejected' || s.indexOf('reject') !== -1) {
            return {
                markerClass: 'marker-danger',
                pillClass: 'pill-danger',
                summaryClass: 'summary-danger',
                icon: 'fa-solid fa-xmark',
                title: status || 'Rejected'
            };
        } else if (s === 'accepted' || s.indexOf('accept') !== -1) {
            return {
                markerClass: 'marker-success',
                pillClass: 'pill-success',
                summaryClass: 'summary-success',
                icon: 'fa-solid fa-check',
                title: status || 'Accepted'
            };
        } else if (s.indexOf('approved') !== -1) {
            return {
                markerClass: 'marker-success',
                pillClass: 'pill-success',
                summaryClass: 'summary-success',
                icon: 'fa-solid fa-circle-check',
                title: status || 'Approved'
            };
        } else if (s === 'more detail' || s.indexOf('detail') !== -1 || s.indexOf('query') !== -1) {
            return {
                markerClass: 'marker-warning',
                pillClass: 'pill-warning',
                summaryClass: 'summary-warning',
                icon: 'fa-solid fa-circle-question',
                title: status || 'More Detail'
            };
        } else if (s.indexOf('withdraw') !== -1) {
            return {
                markerClass: 'marker-secondary',
                pillClass: 'pill-secondary',
                summaryClass: 'summary-secondary',
                icon: 'fa-solid fa-arrow-right-from-bracket',
                title: status || 'Withdrawal Granted'
            };
        } else if (s === 'order passed' || s.indexOf('order') !== -1) {
            return {
                markerClass: 'marker-purple',
                pillClass: 'pill-purple',
                summaryClass: 'summary-purple',
                icon: 'fa-solid fa-gavel',
                title: status || 'Order Passed'
            };
        } else if (s === 'adjunt' || s.indexOf('adjourn') !== -1) {
            return {
                markerClass: 'marker-teal',
                pillClass: 'pill-teal',
                summaryClass: 'summary-teal',
                icon: 'fa-solid fa-calendar-days',
                title: status || 'Adjourned'
            };
        } else if (s === 'new') {
            return {
                markerClass: 'marker-primary',
                pillClass: 'pill-primary',
                summaryClass: 'summary-primary',
                icon: 'fa-solid fa-file-circle-plus',
                title: status || 'New'
            };
        } else if (s === 'refer to board' || s.indexOf('refer') !== -1 || s.indexOf('general board') !== -1) {
            return {
                markerClass: 'marker-info',
                pillClass: 'pill-info',
                summaryClass: 'summary-info',
                icon: 'fa-solid fa-gavel',
                title: status || 'Refer to Board'
            };
        } else if (s === 'board accept') {
            return {
                markerClass: 'marker-success',
                pillClass: 'pill-success',
                summaryClass: 'summary-success',
                icon: 'fa-solid fa-check',
                title: status || 'Board Accept'
            };
        } else if (s === 'board has approved') {
            return {
                markerClass: 'marker-success',
                pillClass: 'pill-success',
                summaryClass: 'summary-success',
                icon: 'fa-solid fa-check-double',
                title: status || 'Board Has Approved'
            };
        } else {
            return {
                markerClass: 'marker-info',
                pillClass: 'pill-info',
                summaryClass: 'summary-info',
                icon: 'fa-solid fa-circle-dot',
                title: status || 'Updated'
            };
        }
    }

    function escapeHtml(text) {
