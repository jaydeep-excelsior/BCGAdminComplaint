    function copyMemberLink(url, btn) {
        if (!url) return;
        var originalHtml = $(btn).html();
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
                $(btn).html('<i class="fa-solid fa-check text-success me-1"></i>Copied!');
                setTimeout(function () { $(btn).html(originalHtml); }, 2000);
            }).catch(function () {
                fallbackCopyText(url, btn, originalHtml);
            });
        } else {
            fallbackCopyText(url, btn, originalHtml);
        }
    }

    function fallbackCopyText(text, btn, originalHtml) {
        var textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
            document.execCommand('copy');
            $(btn).html('<i class="fa-solid fa-check text-success me-1"></i>Copied!');
            setTimeout(function () { $(btn).html(originalHtml); }, 2000);
        } catch (err) {
            prompt("Copy this URL:", text);
        }
        document.body.removeChild(textArea);
    }

