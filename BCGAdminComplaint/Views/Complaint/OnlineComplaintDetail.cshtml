
@{
    ViewBag.Title = "OnlineComplaintDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="modal fade" id="editComplainantModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Complainant Details</h5>
                <a class="btn-close btn-sm" data-bs-dismiss="modal" aria-hidden="true"></a>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label>Full Name</label>
                        <input type="text" id="txtEditFullName" class="form-control" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label>Email Address</label>
                        <input type="text" id="txtEditEmail" class="form-control" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label>Mobile No.</label>
                        <input type="text" id="txtEditContact" class="form-control" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label>Address</label>
                        <textarea id="txtEditAddress" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="saveComplainantDetails()">Update</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="uploadAffidavitModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Affidavit Copy</h5>
                <a class="btn-close btn-sm" data-bs-dismiss="modal" aria-hidden="true"></a>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label>Select File</label>
                        <input type="file" id="fileAffidavitCopy" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="saveAffidavitCopy()">Upload</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="uploadAdditionalAttachmentModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Additional Attachment</h5>
                <a class="btn-close btn-sm" data-bs-dismiss="modal" aria-hidden="true"></a>
            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="col-md-12 mb-3">
                        <label>Select File</label>
                        <input type="file" id="fileAdditionalAttachment" class="form-control" />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label>Note (નોંધ)</label>
                        <textarea id="txtAdditionalFileDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="saveAdditionalAttachment()">Upload</button>
            </div>
        </div>
    </div>
</div>
<div class="row mb-2">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-sm-0 font-size-18">Complaint Details</h4>
                <div class="page-title-left mt-1">
                    <ol class="breadcrumb m-0 font-size-13">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/Complaint/OnlineComplaintList" class="text-muted">Online Complaint Management</a></li>
                        <li class="breadcrumb-item active">Online Complaint Details</li>
                        <li class="breadcrumb-item active"><b class="comnumcolr">@ViewBag.ComplaintNumber</b></li>
                    </ol>
                </div>
            </div>
            <div class="page-title-right">
                <a href="/Complaint/Index" class="btn btn-outline-primary waves-effect waves-light white-space-nowrap btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
            </div>
        </div>
    </div>
</div>

<!-- Primary Hidden Inputs for Controller / AJAX -->
<input type="hidden" id="hdfComplaintId" value="@ViewBag.ComplaintId" />
<input type="hidden" id="hdfStatus" value="@ViewBag.Status" />

<!-- 1. Executive Top Hero Card -->
<div class="card complaint-hero-card mb-3 shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex align-items-start gap-3">
            <div class="complaint-hero-icon">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div class="flex-grow-1">
                <!-- Row 1: Complaint # on Left, Status Tag in Top Right Div -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <h4 class="mb-0 fw-bold text-dark hero-title-text me-2">#@ViewBag.ComplaintNumber</h4>
                    <div class="ms-auto">
                        <span id="txtComplaintStatus" class="complaint-status-pill">@ViewBag.Status</span>
                    </div>
                </div>

                <!-- Row 2: Meta Chips -->
                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                    <span class="hero-meta-item"><i class="fa-regular fa-calendar-check text-primary"></i> Filed: <strong class="text-dark" id="lblComplaintDateTime">@ViewBag.SCreateDate</strong></span>
                    <span class="hero-meta-item"><i class="fa-regular fa-user text-primary"></i> Complainant: <strong class="text-dark">@ViewBag.FullName</strong></span>
                    @if (ViewBag.DcNumber != null && !string.IsNullOrEmpty(ViewBag.DcNumber.ToString()) && ViewBag.DcNumber.ToString() != "0")
                    {
                        <span class="hero-meta-item"><i class="fa-solid fa-gavel text-warning"></i> DC Committee: <strong class="text-dark">@(string.IsNullOrEmpty((string)ViewBag.DcCommitteeTitle) ? ViewBag.DcNumber : ViewBag.DcCommitteeTitle)</strong></span>
                    }
                </div>

                <!-- Row 3: Buttons Start on Left Side -->
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="hero-action-toolbar">
                        <a class="hero-action-btn" id="lnkDownload" href="javascript:void(0);" onclick="chooseDownloadPdfOption()">
                            <span class="btn-icon-badge badge-pdf"><i class="fa-solid fa-file-pdf"></i></span>
                            <span>Download PDF</span>
                        </a>
                        <a href="javascript:void(0);" class="hero-action-btn" onclick="openComplainantEditModal()">
                            <span class="btn-icon-badge badge-edit"><i class="fa-solid fa-pen-to-square"></i></span>
                            <span>Edit Details</span>
                        </a>
                        <a href="javascript:void(0);" class="hero-action-btn" id="lnkManageStatus" onclick="openManageStatusModal()">
                            <span class="btn-icon-badge badge-history"><i class="fa-solid fa-clock-rotate-left"></i></span>
                            <span>Status History</span>
                        </a>
                        <a class="hero-action-btn" id="lnkShareACopy" href="javascript:void(0);">
                            <span class="btn-icon-badge badge-share"><i class="fa-solid fa-share-nodes"></i></span>
                            <span>Share with Advocate</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dynamic Status Action Buttons Row -->
        <div class="hero-action-bar-row is-hidden" id="heroActionBarRow" style="display: none;">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="hero-action-label-badge"><i class="fa-solid fa-bolt me-1 text-warning"></i> Available Actions:</span>
                <div class="d-flex flex-wrap gap-2" id="divActionButtons">
                    <!-- Buttons will be injected here via Javascript based on status -->
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-3 pb-3">
    <div class="row">
        <!-- LEFT COLUMN: Main Case Details & Files -->
        <div class="col-lg-8 col-md-12 mb-lg-0 mb-3">

            <!-- Card 1: Complainant Details -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge bg-primary-subtle text-primary">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Complainant's Details</h5>
                                <span class="text-muted font-size-12">ફરિયાદીની વિગતો</span>
                            </div>
                        </div>
                        <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm" onclick="openComplainantEditModal()"><i class="fa-solid fa-pen-to-square me-1"></i> Edit</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4 col-sm-6">
                            <div class="complainant-field-tile">
                                <div class="tile-icon-wrap"><i class="fa-regular fa-user"></i></div>
                                <div class="tile-content">
                                    <span class="tile-label">Full Name</span>
                                    <div class="tile-value" id="lblComplainantFullName">@ViewBag.FullName</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="complainant-field-tile">
                                <div class="tile-icon-wrap"><i class="fa-regular fa-envelope"></i></div>
                                <div class="tile-content">
                                    <span class="tile-label">Email Address</span>
                                    <div class="tile-value" id="lblComplainantEmail">@ViewBag.EmailAddress</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="complainant-field-tile">
                                <div class="tile-icon-wrap"><i class="fa-solid fa-phone"></i></div>
                                <div class="tile-content">
                                    <span class="tile-label">Mobile Number</span>
                                    <div class="tile-value" id="lblComplainantContact">@ViewBag.ContactNumber</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="complainant-field-tile">
                                <div class="tile-icon-wrap"><i class="fa-solid fa-location-dot"></i></div>
                                <div class="tile-content">
                                    <span class="tile-label">Residential / Postal Address</span>
                                    <div class="tile-value" id="lblComplainantAddress">@ViewBag.Address</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Details of Advocate - Complained Against -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge bg-primary-subtle text-primary">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center">
                                    Details of Advocate - Complained Against
                                    <span id="advocateCountBadge" class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 font-size-11 fw-semibold ms-2" style="display:none;"></span>
                                </h5>
                                <span class="text-muted font-size-12">જે વકીલ વિરુદ્ધ ફરિયાદ કરવામાં આવી છે તેની વિગતો</span>
                            </div>
                        </div>
                        <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openAddMemberModal()"><i class="fa-solid fa-plus me-1"></i> Add Advocate</a>
                    </div>
                    <div class="main_scroll_complaint_against answer">
                        <div class="row g-3" id="selectDetails"></div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Complaint Affidavit Copy -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge badge-red">
                                <i class="fa-solid fa-file-contract"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Complaint Affidavit Copy</h5>
                                <span class="text-muted font-size-12">ફરિયાદ સોગંદનામાની નકલ</span>
                            </div>
                        </div>
                        <div>
                            @if (ViewBag.AffidavitDocumentList != null && ViewBag.AffidavitDocumentList.Rows.Count > 0)
                            {
                                <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openAffidavitUploadModal()"><i class="fa-solid fa-pen me-1"></i> Change File</a>
                            }
                            else
                            {
                                <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openAffidavitUploadModal()"><i class="fa-solid fa-upload me-1"></i> Upload File</a>
                            }
                        </div>
                    </div>
                    <div class="main_scroll_complaint_against answer" id="dvAffidavitCopy">
                        @if (ViewBag.AffidavitDocumentList != null && ViewBag.AffidavitDocumentList.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow dr in ViewBag.AffidavitDocumentList.Rows)
                            {
                                <div class="doc-item-card">
                                    <div class="doc-info-wrap" onclick="getFile('@dr["FilePath"].ToString()')" style="cursor: pointer;">
                                        <div class="doc-icon-box">
                                            <i class="fa-solid fa-file-pdf"></i>
                                        </div>
                                        <div style="min-width: 0;">
                                            <div class="doc-name" title="@dr["FileName"].ToString()">@dr["FileName"].ToString()</div>
                                            <div class="doc-meta">
                                                <span class="badge bg-light text-secondary border font-size-11"><i class="fa-solid fa-shield-halved me-1 text-primary"></i> Verified Affidavit</span>
                                                <span>• Click to preview</span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1 shadow-none" onclick="getFile('@dr["FilePath"].ToString()')">
                                        <i class="fa-regular fa-eye"></i> View
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-doc-placeholder text-center">
                                <div class="empty-icon-circle"><i class="fa-regular fa-file-pdf"></i></div>
                                <div class="text-dark fw-semibold font-size-13">No affidavit document attached yet.</div>
                                <div class="text-muted font-size-12">Upload the verified affidavit copy for this complaint.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Card 4: Additional Attachments -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge badge-blue">
                                <i class="fa-solid fa-paperclip"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Additional Attachments</h5>
                                <span class="text-muted font-size-12">જો કોઈ વધારાના જોડાણો હોય તો</span>
                            </div>
                        </div>
                        <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openAdditionalAttachmentModal()"><i class="fa-solid fa-upload me-1"></i> Upload File</a>
                    </div>
                    <div class="main_scroll_complaint_against answer" id="dvOrderPassed">
                        @if (ViewBag.AdditionalDocumentList != null && ViewBag.AdditionalDocumentList.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow dr in ViewBag.AdditionalDocumentList.Rows)
                            {
                                <div class="attachment-card">
                                    <div class="attachment-top-row">
                                        <div class="doc-info-wrap" onclick="getFile('@dr["FilePath"].ToString()')" style="cursor: pointer;">
                                            <div class="attachment-icon-box">
                                                <i class="fa-solid fa-file-lines"></i>
                                            </div>
                                            <div style="min-width: 0;">
                                                <div class="doc-name" title="@dr["FileName"].ToString()">@dr["FileName"].ToString()</div>
                                                <div class="doc-meta">
                                                    <span class="badge bg-light text-muted border font-size-10"><i class="fa-solid fa-paperclip me-1"></i> Attachment</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="attachment-actions">
                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="getFile('@dr["FilePath"].ToString()')">
                                                <i class="fa-regular fa-eye me-1"></i> View
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-0" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;" onclick="deleteAdditionalAttachment(@dr["Id"].ToString())" title="Delete File">
                                                <i class="fa-solid fa-trash font-size-12"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dr["Description"] != null ? dr["Description"].ToString() : ""))
                                    {
                                        <div class="attachment-note-callout">
                                            <span class="attachment-note-label"><i class="fa-regular fa-comment-dots text-primary me-1"></i> Note (નોંધ)</span>
                                            <p class="attachment-note-text">@dr["Description"].ToString()</p>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-doc-placeholder text-center">
                                <div class="empty-icon-circle"><i class="fa-solid fa-paperclip"></i></div>
                                <div class="text-dark fw-semibold font-size-13">No additional attachments uploaded yet.</div>
                                <div class="text-muted font-size-12">Click "Upload File" to add supporting documents.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Card 5: Details of G B Meeting -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge badge-indigo">
                                <i class="fa-solid fa-users-rectangle"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Details of G B Meeting</h5>
                                <span class="text-muted font-size-12">સામાન્ય સભાની વિગતો</span>
                            </div>
                        </div>
                        <a href="javascript:void(0);" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openComplaintGBMeetingModal()"><i class="fa-solid fa-plus me-1"></i> Add Meeting</a>
                    </div>
                    <div class="main_scroll_complaint_against answer" id="dvGBMeetingList">
                        @if (ViewBag.ComplaintGBMeetingList != null && ViewBag.ComplaintGBMeetingList.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow dr in ViewBag.ComplaintGBMeetingList.Rows)
                            {
                                <div class="gb-meeting-card">
                                    <div class="gb-header-row">
                                        <div>
                                            <span class="gb-date-badge"><i class="fa-regular fa-calendar me-1"></i> <span class="meeting-date-content">@dr["MeetingDate"].ToString()</span></span>
                                            <h6 class="gb-title meeting-title-content">@dr["MeetingTitle"].ToString()</h6>
                                        </div>
                                        <div class="gb-actions">
                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="viewMeetingNote(this)"><i class="fa-solid fa-eye me-1"></i> View</button>
                                            <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="editGBMeetingLog('@dr["Id"].ToString()', this)"><i class="fa-solid fa-pen-to-square me-1"></i> Edit</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1 font-size-11 fw-semibold shadow-none" onclick="deleteGBMeetingLog('@dr["Id"].ToString()')"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                                        </div>
                                    </div>
                                    <div class="gb-note-box">
                                        <div class="gb-note-label"><i class="fa-regular fa-note-sticky text-indigo me-1"></i> Meeting Note (બેઠકની નોંધ)</div>
                                        <p class="gb-note-content meeting-note-content">@dr["MeetingNote"].ToString()</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-doc-placeholder text-center">
                                <div class="empty-icon-circle"><i class="fa-regular fa-calendar-xmark"></i></div>
                                <div class="text-dark fw-semibold font-size-13">No General Board meeting records added yet.</div>
                                <div class="text-muted font-size-12">Click "Add Meeting" to log an official board meeting entry.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Card 6: Details of Advocate Reply To -->
            <div class="card mb-3 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="section-icon-badge badge-teal">
                                <i class="fa-solid fa-comments"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Advocate Reply & Communications</h5>
                                <span class="text-muted font-size-12">જે વકીલ વિરુદ્ધ ફરિયાદ કરવામાં આવી છે તેનો જવાબ</span>
                            </div>
                        </div>
                    </div>
                    <div class="replaycomplaintmain_card mt-2 rounded-3" id="dvreplyData"></div>
                    <div class="reply-composer-card mt-3">
                        <div class="position-relative mb-2">
                            <textarea type="text" class="form-control reply-textarea shadow-none" id="txtReply" rows="3" placeholder="Enter reply message or note..."></textarea>
                            <div class="chat-input-links" id="tooltip-container">
                                <input type="file" id="fileLoader" name="files" title="Load File" class="d-none" onchange="ShowPreview(this,'Reply')" />
                                <input type="hidden" id="hdfReplyB64ImagePath" />
                                <input type="hidden" id="hdfReplyFileName" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center">
                                <a id="btnReplyUploadFile" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-none" onclick="openFiledialog()">
                                    <i class="fa-solid fa-paperclip me-1 text-primary"></i> Attach/Upload File
                                </a>
