    function downloadComplaintPdf(withAttachments) {
        var complaintId = $("#hdfComplaintId").val();
        if (!complaintId) {
            var pathParts = window.location.pathname.split('/');
            var lastPart = pathParts[pathParts.length - 1];
            if (!isNaN(lastPart) && parseInt(lastPart) > 0) {
                complaintId = lastPart;
            }
        }
        var Data = JSON.stringify({
            ComplaintId: complaintId
        });

        $.ajax({
            type: 'POST',
            url: "/Complaint/GetAllComplaintDetailsReportsFilterSet",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {
                if (result.data == "Success") {
                    var url = '@Url.Action("DownloadDetailReport", "Complaint")' +
                        (complaintId ? ('?id=' + encodeURIComponent(complaintId) + '&withAttachments=' + (withAttachments ? 'true' : 'false')) : ('?withAttachments=' + (withAttachments ? 'true' : 'false')));
                    location.href = url;
                } else {
                    swal('Something went wrong!', "", "error");
                }
            },
            error: function () {
                var url = '@Url.Action("DownloadDetailReport", "Complaint")' +
                    (complaintId ? ('?id=' + encodeURIComponent(complaintId) + '&withAttachments=' + (withAttachments ? 'true' : 'false')) : ('?withAttachments=' + (withAttachments ? 'true' : 'false')));
                location.href = url;
            }
        });
    }

