    function GetLogList() {
        var Data = JSON.stringify({
            ComplaintId: $("#hdfComplaintId").val()
        });
        $.ajax({
            type: 'POST',
            url: "/Complaint/GetLogList",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    $('#logDetails').empty();
                    if (!response.Data || response.Data.length === 0) {
                        $('#logDetails').html(
                            '<div class="text-center py-5">' +
                            '  <div class="mb-3 text-muted"><i class="fa-solid fa-clock-rotate-left fa-3x opacity-50"></i></div>' +
                            '  <h6 class="fw-bold text-secondary">No Status History Available</h6>' +
                            '  <p class="text-muted small mb-0">No status logs have been recorded for this complaint yet.</p>' +
                            '</div>'
                        );
                        return;
                    }
                    $.each(response.Data, function (data, value) {
                        var theme = getStatusTheme(value.Status);
                        var oldStatusHtml = '';
                        if (value.OldStatus && value.OldStatus.toString().trim() !== '') {
                            oldStatusHtml = '<span class="status-old-pill" title="Previous Status"><i class="fa-solid fa-arrow-left me-1"></i> Prev: ' + escapeHtml(value.OldStatus) + '</span>';
                        }

                        var extraContent = '';
                        if (value.Status == "Adjunt") {
                            extraContent = '<div class="status-next-date-box mt-3">' +
                                '<i class="fa-regular fa-calendar-check text-primary"></i>' +
                                '<span><strong>Next Hearing Date:</strong> ' + escapeHtml(value.SNextDate || '-') + '</span>' +
                                '</div>';
                        } else if (value.Status == "Order Passed") {
                            var FilePath = "'" + (value.OrderFilePath || '').replace(/'/g, "\\'") + "'";
                            extraContent = '<div class="mt-3">' +
                                '<a href="javascript:void(0);" class="status-doc-chip" onclick="getFile(' + FilePath + ')">' +
                                '  <i class="fa-solid fa-file-pdf text-danger fs-5"></i>' +
                                '  <span class="doc-name">' + escapeHtml(value.OrderFileName || 'Order Document') + '</span>' +
                                '  <span class="badge bg-primary-subtle text-primary ms-2"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>View</span>' +
                                '</a>' +
                                '</div>';
                        } else if (value.Status == "Board Has Approved") {
                            var dcMemberListId = 'dcMemberList_' + value.Id;
                            var hdfCommitteeIds = 'hdfCommitteeId' + value.Id;
                            var hdfComplaintIds = 'hdfComplaintid' + value.Id;
                            extraContent =
                                '<div class="dc-approved-section">' +
                                '  <div class="dc-committee-card">' +
                                '    <div class="dc-committee-card-header">' +
                                '      <div class="dc-committee-info-group">' +
                                '        <div class="dc-committee-badge-icon">' +
                                '          <i class="fa-solid fa-users-line"></i>' +
                                '        </div>' +
                                '        <div>' +
                                '          <div class="dc-committee-subtitle">Assigned Disciplinary Committee</div>' +
                                '          <div class="dc-committee-main-title">' +
                                '            <span class="dc-title-text">' + escapeHtml(value.CommitteTitle || 'Disciplinary Committee') + '</span>' +
                                '            <span class="dc-status-chip"><i class="fa-solid fa-circle-check me-1"></i>Allocated</span>' +
                                '          </div>' +
                                '        </div>' +
                                '      </div>' +
                                '      <button type="button" class="btn dc-view-members-btn" onclick="openDcMemberListView(' + value.Id + ')">' +
                                '        <i id="icon_dcMember_' + value.Id + '" class="fa-solid fa-users-viewfinder"></i>' +
                                '        <span id="btnText_dcMember_' + value.Id + '">View Members</span>' +
                                '        <i id="chevron_dcMember_' + value.Id + '" class="fa-solid fa-chevron-down transition-transform"></i>' +
                                '      </button>' +
                                '    </div>' +
                                '    <input type="hidden" id="' + hdfCommitteeIds + '" value="' + (value.CommitteeId || '') + '">' +
                                '    <input type="hidden" id="' + hdfComplaintIds + '" value="' + (value.ComplaintId || '') + '">' +
                                '    <div id="' + dcMemberListId + '" class="dc-members-container" style="display:none;"></div>' +
                                '  </div>' +
                                '</div>';
                        }

                        var st = (value.Status || '').toString().trim().toLowerCase();
                        var summaryText = (value.Summary || '').toString().trim();
                        if (!summaryText) {
                            if (st === 'new') {
                                summaryText = 'Complaint has been successfully registered in the system. It is currently under initial administrative verification and scrutiny.';
                            } else if (st === 'accepted') {
                                summaryText = 'Complaint has been scrutinized and accepted for further proceedings. The matter will be placed before the General Board for consideration.';
                            } else if (st === 'refer to board' || st === 'next general board') {
                                summaryText = "Complaint has been referred to the General Board for consideration. Awaiting the Board's review and decision in the upcoming meeting.";
                            } else if (st === 'board accept') {
                                summaryText = "The General Board has accepted the complaint. Pending formal board approval and committee allocation.";
                            } else if (st === 'board has approved') {
                                summaryText = "The General Board has formally approved the complaint. The matter has been referred to the Disciplinary Committee for conducting inquiry and hearing proceedings.";
                            }
                        }

                        var summaryHtml = '';
                        if (summaryText !== '') {
                            var isStatusNote = (st === 'new' || st === 'accepted' || st === 'refer to board' || st === 'next general board' || st === 'board accept' || st === 'board has approved');
                            var summaryLabel = isStatusNote ? 'Status Remarks' : 'Reason / Remarks';
                            summaryHtml = '<div class="status-summary-callout ' + theme.summaryClass + '">' +
                                '  <div class="status-summary-label">' +
                                '    <i class="fa-solid fa-quote-left opacity-75"></i> ' + summaryLabel +
                                '  </div>' +
                                '  <div class="status-summary-text">' + escapeHtml(summaryText) + '</div>' +
                                '</div>';
                        }

                        var itemHtml =
                            '<div class="status-timeline-item">' +
                            '  <div class="status-timeline-marker ' + theme.markerClass + '" title="' + escapeHtml(theme.title) + '">' +
                            '    <i class="' + theme.icon + '"></i>' +
                            '  </div>' +
                            '  <div class="status-timeline-card">' +
                            '    <div class="status-timeline-header">' +
                            '      <div class="status-badge-group">' +
                            '        <span class="status-pill ' + theme.pillClass + '">' +
                            '          <i class="' + theme.icon + '"></i>' + escapeHtml(value.Status) +
                            '        </span>' +
                            '        ' + oldStatusHtml +
                            '      </div>' +
                            '      <div class="status-meta">' +
                            '        <span class="status-user" title="Updated by">' +
                            '          <i class="fa-solid fa-user-shield text-primary opacity-75 me-1"></i>' + escapeHtml(value.Name || 'Admin') +
                            '        </span>' +
                            '        <span class="status-date" title="Timestamp">' +
                            '          <i class="fa-regular fa-clock text-muted me-1"></i>' + escapeHtml(value.SNextDate || '') +
                            '        </span>' +
                            '      </div>' +
                            '    </div>' +
                            '    ' + extraContent +
                            '    ' + summaryHtml +
                            '  </div>' +
                            '</div>';

                        $('#logDetails').append(itemHtml);
                    });
                }
            },
            failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

