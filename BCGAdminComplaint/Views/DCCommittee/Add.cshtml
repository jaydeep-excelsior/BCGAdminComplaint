
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="customer-list admin-users">
        
        <div class="row mb-2">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-sm-0 font-size-18">Add D.C. Committee</h4>
                        <div class="page-title-left mt-1">
                            <ol class="breadcrumb m-0 font-size-13">
                                <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/DCCommittee/Index" class="text-muted">D.C. Committee</a></li>
                                <li class="breadcrumb-item active">Add D.C. Committee</li>
                            </ol>
                        </div>
                    </div>
                    <div class="page-title-right d-flex align-items-center">
                        <a class="btn btn-sm btn-outline-primary text-nowrap" href="@Url.Action("Index", "DCCommittee")"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="add-customer">
            <div class="row">
                <div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="card border-0 redius-top mb-3">
                        <div class="card-body">
                            <div class="row mb-2">

                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12 mb-2">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="exampleFormControlInput1">
                                               Title
                                            </label>
                                            <input type="text" class="form-control" id="txtCommitteeTitle" placeholder="Enter Committee Title" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="main-details">
                                        <div class="form-group">
                                            <label for="exampleFormControlInput1">
                                                Note
                                            </label>
                                            <textarea class="form-control" id="txtNote" placeholder="Note"></textarea>

                                        </div>
                                    </div>
                                </div>
                            </div>   

                            <div class="row mb-2">

                                <div class="col-xl-6 col-lg-6 col-md-8 col-sm-12 col-12">
                                    <div class="main-details">
                                        <div class="form-group d-flex align-items-end">
                                            <div class="flex-grow-1 me-3">
                                                <label for="ddlDCMember">Member</label>
                                                @Html.DropDownList("ddlDCMember", ViewBag.DCMemberList as SelectList, "Select D.C. Member", htmlAttributes: new { @class = "form-control" })
                                            </div>
                                            <div>
                                                <a class="btn btn-outline-success waves-effect waves-light btn-sm text-nowrap" id="btnAddDCCommittee" style="margin-top: -17px;"><i class="fas fa-plus"></i> Add</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3" id="DCCommitteeTableContainer" style="display:none;">
                                    <table class="table table-bordered" id="DCCommitteeTable">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Mebmer Name</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <div class="col-12 mt-3">
                                    @if (ViewBag.IsAdd == "A")
                                    {
                                        <a class="btn btn-outline-success waves-effect waves-light btn-sm" id="lnkDCCommitteeDataSaveRecord"><i class="fas fa-save"></i> Save</a>
                                    }
                                    <a class="btn btn-outline-danger waves-effect waves-light btn-sm" id="lnkDCCommitteeDataSaveRecordCancel"><i class="fas fa-times-circle"></i> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var DCMemberDataList = [];

            // Get IP Address
            $.ajax({
                url: 'https://checkip.amazonaws.com/',
                method: 'GET'
            }).done(function (data) {
                localStorage.setItem("PCIPAddress", data.trim());
            }).fail(function () {
                localStorage.setItem("PCIPAddress", '');
            });

            // Add member to table
            $('#btnAddDCCommittee').click(function () {
                var committeeTitle = $('#txtCommitteeTitle').val().trim();
                var dcCommitteeNo = "0"; // Auto-generated in SQL
                var note = $('#txtNote').val().trim();
                var memberId = $('#ddlDCMember').val();
                var memberName = $("#ddlDCMember option:selected").text();

                if (!committeeTitle || !memberId || memberId === "Select DCMember") {
                    Swal.fire("", "Please fill all required fields.", "warning");
                    return;
                }

                DCMemberDataList.push({
                    CommitteeTitle: committeeTitle,
                    DcCommitteeNo: dcCommitteeNo,
                    Note: note,
                    MemberId: memberId,
                    MemberName: memberName
                });

                $('#DCCommitteeTable tbody').append(`
                    <tr>
                        <td>${DCMemberDataList.length}</td>
                        <td>${memberName}</td>
                        <td><button type="button" class="btn btnDelete btn-outline-danger waves-effect waves-light btn-sm"><i class="fas fa-trash"></i> Delete</button></td>
                    </tr>
                `);

                $('#DCCommitteeTableContainer').show();

                $('#ddlDCMember').val("");
            });

            // Delete entry
            $('#DCCommitteeTable').on('click', '.btnDelete', function () {
                var rowIndex = $(this).closest('tr').index();
                $(this).closest('tr').remove();
                DCMemberDataList.splice(rowIndex, 1);
                if (DCMemberDataList.length === 0) {
                    $('#DCCommitteeTableContainer').hide();
                }
            });

            // Cancel
            $('#lnkDCCommitteeDataSaveRecordCancel').click(function () {
                location.reload();
            });

            // Save record to server
            $('#lnkDCCommitteeDataSaveRecord').click(function () {
                if (DCMemberDataList.length === 0) {
                    Swal.fire("", "Please add at least one member before saving.", "warning");
                    return;
                }

                var member = DCMemberDataList[0];
                var formData = new FormData();
                formData.append("Id", 0);
                formData.append("CommitteeTitle", member.CommitteeTitle);
                formData.append("DcCommitteeNo", member.DcCommitteeNo);
                formData.append("Note", member.Note);
                formData.append("DC_ComplaintId", 0);
                
                $.each(DCMemberDataList, function (i, m) {
                    formData.append("MemberIds[" + i + "]", m.MemberId);
                });

                $.ajax({
                    url: "/DCCommittee/DCCommitteeMembersInserts",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        if (result && result.data) {
                            if (result.data === "OK" || result.data === "IN") {
                                Swal.fire({
                                    title: "Good Job!",
                                    text: "Record saved successfully.",
                                    icon: "success",
                                    confirmButtonColor: '#28a745',
                                    confirmButtonText: 'OK'
                                }).then(function () {
                                    window.location.href = '/DCCommittee/Index';
                                });
                            } else if (result.data === "EX") {
                                Swal.fire("", "Record already exists.", "warning");
                            } else {
                                Swal.fire("", "Oops! Something went wrong.", "warning");
                            }
                        } else {
                            Swal.fire("", "Oops! Something went wrong.", "warning");
                        }
                    },
                    error: function () {
                        Swal.fire("", "Server error. Please try again.", "error");
                    }
                });
            });
        });
    </script>
}
