                <div class="description">@ViewBag.ContactNumber</div>
            </div>
            <div class="col-md-8 col-sm-6 col-12 mt-3">
                <div class="title">Address</div>
                <div class="description">@ViewBag.Address</div>
            </div>
            <div class="col-md-4 col-sm-6 col-12 mt-3">
                <div class="title">Status</div>
                <div class="description">@ViewBag.Status</div>
            </div>

        </div>
    </div>
</div>
