                        <li class="breadcrumb-item"><a href="/MemberComplaintList/Index" class="text-muted">Member Complaint Management</a></li>
                        <li class="breadcrumb-item active">Member Complaint Details</li>
                    </ol>
                </div>
            </div>
            <div class="page-title-right">
                <a href="/MemberComplaintList/Index" class="btn btn-outline-primary waves-effect waves-light white-space-nowrap btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
