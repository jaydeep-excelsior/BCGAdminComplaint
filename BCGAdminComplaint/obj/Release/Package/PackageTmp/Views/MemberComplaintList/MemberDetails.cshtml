<div class="main_card_list">
    <label id="ComplaintId" hidden>@ViewBag.ComplaintId</label>
    <label id="hdfStatus" hidden>@ViewBag.Status</label>
    <div class="main_header_card">
        <h5 class="mb-0">Personal Details</h5>
    </div>
    <div class="main_card_list_body">
        <label id="ComplaintId" hidden>@ViewBag.ComplaintId</label>
        <label id="hdfStatus" hidden>@ViewBag.Status</label>
        <div class="row">
            <div class="col-md-4 col-sm-6 col-12 mt-3">
                <div class="title">Full Name</div>
                <div class="description">@ViewBag.FullName</div>
            </div>
            <div class="col-md-4 col-sm-6 col-12 mt-3">
                <div class="title">Email</div>
                <div class="description">@ViewBag.EmailAddress</div>
            </div>
            <div class="col-md-4 col-sm-6 col-12 mt-3">
