<script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>

<script>

    $(document).ready(function () {
        GetLogList();
        GetMemberNoteList();
        GetStatusLogDetails();
    });

    function GetLogList() {
        $.ajax({
            type: 'POST',
            url: "/MemberComplaintList/GetLogList",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                if (response.IsSuccess) {
                    $('#logDetails').empty();
                    $.each(response.Data, function (data, value) {

                        var FilePath = "'" + value.OrderFilePath + "'";

                        if (value.Status == "Adjunt") {
                            $('#logDetails').append(
                            '<div class="main_card_list main_card_list_border main_card_list_border_log"><div class="main_header_card"><div class="rigth_side"><div class="user_name_new">' + value.Name + '</div><div class="date_update">08 NOV, 2023 | 8:00 PM</div></div><div class="_left_side"><div class="complaint_number paymentstatuspaid"><div class="title">Current Status</div><a class="description">New</a></div><div class="complaint_number old_status me-0"><div class="title">Old Status</div><a class="description">Accepted</a></div></div></div><div class="main_card_list_body"><div class="row"><div class="col-md-12 mt-2"><div class="title">Next Date</div><div class="file_name_btn next_date_btn"><div class="name">' + value.SNextDate + '</div></div></div><div class="col-md-12 mt-3"><div class="title">Summary</div><div class="description">' + value.Summary + '</div></div></div></div></div>'
                            );
                        }

                        if (value.Status == "Order Passed") {
                            $('#logDetails').append(
                            '<div class="main_card_list main_card_list_border main_card_list_border_log"><div class="main_header_card"><div class="rigth_side"><div class="user_name_new">' + value.Name + '</div><div class="date_update">' + value.SNextDate + '</div></div><div class="_left_side"><div class="complaint_number paymentstatuspaid"><div class="title">Current Status</div><a class="description">New</a></div><div class="complaint_number old_status me-0"><div class="title">Old Status</div><a class="description">Accepted</a></div></div></div><div class="main_card_list_body"><div class="row"><div class="col-md-12 mt-2"><div class="title">File Name</div><div class="file_name_btn" onclick="getFile(' + FilePath + ')"><div class="name">' + value.OrderFileName + '</div><div class="view_file"><i class="las la-eye"></i></div></div></div><div class="col-md-12 mt-3"><div class="title">Summary</div><div class="description">' + value.Summary + '</div></div></div></div></div>'
                            );
                        }
                        if (value.Status == "Board Has Approved") {

                            $('#logDetails').append(
                            '<div class="main_card_list main_card_list_border main_card_list_border_log"><div class="main_header_card"><div class="rigth_side"><div class="user_name_new">' + value.Name + '</div><div class="date_update">' + value.SNextDate + '</div></div><div class="_left_side"><div class="complaint_number paymentstatuspaid"><div class="title">Current Status</div><a class="description">New</a></div><div class="complaint_number old_status me-0"><div class="title">Old Status</div><a class="description">Accepted</a></div></div></div><div class="main_card_list_body"><div class="row"><div class="col-md-12 mt-3"><div class="title">Dc Title</div><div class="description">' + 'Assign Committee - ' + value.CommitteTitle + '</div></div></div></div></div>'
                            );
                        }
                    })
                }
                else {

                }
            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

    $('#lnkAdd').on('click', function () {

        if ($('#txtNote').val() == "") {
            swal("Please enter note", "", "error");
            return;
        }

        var noteTypeChecked = $('input[name=Note]:checked').val();

        if (noteTypeChecked == undefined) {
            swal("Please Select Note Type", "", "error");
            return;
        }

        var Data = JSON.stringify({
            NoteType: $('input[name=Note]:checked').val(),
            Note: $('#txtNote').val(),
            ComplaintId: $('#ComplaintId').text()
        });

        $.ajax({
            type: 'POST',
            url: "/MemberComplaintList/SaveMemberNote",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    $("#txtNote").val('');
                    $('input[name="Note"]').prop('checked', false);
                    swal("Note save successfully", "", "success");
                    GetMemberNoteList();
                }
                else {
                    // swal("Data already exists", "", "error");
                }
            }
        });
    });

    function GetMemberNoteList() {
        $.ajax({
            type: 'POST',
            url: "/MemberComplaintList/GetMemberNoteList",
            data: JSON.stringify({ ComplaintId: $('#ComplaintId').text() }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#NoteList").empty();
                if (response.IsSuccess) {
                    $.each(response.Data, function (data, value) {

                        if (value.NoteType == "P") {
                            var noteType = "Private";
                        }
                        else {
                            var noteType = "General";
                        }

                        $("#NoteList").append(
                            '<div class="main_card_list main_card_list_border main_card_list_border_log"><div class="main_header_card"><div class="rigth_side"><div class="user_name_new">' + value.MemberName + '</div><div class="date_update">' + value.SCreateDate + '</div></div><div class="_left_side"><div class="complaint_number old_status note_type me-0"><div class="title">Note Type</div><a class="description">' + noteType + '</a></div></div></div><div class="main_card_list_body"><div class="row"><div class="col-md-12 mt-3"><div class="title">Note</div><div class="description">' + value.Note + '</div></div></div></div></div>'
                            // '<label>' + value.SrNo + '</label><br/>'
                            //+ '<label style="text-align:center;display:none;">' + value.Id + '</label>'
                            //+ '<label style="text-align:center;display:none;">' + value.MemberId + '</label>'
                            //+ '<label><b> Name : </b>' + value.MemberName + '</label><br/>'
                            //+ '<label><b> NoteType : </b>' + noteType + '</label><br/>'
                            //+ '<label><b> Note : </b>' + value.Note + '</label><br/>'
                            //+ '<label><b> CreateDate : </b>' + value.SCreateDate + '</label><br/>'
                            )
                    });
                }
                else {
                    //complaintList.append('No Data Found');
                }

            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

    function GetStatusLogDetails() {

        var status = $("#hdfStatus").text();

        var Data = JSON.stringify({
            ComplaintId: $("#ComplaintId").text(),
            Status: status,
            CommitteeId: $('#hdfCommitteeId').val()
        });
        if (status == "Adjunt") {
            $('#adjuntDetails').css('display', 'block');
        }
        else if (status == "Order Passed") {
            $('#OrderPassed').css('display', 'block');
        }
        else if (status == "Board Has Approved") {
            $('#boardAccept').css('display', 'block');
        }

        $.ajax({
            type: 'POST',
            url: "/ComplaintDetails/GetLogDetails",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    if (status == "Adjunt") {
                        $.each(response.Data, function (data, value) {
                            $("#txtNextDate").val(value.SNextDate);
                            $("#txtSummary").val(value.Summary);
                        });
                    }
                    else if (status == "Order Passed") {
                        $.each(response.Data, function (data, value) {
                            $("#lblLastUploadFile").text(value.OrderFileName);
                            $("#txtOrderSummary").val(value.Summary);
                        });
                    }
                    else if (status == "Board Has Approved") {
                        $('#tbldcDetails tbody').empty();
                        var dcDetails = $('#tbldcDetails tbody');

                        $.each(response.Data, function (data, value) {
                            $('#drpDcNo option[value="' + hdfCommitteeId.value + '"]').attr("selected", "selected");
                            dcDetails.append(
                                 '<tr>'
                                 + '<td><input type="checkbox" name="dcCheck" value="' + value.MemberId + '" checked/></td>'
                                 + '<td>' + value.SrNo + '</td>'
                                 + '<td style="text-align:center;display:none;">' + value.MemberId + '</td>'
                                 + '<td>' + value.EnroNumber + '</td>'
                                 + '<td>' + value.FullName + '</td>'
                                 + '<td>' + value.ContactNumber + '</td>'
                                 + '</tr>')
                        });
                    }
                }
                else {

                }
            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

    function getFile(filepath) {
        $("#mainTab").removeClass();
        $("#mainTab").addClass("col-md-6");
        $("#documentTab").addClass("col-md-6");
        $("#documentTab").css("display", "block");
        if (filepath != "") {
            $('#displayPdf').attr('src', filepath);
        }
    }

    $('#btnClose').on('click', function () {
        $("#documentTab").removeClass();
        $("#mainTab").addClass("col-md-12");
        $("#documentTab").css("display", "none");
    });

    $("#mainaddnotsform").hide();

    $('#addnotes').click(function () {

      
        $("#mainaddnotsform").slideToggle();
       
    });

    
</script>
