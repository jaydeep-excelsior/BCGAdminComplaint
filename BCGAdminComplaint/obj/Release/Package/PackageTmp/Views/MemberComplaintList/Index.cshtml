<script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>

<script>

    var baseFilter = {
        pageNo: 1,
        pageSize: 10,
        sortColumn: 1,
        sortOrder: 'desc',
        searchValue: ''
    };

    $(document).ready(function () {
        GetComplaintList();

    });

    function GetComplaintList() {

        var Data = JSON.stringify({
            baseFilter,
            MemberId: $('#memberId').val(),
        });


        $.ajax({
            type: 'POST',
            url: "/MemberComplaintList/GetMemberComplaintList",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#tblComplaintList").empty();
                var complaintList = $("#tblComplaintList");

                if (response.IsSuccess) {
                    $.each(response.Data, function (data, value) {

                        complaintList.append(
                            '<div class="main_card_list"><div class="main_header_card"><div class="_left_side"><div class="number">' + value.SrNo + '</div><div class="complaint_number"><div class="title">Complaint Number</div><a class="description"  href="/MemberComplaintList/MemberDetails/' + value.Id + '">' + value.ComplaintNumber + '</a></div></div><div class="rigth_side"></div></div><div class="main_card_list_body"><div class="row"><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Full Name</div><div class="description">' + value.FullName + '</div></div><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Email</div><div class="description">' + value.EmailAddress + '</div></div><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Contact Number</div><div class="description">' + value.ContactNumber + '</div></div><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Summary</div><div class="description">' + value.Summary + '</div></div><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Detail Complaint</div><div class="description">' + value.DetailComplaint + '</div></div><div class="col-md-4 col-sm-6 col-12 mt-3"><div class="title">Status</div><div class="description">' + value.Status + '</div></div></div></div></div>'
                            )
                    });
                }
                else {
                    complaintList.append('No Data Found');
                }

            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }


</script>