
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="customer-list admin-users">
    <div class="row mb-2">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <div>
                    <h4 class="mb-sm-0 font-size-18">Edit D.C. Committee</h4>
                    <div class="page-title-left mt-1">
                        <ol class="breadcrumb m-0 font-size-13">
                            <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="/DCCommittee/Index" class="text-muted">D.C. Committee</a></li>
                            <li class="breadcrumb-item active">Edit D.C. Committee</li>
                        </ol>
                    </div>
                </div>
                <div class="page-title-right d-flex align-items-center">
                    <a class="btn btn-sm btn-outline-primary text-nowrap" href="@Url.Action("Index", "DCCommittee")"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
                </div>
            </div>
        </div>
    </div>
    <div class="add-customer">
        <div class="row">
            <div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="card border-0 redius-top mb-3">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12 mb-2">
                                <div class="main-details">
                                    <div class="form-group">
                                        <label for="exampleFormControlInput1">
                                            Title
                                        </label>
                                        <input type="text" class="form-control" id="txtCommitteeTitle" placeholder="Enter CommitteeTitle" />
                                    </div>
                                </div>
                            </div>


                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2">
                                <div class="main-details">
                                    <div class="form-group">
                                        <label for="exampleFormControlInput1">
                                            Note
                                        </label>
                                        <textarea class="form-control" id="txtNote" placeholder="Note"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-2">

                            <div class="col-xl-6 col-lg-6 col-md-8 col-sm-12 col-12">
                                <div class="main-details">
                                    <div class="form-group">
                                        <label for="ddlDCMember">Member</label>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1 me-2">
                                                @Html.DropDownList("ddlDCMember", ViewBag.DCMemberList as SelectList, "Select D.C. Member", htmlAttributes: new { @class = "form-control select2", id = "ddlDCMember" })
                                            </div>
                                            <div>
                                                <a class="btn btn-outline-success waves-effect waves-light btn-sm text-nowrap" id="btnAddDCCommittee" style="height: 38px; display: inline-flex; align-items: center;"><i class="fas fa-plus me-1"></i> Add</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <table class="table table-bordered" id="DCCommitteeTable">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Member Name</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-12">
                                <input type="hidden" id="hdfEditDCCommitteeId" value="0" />
                                @if (ViewBag.IsUpdate == "A")
                                {
                                    <a class="btn btn-outline-success waves-effect waves-light btn-sm" id="lnkDCCommitteeDataSaveRecord"><i class="fas fa-save"></i> Save</a>
                                }
                                <a class="btn btn-outline-danger waves-effect waves-light btn-sm" id="lnkDCCommitteeDataSaveRecordCancel"><i class="fas fa-times-circle"></i> Cancel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        function initializeSelect2() {
            if (typeof $.fn.select2 !== 'undefined') {
                $('#ddlDCMember').select2({
                    placeholder: "Select D.C. Member",
                    allowClear: true,
                    width: '100%'
                });
            }
        }

        $(document).ready(function () {
            // Initialize Select2 Searchable Dropdown
            initializeSelect2();

            // Load data for editing
            GetRecordDetail();

            // Add member button click
            $('#btnAddDCCommittee').click(function () {
                var memberId = $("#ddlDCMember").val();
                var memberName = $('#ddlDCMember option:selected').text();

                if (!memberId || memberId === "" || memberId === "0" || memberId === "Select DCMember" || memberId === "Select D.C. Member") {
                    swal("", "Please select a D.C. Member.", "warning");
                    return;
                }

                // Check if already exists
                var exists = false;
                $("#DCCommitteeTable tbody tr").each(function () {
                    var existingId = $(this).find(".btnRemoveMember").data("id");
                    if (parseInt(existingId) === parseInt(memberId)) {
                        exists = true;
                        return false;
                    }
                });

                if (exists) {
                    swal("", "This member is already added.", "warning");
                    return;
                }

                var newRow = `
                    <tr>
                        <td>${$("#DCCommitteeTable tbody tr").length + 1}</td>
                        <td>${memberName}</td>
                        <td><a href="#" class="btn btnRemoveMember btn-outline-danger waves-effect waves-light btn-sm" data-id="${memberId}"><i class="fas fa-trash"></i> Remove</a></td>
                    </tr>
                `;

                $("#DCCommitteeTable tbody").append(newRow);
                $('#ddlDCMember').val("").trigger('change');
            });

            // Remove member (delegated)
            $(document).on("click", ".btnRemoveMember", function (e) {
                e.preventDefault();
                $(this).closest("tr").remove();

                // Reorder numbering
                $("#DCCommitteeTable tbody tr").each(function (i) {
                    $(this).find("td:first").text(i + 1);
                });


            });

            // Cancel button reloads data
            $('#lnkDCCommitteeDataSaveRecordCancel').click(function () {
                GetRecordDetail();
            });

            // Save button click
            $('#lnkDCCommitteeDataSaveRecord').click(function () {
                var VDCCommitteeId = $("#hdfEditDCCommitteeId").val() || '0';

                if ($("#txtCommitteeTitle").val().trim() === "") {
                    swal("", "Please enter Committee Title.", "warning");
                    return;
                }


                // Collect all member IDs
                var memberIds = [];
                $("#DCCommitteeTable tbody tr").each(function () {
                    var memberId = $(this).find(".btnRemoveMember").data("id");
                    if (memberId) {
                        memberIds.push(parseInt(memberId));
                    }
                });

                if (memberIds.length === 0) {
                    swal("", "Please add at least one DC Member.", "warning");
                    return;
                }

                var data = {
                    Id: parseInt(VDCCommitteeId),
                    CommitteeTitle: $("#txtCommitteeTitle").val().trim(),
                    DcCommitteeNo: 0,
                    Note: $("#txtNote").val().trim(),
                    DC_ComplaintId: 0,
                    MemberIds: memberIds
                };

                DCCommitteeDataSubmitRecord(data);
            });
        });

        function GetRecordDetail() {
            var VEditDCCommitteeDataId = localStorage.getItem("EditDCCommitteeId") || '0';

            $.ajax({
                type: "POST",
                url: "/DCCommittee/DCCommitteeMembersDataEdit",
                data: { id: VEditDCCommitteeDataId },
                success: DCCommitteeDataEditOnSuccess,
                error: function () {
                    swal("", "Error loading record details.", "error");
                }
            });
        }

        function DCCommitteeDataEditOnSuccess(response) {
            if (response && response.success) {
                var mainData = response.mainData;
                var attachmentData = response.attachmentData;

                if (mainData && mainData.length > 0) {
                    var row = mainData[0];

                    $("#hdfEditDCCommitteeId").val(row.Id || 0);
                    $("#txtCommitteeTitle").val(row.CommitteeTitle || "");

                    $("#txtNote").val(row.Note || "");


                    var selectedMemberName = row.MemberName || "";

                    if (row.MemberId) {
                        $("#ddlDCMember").val(row.MemberId).trigger('change');
                    } else {
                        $("#ddlDCMember").val("").trigger('change');
                    }

                    // Fill table with members from attachmentData
                    if (attachmentData && attachmentData.length > 0) {
                        BindMembersTable(attachmentData);
                    }

                } else {
                    ResetForm();
                }
            } else {
                ResetForm();
            }
        }

        function BindMembersTable(members) {
            var tbody = $("#DCCommitteeTable tbody");
            tbody.empty();
            $.each(members, function (i, member) {
                tbody.append(`
                    <tr>
                        <td>${i + 1}</td>
                        <td>${member.MemberName || $("#ddlDCMember option[value='" + member.MemberId + "']").text() || "Unknown"}</td>
                        <td><a href="#" class="btn btnRemoveMember btn-outline-danger waves-effect waves-light btn-sm" data-id="${member.MemberId}"><i class="fas fa-trash"></i> Remove</a></td>
                    </tr>
                `);
            });
        }

        function ResetForm() {
            $("#hdfEditDCCommitteeId").val('0');
            $("#txtCommitteeTitle").val("");
            $("#txtDcCommitteeNo").val("");
            $("#txtNote").val("");
            $("#ddlDCMember").val("").trigger('change');
            $("#DCCommitteeTable tbody").empty();
        }

        function DCCommitteeDataSubmitRecord(data) {
            $.ajax({
                type: 'POST',
                url: "/DCCommittee/DCCommitteeMembersInserts",
                data: data,
                traditional: true,
                success: function (result) {
                    if (result && result.data) {
                        if (result.data === "OK") {
                            swal({
                                title: "Good Job!",
                                text: data.Id > 0 ? "Record updated successfully." : "Record saved successfully.",
                                icon: "success"
                            }).then(function () {
                                localStorage.removeItem("EditDCCommitteeId");
                                window.location.href = '/DCCommittee/Index';
                            });
                        } else if (result.data === "EX") {
                            swal("", "Record already exists.", "warning");
                        } else {
                            swal("", "Oops! Something went wrong.", "warning");
                        }
                    } else {
                        swal("", "Oops! Something went wrong.", "warning");
                    }
                },
                error: function () {
                    swal("", "Oops! Something went wrong.", "warning");
                }
            });
        }
    </script>
}
