@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div>
    <div class="row mb-3">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <div>
                    <h4 class="mb-sm-0 font-size-18"> DC Committee List</h4>
                    <div class="page-title-left mt-1">
                        <ol class="breadcrumb m-0 font-size-13">
                            <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                            <li class="breadcrumb-item active"> DC Committee List</li>
                        </ol>
                    </div>
                </div>
                <div class="page-title-right d-flex align-items-center">
                    <div class="input-group input-group-sm me-2">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input id="txtRecordSearch" class="form-control quicksearchcomplaintmanagement" placeholder="Quick Search">
                    </div>
                    <a href="/DCCommittee/Add" class="btn btn-sm btn-outline-primary me-2 text-nowrap"><i class="fa-solid fa-plus me-1"></i> Add New</a>
                    <a class="btn btn-sm btn-outline-primary text-nowrap" id="addfilter"><i class="fa-solid fa-filter me-1"></i> Filter</a>
                </div>
            </div>
        </div>
    </div>
    <div class="card main_filter_box" style="display:none;">
        <div class="card-body">
            <div class="row ">
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label>Record Status</label>
                    <select id="ddlDCCommitteeMemberDataRecordStatus" class="form-control" aria-label="Default select example">
                        <option selected value="">Select Status</option>
                        <option value="A">Active</option>
                        <option value="D">Inactive</option>
                    </select>
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label> From Date:</label>
                    <input name="txtFromDate" id="txtDCCommitteeMemberDataFromDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label> To Date:</label>
                    <input name="txtToDate" id="txtDCCommitteeMemberDataToDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-12 mt-3">
                    <div>
                        <a id="lnkDCCommitteeMemberDataSearch" class="btn-sm btn btn-outline-primary waves-effect waves-light btn-sm"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</a>
                        <a id="lnkDCCommitteeMemberDataSearchCancel" class="btn btn-outline-danger waves-effect m-l-5 btn-sm close_filterdiv btn-sm"><i class="fa-solid fa-xmark me-1"></i> Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card border-0">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <table id="tblDCCommitteeMemberDataList" class="table table-bordered dt-responsive nowrap w-100">
                                <thead>
                                    <tr>
                                        <th class="text-center">#</th>
                                        <th>Title</th>
                                        <th>Note</th>
                                        <th class="text-center">Members</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Create By & Date Time</th>
                                        <th class="text-center">Last Modify By & Date Time</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-1 justify-content-md-start justify-content-center d-flex mb-md-0 mb-4">
                            <select class="form-select totalpageshowselect" aria-label="Default select example" id="ddlDCCommitteeMemberDatarecordsize">
                                <option selected value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="250">250</option>
                                <option value="500">500</option>
                            </select>
                        </div>
                        <div class="col-md-11">
                            <nav aria-label="...">
                                <ul class="pagination justify-content-md-end justify-content-center" id="MyPager"></ul>
                            </nav>
                            <input id="hdfPageNumber" type="hidden" value="1" />
                            <input id="hdfLatPageNumber" type="hidden" value="0" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Members Modal -->
<div class="modal fade" id="membersModal" tabindex="-1" aria-labelledby="membersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="membersModalLabel"><i class="fa-solid fa-users me-2"></i>Committee Members</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="membersModalBody">
                <div class="text-center">Loading...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('.main_filter_box').hide();
        GetRecordList();   // default ? ByNewest

        // ?? Search input
        $("[id=txtRecordSearch]").on('change keyup', function () {
            $("#hdfPageNumber").val(1);
            GetRecordList('ByNewest');
        });

        $('body').on('click', 'a.page', function () {
            $("#hdfPageNumber").val($(this).attr('page'));
            GetRecordList();
        });
    });

    $('#addfilter').click(function () {
        $(".main_filter_box").slideToggle();
    });

    $('.close_filterdiv').click(function () {
        $(".main_filter_box").slideUp();
    });

    // ?? Search button click
    $('#lnkDCCommitteeMemberDataSearch').click(function () {
        GetRecordList('ByNewest');
    });

    // ?? Record size dropdown
    $('#ddlDCCommitteeMemberDatarecordsize').on('change', function () {
        GetRecordList('ByNewest');
    });

    // ?? Cancel Filter
    $('#lnkDCCommitteeMemberDataSearchCancel').click(function () {
        $('#ddlDCCommitteeMemberDataRecordStatus').val('');
        $('#txtDCCommitteeMemberDataFromDate').val('');
        $('#txtDCCommitteeMemberDataToDate').val('');
        $('#hdfPageNumber').val(1);
        GetRecordList('ByNewest');
    });

    // ?? Pagination
    $('body').on('click', 'a.page', function () {
        let page = $(this).attr('page');
        $("#hdfPageNumber").val(page);
        GetRecordList();  // SortBy defaults to "ByNewest"
    });

    // ?? Filter toggle
    $('.filtershow').click(function () {
        $('.main_filter_box').slideToggle();
    });

    function GetRecordList(SortBy) {

        $('#loader_bcg').css('display', 'block');

        var SearchTitle = $("#txtRecordSearch").val();
        var FromDate = $("#txtDCCommitteeMemberDataFromDate").val();
        var ToDate = $("#txtDCCommitteeMemberDataToDate").val();
        var Status = $("#ddlDCCommitteeMemberDataRecordStatus option:selected").val();
        var RecordSize = $("#ddlDCCommitteeMemberDatarecordsize option:selected").val();
        var PageNo = $("#hdfPageNumber").val();

        var VSortBy = (SortBy == null || SortBy === '') ? 'ByNewest' : SortBy;

        var data = {
            Id: '0',
            SearchValue: SearchTitle,
            FromDate: FromDate,
            ToDate: ToDate,
            RecordStatus: Status,
            PageSize: RecordSize,
            PageNo: PageNo,
            SortBy: VSortBy
        };

        $.ajax({
            type: "POST",
            url: "/DCCommittee/DCCommitteeLists",
            data: data,
            dataType: "json",

            success: function (response) {

                if (!response) {
                    console.error("? ERROR: Response is null or undefined");
                }

                if (!response.data) {
                    console.error("? ERROR: response.data is missing");
                }

                DCCommitteeMemberDataOnSuccess(response);
            },

            error: function (xhr, status, error) {
                console.error("?? AJAX ERROR");
                console.error("Status:", status);
                console.error("Error:", error);
                console.error("XHR:", xhr.responseText);
            },

            complete: function () {
                $('#loader_bcg').css('display', 'none');
            }
        });
    }

    function DCCommitteeMemberDataOnSuccess(response) {

        var row = response.data;
        $('#tblDCCommitteeMemberDataList tbody').empty();

        if (row && row.length > 0) {

            var VTotalRecord = 0;
            var VRecordSize = $("#ddlDCCommitteeMemberDatarecordsize option:selected").val();
            var VDisplayRecordCount = parseInt(VRecordSize) || 25;

            $.each(response.data, function (i, row) {

                VTotalRecord = parseInt(row.TotalRecord) || 0;

                var VEditRights = row.EditRights;
                var VDeleteRights = row.DeleteRights;
                var VActive = row.Flag;

                var VStatusButton = '';
                var VDeleteButton = '';
                var VEditButton = '';

                // STATUS + ACTIVATE / INACTIVATE BUTTONS
                if (VDeleteRights === 'A') {
                    if (VActive === 'A') {
                        VStatusButton = '<span class="badge bg-success">Active</span>';
                        VDeleteButton =
                            '<a class="btn mr-2 btn-outline-danger actionbutton waves-effect waves-light btn-sm" ' +
                            'title="Inactivate Record" onclick="DCCommitteeMemberDataInActiveStatus(' + row.Id + ')">' +
                            '<i class="fa-solid fa-trash custom-icon"></i></a>';
                    } else {
                        VStatusButton = '<span class="badge bg-danger">Inactive</span>';
                        VDeleteButton =
                            '<a class="btn mr-2 btn-outline-success actionbutton waves-effect waves-light btn-sm" ' +
                            'title="Activate Record" onclick="DCCommitteeMemberDataActiveStatus(' + row.Id + ')">' +
                            '<i class="fa-solid fa-check custom-icon"></i></a>';
                    }
                }

                // EDIT BUTTON
                if (VEditRights === 'A') {
                    VEditButton =
                        '<a class="btn mr-2 me-1 btn-outline-primary actionbutton waves-effect waves-light btn-sm" ' +
                        'title="Edit Record" onclick="EditDCCommitteeMemberDataTypeRecord(' + row.Id + ')">' +
                        '<i class="fa-solid fa-pencil custom-icon"></i></a>';
                }

                // BUILD ROW
                var RowItemDetail =
                    '<tr>' +
                    '<td class="text-center">' + (row.SrNo || '') + '</td>' +
                    '<td>' + (row.CommitteeTitle || '') + '</td>' +
                    '<td>' + (row.Note || '') + '</td>' +
                    '<td class="text-center"><a class="btn btn-sm btn-outline-info waves-effect waves-light" onclick="viewCommitteeMembers(' + row.Id + ')" title="View Members"><i class="fa-solid fa-users me-1"></i>' + (row.TotalMember || 0) + '</a></td>' +
                    '<td class="text-center">' + VStatusButton + '</td>' +
                    '<td class="text-center">' + row.CreateBy + '<br/>' + row.SCreateDate + ' ' + row.SCreateTime + '</td>' +
                    '<td class="text-center">' + row.LastModifyBy + '<br/>' + row.LastModifyDate + ' ' + row.LastModifyTime + '</td>' +
                    '<td class="text-center">' + VEditButton + VDeleteButton + '</td>' +
                    '</tr>';

                $('#tblDCCommitteeMemberDataList tbody').append(RowItemDetail);
            });

            // PAGER
            RenderPagination(VTotalRecord, VDisplayRecordCount);

        } else {

            // NO RECORDS
            $('#tblDCCommitteeMemberDataList tbody').append(
                '<tr><td colspan="9" class="text-center">No records found.</td></tr>'
            );

            $("#MyPager").empty();
        }
    }

    function RenderPagination(totalRecords, pageSize) {
        var pageNo = parseInt($("#hdfPageNumber").val()) || 1;
        var totalPages = Math.ceil(totalRecords / pageSize);
        var paginationHtml = '';
        $("#MyPager").empty();

        if (totalPages > 1) {
            var prevDisabled = pageNo <= 1 ? 'disabled' : '';
            var prevPage = pageNo > 1 ? pageNo - 1 : 1;
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link page" href="javascript:void(0);" page="' + prevPage + '"><i class="fas fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, pageNo - 2);
            var endPage = Math.min(totalPages, pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link page" href="javascript:void(0);" page="' + i + '">' + i + '</a></li>';
            }

            var nextDisabled = pageNo >= totalPages ? 'disabled' : '';
            var nextPage = pageNo < totalPages ? pageNo + 1 : totalPages;
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link page" href="javascript:void(0);" page="' + nextPage + '"><i class="fas fa-chevron-right"></i></a></li>';
        }

        $("#MyPager").html(paginationHtml);
    }




    function EditDCCommitteeMemberDataTypeRecord(EditRecordId) {
        localStorage.setItem("EditDCCommitteeId", EditRecordId);
        var url = '/DCCommittee/Edit';
        location.href = url;
    }

    function DCCommitteeMemberDataPageClick(PageNumber) {
        $("#hdfPageNumber").val(PageNumber);
        GetRecordList();
    }

    $('#ddlDCCommitteeMemberDatarecordsize').on('change', function () {
        GetRecordList();
    });

    function DCCommitteeMemberDataPreviousPageClick() {
        var CurrentPageNo = parseInt($("#hdfPageNumber").val() == null ? '1' : $("#hdfPageNumber").val() == '' ? '1' : $("#hdfPageNumber").val());
        var LastPageNo = parseInt($("#hdfLatPageNumber").val() == null ? '1' : $("#hdfLatPageNumber").val() == '' ? '1' : $("#hdfLatPageNumber").val());
        if (CurrentPageNo > 1) {
            var NewPageNo = CurrentPageNo - 1;
            $("#hdfPageNumber").val(NewPageNo);
            GetRecordList();
        }
    }

    function DCCommitteeMemberDataNextPageClick() {
        var CurrentPageNo = parseInt($("#hdfPageNumber").val() == null ? '1' : $("#hdfPageNumber").val() == '' ? '1' : $("#hdfPageNumber").val());
        var LastPageNo = parseInt($("#hdfLatPageNumber").val() == null ? '1' : $("#hdfLatPageNumber").val() == '' ? '1' : $("#hdfLatPageNumber").val());
        if (CurrentPageNo < LastPageNo) {
            var NewPageNo = CurrentPageNo + 1;
            $("#hdfPageNumber").val(NewPageNo);
            GetRecordList();
        }
    }

    function DCCommitteeMemberDataInActiveStatus(Id) {

        var data = {
            id: Id,
            Flag: 'D'
        };

        $.when(DCCommitteeMemberDataStatusOnSuccess(data)).then(function (response) {
        }).fail(function (err) {
        });
    }

    function DCCommitteeMemberDataActiveStatus(Id) {

        var data = {
            id: Id,
            Flag: 'A'
        };

        $.when(DCCommitteeMemberDataStatusOnSuccess(data)).then(function (response) {
        }).fail(function (err) {
        });
    }

    function DCCommitteeMemberDataStatusOnSuccess(data) {
        return $.ajax({
            type: 'POST',
            url: "/DCCommittee/DCCommitteeMembersStatusUpdate",
            data: data,
            success: function (result) {
                if (result != null) {
                    var VRecordStatus = result.data;
                    var VFlag = result.Flag;

                    if (VRecordStatus == "UD" || VRecordStatus == "D") {
                        if (VFlag == 'A') {
                            swal("Good job!", "Record active successfully..", "success", "1500");
                        }
                        else if (VFlag == 'D') {
                            swal("Good job!", "Record inactive successfully..", "success", "1500");
                        }
                        GetRecordList();
                    }
                    else {
                        swal("", "Opps! Something Went Wrong.", "error");
                    }
                }
                else {
                    $('#loader_bcg').css('display', 'none');
                    swal("", "Opps! Something Went Wrong.", "error");
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $('#loader_bcg').css('display', 'none');
                swal("", "Opps! Something Went Wrong.", "error");
            }
        });
    }

    function viewCommitteeMembers(committeeId) {
        $('#membersModalBody').html('<div class="text-center"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</div>');
        $('#membersModal').modal('show');

        $.ajax({
            url: '/DCCommittee/GetCommitteeMembers',
            type: 'POST',
            data: { committeeId: committeeId },
            success: function (result) {
                if (result.success && result.data && result.data.length > 0) {
                    var html = '<div class="table-responsive"><table class="table table-bordered table-sm mb-0 text-nowrap">';
                    html += '<thead class="table-light"><tr><th class="text-center" style="width:50px">#</th><th>Member No.</th><th>Member Name</th><th>Member Type</th><th>Contact Number</th><th>Email Address</th></tr></thead>';
                    html += '<tbody>';
                    $.each(result.data, function (i, member) {
                        var mType = member.MemberType || '';
                        var mTypeText = '-';
                        if (mType === 'B') {
                            mTypeText = 'BCG MEMBER';
                        } else if (mType === 'O') {
                            mTypeText = 'CO-OPT MEMBER';
                        } else if (mType) {
                            mTypeText = mType;
                        }

                        html += '<tr>' +
                            '<td class="text-center">' + (i + 1) + '</td>' +
                            '<td>' + (member.EnroNumber || '') + '</td>' +
                            '<td>' + (member.FullName || '') + '</td>' +
                            '<td>' + mTypeText + '</td>' +
                            '<td>' + (member.ContactNumber || '') + '</td>' +
                            '<td>' + (member.EmailAddress || '') + '</td>' +
                            '</tr>';
                    });
                    html += '</tbody></table></div>';
                    $('#membersModalBody').html(html);
                } else {
                    $('#membersModalBody').html('<div class="text-center text-muted">No members found.</div>');
                }
            },
            error: function () {
                $('#membersModalBody').html('<div class="text-center text-danger">Error loading members.</div>');
            }
        });
    }
</script>
