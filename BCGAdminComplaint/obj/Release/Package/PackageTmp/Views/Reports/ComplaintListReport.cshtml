
@{
    ViewBag.Title = "ComplaintListReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .modal-backdrop {
        z-index: 1040 !important;
    }
    #complaintDetailsModal {
        z-index: 1055 !important;
    }
    #paymentModal {
        z-index: 1060 !important;
    }
    #filePreviewModal {
        z-index: 1070 !important;
    }
    .select2-container .select2-selection__clear {
        display: none !important;
    }
</style>

<div>
    <div class="row mb-3">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <div>
                    <h4 class="mb-sm-0 font-size-18">Complaint Report</h4>
                    <div class="page-title-left mt-1">
                        <ol class="breadcrumb m-0 font-size-13">
                            <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                            <li class="breadcrumb-item active">Complaint Report</li>
                        </ol>
                    </div>
                </div>
                <div class="page-title-right d-flex align-items-center">
                    <div class="input-group input-group-sm me-2">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input id="txtQuickSearch" class="form-control quicksearchcomplaintmanagement" placeholder="Quick Search (Name or contact number or email id or Complaint Number)">
                    </div>
                    <a class="btn btn-sm btn-outline-primary text-nowrap" id="addfilter"><i class="fa-solid fa-filter me-1"></i> Filter</a>
                </div>
            </div>
        </div>
    </div>
    <div class="card main_filter_div">
        <div class="card-body">
            <div class="row ">
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3 mt-3">
                    <label>Status</label>
                    <select id="drpStatus" class="form-control select2">
                        <option value="0">Select Status</option>
                        <option value="New">New</option>
                        <option value="Old">Old</option>
                        <option value="Accepted">Accepted</option>
                        <option value="More Detail">More Detail</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Withdrawal Granted">Withdrawal Granted</option>
                        <option value="Next General Board">Next General Board</option>
                        <option value="Board Has Approved">Board Has Approved</option>
                        <option value="Board Has Rejected">Board Has Rejected</option>
                        <option value="Hearing">Hearing</option>
                        <option value="Adjunt">Adjunt</option>
                        <option value="Order Passed">Order Passed</option>
                    </select>
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3 mt-3">
                    <label>Payment Status</label>
                    <select id="drpPaymentStatus" class="form-control select2">
                        <option value="">Select Payment Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Parcel Due">Parcel Due</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3 mt-3">
                    <label> From Date:</label>
                    <input name="txtFromDate" id="txtFromDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-2 mt-3">
                    <label> To Date:</label>
                    <input name="txtToDate" id="txtToDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-4 col-sm-4 col-12 col-lg-2 mt-3">
                    <label> Year:</label>
                    <input name="txtYear" id="txtYear" type="number" placeholder="YYYY" class="form-control">
                </div>
                <div class="form-group col-md-4 col-sm-4 col-12 col-lg-2 mt-3">
                    <label> From No.:</label>
                    <input name="txtFromNo" id="txtFromNo" type="number" placeholder="From No." class="form-control">
                </div>
                <div class="form-group col-md-4 col-sm-4 col-12 col-lg-2 mt-3">
                    <label> To No.:</label>
                    <input name="txtToNo" id="txtToNo" type="number" placeholder="To No." class="form-control">
                </div>
                <div class="col-md-12 mt-3">
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <span class="fw-bold text-dark font-size-13">
                                <i class="fa-solid fa-table-columns text-primary me-1"></i> Select Report Columns for Export (PDF &amp; Excel):
                                <span class="badge bg-primary ms-1" id="lblSelectedCount">15 selected</span>
                            </span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 me-2" id="btnSelectAllCols"><i class="fa-solid fa-check-double me-1"></i> Select All</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="btnClearAllCols"><i class="fa-solid fa-rotate-left me-1"></i> Clear</button>
                            </div>
                        </div>
                        <div class="row g-2" id="colSelectionList">
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="SrNo" id="col_SrNo" checked>
                                    <label class="form-check-label font-size-12" for="col_SrNo">#</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="ComplaintNumber" id="col_ComplaintNumber" checked>
                                    <label class="form-check-label font-size-12" for="col_ComplaintNumber">Complaint Number</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="ComplaintsCreateDate" id="col_ComplaintsCreateDate" checked>
                                    <label class="form-check-label font-size-12" for="col_ComplaintsCreateDate">Created Date</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="ComplainedAgainst" id="col_ComplainedAgainst" checked>
                                    <label class="form-check-label font-size-12" for="col_ComplainedAgainst">Complained Against</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="FullName" id="col_FullName" checked>
                                    <label class="form-check-label font-size-12" for="col_FullName">Full Name</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="ContactNumber" id="col_ContactNumber" checked>
                                    <label class="form-check-label font-size-12" for="col_ContactNumber">Contact Number</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="EmailAddress" id="col_EmailAddress" checked>
                                    <label class="form-check-label font-size-12" for="col_EmailAddress">Email</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="AffidavitFilesText" id="col_AffidavitFilesText" checked>
                                    <label class="form-check-label font-size-12" for="col_AffidavitFilesText">Complaint Affidavit Copy</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="AdditionalFilesText" id="col_AdditionalFilesText" checked>
                                    <label class="form-check-label font-size-12" for="col_AdditionalFilesText">Additional Attachments</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="TotalAmount" id="col_TotalAmount" checked>
                                    <label class="form-check-label font-size-12" for="col_TotalAmount">Total Amount</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="PaidAmount" id="col_PaidAmount" checked>
                                    <label class="form-check-label font-size-12" for="col_PaidAmount">Paid Amount</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="DueAmount" id="col_DueAmount" checked>
                                    <label class="form-check-label font-size-12" for="col_DueAmount">Due Amount</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="PaymentStatus" id="col_PaymentStatus" checked>
                                    <label class="form-check-label font-size-12" for="col_PaymentStatus">Payment Status</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="PaymentInfoText" id="col_PaymentInfoText" checked>
                                    <label class="form-check-label font-size-12" for="col_PaymentInfoText">Payment Information</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="form-check">
                                    <input class="form-check-input chk-col-select" type="checkbox" value="Status" id="col_Status" checked>
                                    <label class="form-check-label font-size-12" for="col_Status">Status</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-12 mt-3">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <a id="lnkFilter" class="btn-sm btn btn-outline-primary waves-effect waves-light close_filterdiv"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</a>
                        <a id="lnkPrintPDF" class="btn-sm btn btn-outline-primary waves-effect waves-light"><i class="fa-solid fa-file-pdf me-1"></i> Download in PDF</a>
                        <a id="lnkDownloadExcel" class="btn-sm btn btn-outline-success waves-effect waves-light"><i class="fa-solid fa-file-excel me-1"></i> Download in Excel</a>
                        <a id="btnCancel" class="btn btn-outline-danger waves-effect m-l-5 btn-sm close_filterdiv"><i class="fa-solid fa-xmark me-1"></i> Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="row mt-3" id="tblComplaintList">
                <div class="col-sm-12">
                    <div class="table-responsive">
                        <table class="table table-bordered dt-responsive nowrap w-100 dataTable no-footer dtr-inline">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Complaint Number & Created Date</th>
                                    <th>Full Name</th>
                                    <th>Contact Number & Email</th>
                                    <th>Complained Against</th>
                                    <th>Total Amount</th>
                                    <th>Payment Status</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="paginationDiv" class="mt-3 d-flex justify-content-between align-items-center">
        <div id="entriesInfo" class="fw-bold text-dark mb-0"></div>
        <ul class="pagination pagination-rounded mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- File Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 90vw;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">File Preview</h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="" id="displayPdf" style="width: 100%; height: 80vh; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Complaint Details Popup Modal -->
<div class="modal fade" id="complaintDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
            <div class="modal-header py-3 px-4" style="background: linear-gradient(135deg, #f8f9fc 0%, #edf2f9 100%); border-bottom: 1px solid #e2e8f0;">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-file-lines fs-6"></i>
                    </span>
                    <div>
                        <h5 class="modal-title mb-0 fw-bold text-dark" id="cdModalTitle">Complaint Details</h5>
                        <small class="text-muted" id="cdModalSubtitle">Comprehensive Information</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Basic Information Card -->
                <div class="card border mb-3 shadow-none" style="border-color: #e2e8f0 !important; border-radius: 10px; overflow: hidden;">
                    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-circle-info text-primary me-2"></i>Basic Information</span>
                        <span id="cdModalStatusWrapper"></span>
                        <span id="cdModalStatus" style="display:none;"></span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2">
                            <!-- Complaint Number -->
                            <div class="col-md-6 col-lg-3">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Complaint Number</div>
                                    <div class="fw-bold text-primary mt-1 text-truncate" id="cdModalComplaintNo" style="font-size: 13.5px;">-</div>
                                </div>
                            </div>
                            <!-- Created Date -->
                            <div class="col-md-6 col-lg-3">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Created Date</div>
                                    <div class="fw-bold text-dark mt-1 text-truncate" id="cdModalCreatedDate" style="font-size: 13px;">-</div>
                                </div>
                            </div>
                            <!-- Complainant -->
                            <div class="col-md-6 col-lg-6">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Complainant</div>
                                    <div class="fw-bold text-dark mt-1 text-truncate" id="cdModalComplainant" style="font-size: 13.5px;">-</div>
                                </div>
                            </div>
                            <!-- Contact -->
                            <div class="col-md-6 col-lg-3">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Contact Number</div>
                                    <div class="fw-bold text-dark mt-1" id="cdModalContact" style="font-size: 13.5px;">-</div>
                                </div>
                            </div>
                            <!-- Email -->
                            <div class="col-md-12 col-lg-9">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Email Address</div>
                                    <div class="fw-bold text-dark mt-1 text-truncate" id="cdModalEmail" style="font-size: 13px;">-</div>
                                </div>
                            </div>
                            <!-- Complained Against (Advocate) -->
                            <div class="col-12">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #fff9e6; border-color: #ffe58f !important;">
                                    <div class="fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: #ad6800;">
                                        <i class="fa-solid fa-scale-balanced me-1"></i> Complained Against (Advocate / Other)
                                    </div>
                                    <div class="fw-bold mt-1" style="font-size: 14px; color: #613400;" id="cdModalAgainst">-</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Details Section -->
                <div class="card border mb-3 shadow-none" style="border-color: #e2e8f0 !important; border-radius: 10px; overflow: hidden;">
                    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-indian-rupee-sign text-success me-2"></i>Payment Information</span>
                        <span id="cdModalPaymentBadge"></span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2 text-center mb-3">
                            <div class="col-4">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #eff6ff; border-color: #bfdbfe !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Total Amount</div>
                                    <div class="fw-bold fs-5 mt-1" style="color: #1d4ed8;" id="cdModalTotalAmount">₹0.00</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #ecfdf5; border-color: #a7f3d0 !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Paid Amount</div>
                                    <div class="fw-bold fs-5 mt-1" style="color: #047857;" id="cdModalPaidAmount">₹0.00</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 px-3 border rounded h-100" style="background-color: #fef2f2; border-color: #fecaca !important;">
                                    <div class="text-muted fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Due Amount</div>
                                    <div class="fw-bold fs-5 mt-1" style="color: #b91c1c;" id="cdModalDueAmount">₹0.00</div>
                                </div>
                            </div>
                        </div>

                        <!-- Receipts Table -->
                        <h6 class="fw-semibold text-muted text-uppercase mb-2" style="font-size: 11.5px; letter-spacing: 0.5px;">Receipts & Payment Records</h6>
                        <div class="table-responsive border rounded" style="overflow: hidden;">
                            <table class="table table-sm table-striped mb-0" id="cdModalTblPayments">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Receipt No</th>
                                        <th>Receipt Date</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Txn No</th>
                                        <th>Txn Date</th>
                                        <th>Bank</th>
                                    </tr>
                                </thead>
                                <tbody class="small"></tbody>
                            </table>
                        </div>

                        <div id="cdModalPaySection" class="mt-2 text-end" style="display:none;">
                            <button type="button" class="btn btn-sm btn-outline-success" id="cdModalBtnPayNow"><i class="fa-solid fa-credit-card me-1"></i> Pay Payment</button>
                        </div>
                    </div>
                </div>

                <!-- Complaint Affidavit Copy Section -->
                <div class="card border mb-3 shadow-none" style="border-color: #e2e8f0 !important; border-radius: 10px; overflow: hidden;">
                    <div class="card-header py-2 px-3" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-file-pdf text-danger me-2"></i>Complaint Affidavit Copy</span>
                    </div>
                    <div class="card-body p-3" id="cdModalAffidavitContent">
                        <span class="text-muted small">No affidavit file uploaded.</span>
                    </div>
                </div>

                <!-- If Any Additional Attachments Section -->
                <div class="card border mb-1 shadow-none" style="border-color: #e2e8f0 !important; border-radius: 10px; overflow: hidden;">
                    <div class="card-header py-2 px-3" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-paperclip text-info me-2"></i>If Any Additional Attachments</span>
                    </div>
                    <div class="card-body p-3" id="cdModalAttachmentContent">
                        <span class="text-muted small">No additional attachments uploaded.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 px-4" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0;">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Details & Pay Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="payModalTitle">Payment Details</h5>
                    <small class="text-muted" id="payModalSubtitle"></small>
                </div>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Summary Cards -->
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="p-2 border rounded text-center bg-light">
                            <div class="text-muted small">Total Amount</div>
                            <div class="fw-bold text-dark fs-6" id="modalTotalAmount">₹0.00</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded text-center bg-light">
                            <div class="text-muted small">Paid Amount</div>
                            <div class="fw-bold text-success fs-6" id="modalPaidAmount">₹0.00</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded text-center bg-light">
                            <div class="text-muted small">Due Amount</div>
                            <div class="fw-bold text-danger fs-6" id="modalDueAmount">₹0.00</div>
                        </div>
                    </div>
                </div>

                <!-- Pay Payment Information Form -->
                <div id="modalPayFormSection" class="card border p-3 mb-3" style="display:none; background-color: #fcfdfe;">
                    <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-credit-card me-1"></i> Pay Payment Information</h6>
                    <input type="hidden" id="modalHdfComplaintId" />
                    <input type="hidden" id="modalHdfDueAmount" />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Receipt Number <span class="text-danger">*</span></label>
                            <input type="text" maxlength="15" id="modalTxtReceiptNumber" placeholder="Receipt Number" class="form-control form-control-sm" onkeypress="return isNumberKey(event, this)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Receipt Date <span class="text-danger">*</span></label>
                            <input type="date" id="modalTxtReceiptDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Receipt By <span class="text-danger">*</span></label>
                            <select id="modalDdlPaymentMode" class="form-select form-select-sm" onchange="modalPaymentModeChange()">
                                <option value="0">Select</option>
                                <option value="CASH">CASH</option>
                                <option value="D.D.">D.D.</option>
                                <option value="OUTSTANDING">OUTSTANDING</option>
                                <option value="RTGS">RTGS</option>
                                <option value="JOURNAL">JOURNAL</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Transaction Date <span class="text-danger">*</span></label>
                            <input type="date" id="modalTxtTransactionDate" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-6" id="modalDivTransactionNumber" style="display:none;">
                            <label class="form-label small mb-1">Transaction Number <span class="text-danger">*</span></label>
                            <input type="text" maxlength="15" id="modalTxtTransactionNumber" placeholder="Transaction Number" class="form-control form-control-sm" onkeypress="return isNumberKey(event, this)">
                        </div>
                        <div class="col-md-6" id="modalDivBank" style="display:none;">
                            <label class="form-label small mb-1">Bank <span class="text-danger">*</span></label>
                            <select id="modalDdlBank" class="form-select form-select-sm">
                                <option value="0">Select</option>
                            </select>
                        </div>
                        <div class="col-12 text-end mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnModalSavePayment" onclick="saveModalPayment()"><i class="fa-solid fa-check me-1"></i> Save Payment</button>
                        </div>
                    </div>
                </div>

                <!-- Payment Information History -->
                <div class="card border p-3 mb-0">
                    <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-clock-rotate-left me-1"></i> Payment Information</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0" id="modalTblPaymentList">
                            <thead class="table-light">
                                <tr>
                                    <th>Receipt No.</th>
                                    <th>Receipt Date</th>
                                    <th>Paid Amount</th>
                                    <th>Mode</th>
                                    <th>Txn No.</th>
                                    <th>Txn Date</th>
                                    <th>Bank</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    var baseFilter = {
        pageNo: 1,
        pageSize: 10,
        sortColumn: 1,
        sortOrder: 'asc',
        searchValue: ''
    };

    var bankListLoaded = false;

    function isNumberKey(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }

    function previewFile(url) {
        if (!url) {
            swal("File path is not available.", "", "warning");
            return;
        }
        $('#displayPdf').attr('src', url);
        $('#filePreviewModal').modal('show');
    }

    function initSelect2() {
        if ($.fn.select2) {
            $('#drpStatus, #drpPaymentStatus, select.select2').select2({
                allowClear: false,
                width: '100%'
            });
        }
    }

    $(document).ready(function () {
        $('#filePreviewModal, #complaintDetailsModal, #paymentModal').appendTo('body');
        $(".main_filter_div").hide();
        initSelect2();
        GetComplaintList();
    });

    $('#txtQuickSearch').on('input', function () {
        baseFilter.pageNo = 1;
        baseFilter.searchValue = $(this).val();
        GetComplaintList();
    });

    function GetComplaintList() {

        var Data = JSON.stringify({
            baseFilter,
            Status: $("#drpStatus option:selected").text() == 'Select Status' ? "" : $("#drpStatus option:selected").text().trim(),
            PaymentStatus: $("#drpPaymentStatus option:selected").text() == 'Select Payment Status' ? "" : $("#drpPaymentStatus option:selected").text().trim(),
            FromDate: $("#txtFromDate").val(),
            ToDate: $("#txtToDate").val(),
            Year: $("#txtYear").val(),
            FromNo: $("#txtFromNo").val(),
            ToNo: $("#txtToNo").val()
        });

        $.ajax({
            type: 'POST',
            url: "/Reports/GetReportComplaintList",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $("#tblComplaintList tbody").empty();
                var complaintList = $("#tblComplaintList tbody");
                if (response.IsSuccess) {
                    var totalRecords = response.Data.length > 0 ? response.Data[0].TotalRecord : 0;
                    complaintDataMap = {};
                    $.each(response.Data, function (data, value) {
                        complaintDataMap[value.Id] = value;

                        var againstText = '';
                        if (value.ComplainedAgainst) {
                            againstText = value.ComplainedAgainst.split(', ').join('<br/>');
                        }

                        // Amounts
                        var totAmt = value.TotalAmount != null ? parseFloat(value.TotalAmount) : 0;

                        // Payment Status badge
                        var payStatus = value.PaymentStatus || '';
                        var payBadge = payStatus === 'Completed' ? '<span class="badge bg-success">Completed</span>' : payStatus === 'Parcel Due' ? '<span class="badge bg-warning text-dark">Parcel Due</span>' : '<span class="badge bg-danger">Pending</span>';

                        var complaintNoAndDate = '';
                        if (value.ComplaintNumber && value.ComplaintsCreateDate) {
                            complaintNoAndDate = '<div>' + value.ComplaintNumber + '</div><div class="text-muted small">' + value.ComplaintsCreateDate + '</div>';
                        } else if (value.ComplaintNumber) {
                            complaintNoAndDate = value.ComplaintNumber;
                        } else if (value.ComplaintsCreateDate) {
                            complaintNoAndDate = value.ComplaintsCreateDate;
                        } else {
                            complaintNoAndDate = '-';
                        }

                        var contactEmail = '';
                        if (value.ContactNumber) {
                            contactEmail += '<div>' + value.ContactNumber + '</div>';
                        }
                        if (value.EmailAddress) {
                            contactEmail += '<div class="text-muted small">' + value.EmailAddress + '</div>';
                        }
                        if (!contactEmail) {
                            contactEmail = '-';
                        }

                        complaintList.append(
                            '<tr>'
                            + '<td>' + value.SrNo + '</td>'
                            + '<td style="text-align:center;display:none;">' + value.Id + '</td>'
                            + '<td>' + complaintNoAndDate + '</td>'
                            + '<td>' + (value.FullName || '') + '</td>'
                            + '<td>' + contactEmail + '</td>'
                            + '<td>' + againstText + '</td>'
                            + '<td>₹' + totAmt.toFixed(2) + '</td>'
                            + '<td>' + payBadge + '</td>'
                            + '<td>' + (value.Status || '') + '</td>'
                            + '<td class="text-center">'
                                + '<button type="button" class="btn btn-sm btn-outline-primary text-nowrap" onclick="viewComplaintDetails(' + value.Id + ')">'
                                    + '<i class="fa-solid fa-eye me-1"></i> View'
                                + '</button>'
                            + '</td>'
                            + '</tr>');
                    });

                    RenderPagination(totalRecords);
                }
                else {
                    complaintList.append('No Data Found');
                }

            }, failure: function (result) {
                swal('Something went wrong!', '', 'error');
            },
            error: function (result) {
                swal('Something went wrong!', '', 'error');
            }
        });
    }

    function RenderPagination(totalRecords) {
        var totalPages = Math.ceil(totalRecords / baseFilter.pageSize);
        var paginationHtml = '';
        $("#paginationList").empty();

        var startEntry = totalRecords > 0 ? ((baseFilter.pageNo - 1) * baseFilter.pageSize + 1) : 0;
        var endEntry = Math.min(baseFilter.pageNo * baseFilter.pageSize, totalRecords);
        $("#entriesInfo").html('Showing ' + startEntry + ' to ' + endEntry + ' of ' + totalRecords + ' entries');

        if (totalPages > 1) {
            var prevDisabled = baseFilter.pageNo <= 1 ? 'disabled' : '';
            var prevPage = baseFilter.pageNo > 1 ? baseFilter.pageNo - 1 : 1;
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + prevPage + ')"><i class="fa-solid fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, baseFilter.pageNo - 2);
            var endPage = Math.min(totalPages, baseFilter.pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === baseFilter.pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + i + ')">' + i + '</a></li>';
            }

            var nextDisabled = baseFilter.pageNo >= totalPages ? 'disabled' : '';
            var nextPage = baseFilter.pageNo < totalPages ? baseFilter.pageNo + 1 : totalPages;
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + nextPage + ')"><i class="fa-solid fa-chevron-right"></i></a></li>';
        }

        $("#paginationList").html(paginationHtml);
    }

    function ChangePage(page) {
        baseFilter.pageNo = page;
        GetComplaintList();
    }

    $('#lnkFilter').click(function () {

        baseFilter.searchValue = $("#txtQuickSearch").val();

        if ($("#txtFromDate").val() != "") {
            if ($("#txtToDate").val() == "") {
                swal("Please select ToDate", "", "error");
            }
            else {
                GetComplaintList();
            }
        }
        else {
            GetComplaintList();
        }
    });

    $('#btnCancel').click(function () {
        baseFilter.searchValue = '';
        $('#txtQuickSearch').val('');
        $('#txtToDate').val('');
        $('#txtFromDate').val('');
        $('#drpPaymentStatus').val('').trigger('change');
        $('#drpStatus').val('0').trigger('change');
        $('#txtYear').val('');
        $('#txtFromNo').val('');
        $('#txtToNo').val('');
        $('.chk-col-select').prop('checked', true);
        updateSelectedColCount();
        GetComplaintList();
    });

    function updateSelectedColCount() {
        var count = $('.chk-col-select:checked').length;
        var total = $('.chk-col-select').length;
        $('#lblSelectedCount').text(count + ' of ' + total + ' selected');
    }

    $(document).on('change', '.chk-col-select', function () {
        updateSelectedColCount();
    });

    $('#btnSelectAllCols').click(function () {
        $('.chk-col-select').prop('checked', true);
        updateSelectedColCount();
    });

    $('#btnClearAllCols').click(function () {
        $('.chk-col-select').prop('checked', false);
        updateSelectedColCount();
    });

    function getSelectedColumns() {
        var cols = [];
        $('.chk-col-select:checked').each(function () {
            cols.push($(this).val());
        });
        return cols;
    }

    $('#addfilter').off('click').on('click', function (e) {
        e.preventDefault();
        $(".main_filter_div").slideToggle(200, function () {
            initSelect2();
        });
    });

    $('.close_filterdiv').click(function () {
        $(".main_filter_div").slideUp();
    });

    $('#lnkPrintPDF').click(function () {
        var selectedCols = getSelectedColumns();
        if (selectedCols.length === 0) {
            swal("Please select at least one column to export.", "", "warning");
            return;
        }

        var Data = JSON.stringify({
            searchTerm: $('#txtQuickSearch').val(),
            Status: $("#drpStatus option:selected").text() == 'Select Status' ? "" : $("#drpStatus option:selected").text().trim(),
            PaymentStatus: $("#drpPaymentStatus option:selected").text() == 'Select Payment Status' ? "" : $("#drpPaymentStatus option:selected").text().trim(),
            FromDate: $("#txtFromDate").val(),
            ToDate: $("#txtToDate").val(),
            Year: $("#txtYear").val(),
            FromNo: $("#txtFromNo").val(),
            ToNo: $("#txtToNo").val(),
            selectedColumns: selectedCols.join(',')
        });

        $.when(PDFFilterDataSave(Data)).then(function (response) {
            console.log(response);
        }).fail(function (err) {
            console.log(err);
        });
    });

    function PDFFilterDataSave(data) {
        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/Reports/GetAllComplaintReportsListFilterSet",
            data: data,
            success: function (result) {
                $("#overlay").hide();
                if (result.data == "Success") {
                    var url = '@Url.Action("GetAllComplaintPDFReport")';
                    location.href = url;
                } else {
                    swal('Something went wrong!', "", "error");
                }
            },
            error: function () {
                $("#overlay").hide();
                swal('Something went wrong!', "", "error");
            }
        });
    }

    $('#lnkDownloadExcel').click(function () {
        var selectedCols = getSelectedColumns();
        if (selectedCols.length === 0) {
            swal("Please select at least one column to export.", "", "warning");
            return;
        }

        var Data = JSON.stringify({
            searchTerm: $('#txtQuickSearch').val(),
            Status: $("#drpStatus option:selected").text() == 'Select Status' ? "" : $("#drpStatus option:selected").text().trim(),
            PaymentStatus: $("#drpPaymentStatus option:selected").text() == 'Select Payment Status' ? "" : $("#drpPaymentStatus option:selected").text().trim(),
            FromDate: $("#txtFromDate").val(),
            ToDate: $("#txtToDate").val(),
            Year: $("#txtYear").val(),
            FromNo: $("#txtFromNo").val(),
            ToNo: $("#txtToNo").val(),
            selectedColumns: selectedCols.join(',')
        });

        $.when(ExcelFilterDataSave(Data)).then(function (response) {
            console.log(response);
        }).fail(function (err) {
            console.log(err);
        });
    });

    function ExcelFilterDataSave(data) {
        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/Reports/GetAllComplaintReportsListFilterSet",
            data: data,
            success: function (result) {
                $("#overlay").hide();
                if (result.data == "Success") {
                    var url = '@Url.Action("GetAllComplaintExcelReport")';
                    location.href = url;
                } else {
                    swal('Something went wrong!', "", "error");
                }
            },
            error: function () {
                swal('Something went wrong!', "", "error");
            }
        });
    }

    function openPaymentModal(complaintId, complaintNo, encFullName, totalAmt, paidAmt, dueAmt, showPayForm) {
        var fullName = decodeURIComponent(encFullName || '');
        $('#payModalTitle').text('Payment Details - ' + complaintNo);
        $('#payModalSubtitle').text(fullName);

        $('#modalTotalAmount').text('₹' + parseFloat(totalAmt || 0).toFixed(2));
        $('#modalPaidAmount').text('₹' + parseFloat(paidAmt || 0).toFixed(2));
        $('#modalDueAmount').text('₹' + parseFloat(dueAmt || 0).toFixed(2));

        $('#modalHdfComplaintId').val(complaintId);
        $('#modalHdfDueAmount').val(dueAmt);

        // Reset form
        $('#modalTxtReceiptNumber').val('');
        var today = new Date().toISOString().split('T')[0];
        $('#modalTxtReceiptDate').val(today);
        $('#modalTxtTransactionDate').val(today);
        $('#modalDdlPaymentMode').val('0');
        $('#modalTxtTransactionNumber').val('');
        $('#modalDivTransactionNumber').hide();
        $('#modalDivBank').hide();

        if (dueAmt > 0 && showPayForm) {
            $('#modalPayFormSection').show();
        } else {
            $('#modalPayFormSection').hide();
        }

        loadBanksIfNeeded();
        loadModalPaymentHistory(complaintId);
        $('#paymentModal').modal('show');
    }

    function loadBanksIfNeeded() {
        if (!bankListLoaded) {
            $.ajax({
                type: "POST",
                url: "/ComplaintDetails/GetComplaintBankList",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response.IsSuccess && response.Data) {
                        $('#modalDdlBank').empty();
                        $('#modalDdlBank').append('<option value="0">Select</option>');
                        $.each(response.Data, function (i, item) {
                            $('#modalDdlBank').append('<option value="' + item.Id + '">' + item.BankName + '</option>');
                        });
                        bankListLoaded = true;
                    }
                }
            });
        }
    }

    function loadModalPaymentHistory(complaintId) {
        $('#modalTblPaymentList tbody').empty();
        $('#modalTblPaymentList tbody').append('<tr><td colspan="7" class="text-center text-muted">Loading payments...</td></tr>');

        $.ajax({
            type: "POST",
            url: "/ComplaintDetails/GetComplaintPaymentReceivedLog",
            data: { ComplaintId: complaintId },
            success: function (response) {
                $('#modalTblPaymentList tbody').empty();
                if (response.IsSuccess && response.Data && response.Data.length > 0) {
                    $.each(response.Data, function (i, item) {
                        var dateStr = item.ReceiptDate ? item.ReceiptDate.split('T')[0] : '';
                        var txnDateStr = item.TransactionDate ? item.TransactionDate.split('T')[0] : '';
                        $('#modalTblPaymentList tbody').append(
                            '<tr>'
                            + '<td>' + (item.ReceiptNumber || '-') + '</td>'
                            + '<td>' + (dateStr || '-') + '</td>'
                            + '<td class="fw-bold text-success">₹' + parseFloat(item.PaidAmount || 0).toFixed(2) + '</td>'
                            + '<td>' + (item.PaymentMode || '-') + '</td>'
                            + '<td>' + (item.TransactionNumber || '-') + '</td>'
                            + '<td>' + (txnDateStr || '-') + '</td>'
                            + '<td>' + (item.BankName || '-') + '</td>'
                            + '</tr>'
                        );
                    });
                } else {
                    $('#modalTblPaymentList tbody').append('<tr><td colspan="7" class="text-center text-muted">No payment records found.</td></tr>');
                }
            },
            error: function () {
                $('#modalTblPaymentList tbody').empty();
                $('#modalTblPaymentList tbody').append('<tr><td colspan="7" class="text-center text-danger">Failed to load payment history.</td></tr>');
            }
        });
    }

    function modalPaymentModeChange() {
        var mode = $('#modalDdlPaymentMode').val();
        if (mode === 'CASH') {
            $('#modalDivTransactionNumber').hide();
            $('#modalDivBank').hide();
        } else if (mode === 'D.D.' || mode === 'OUTSTANDING' || mode === 'RTGS' || mode === 'JOURNAL') {
            $('#modalDivTransactionNumber').show();
            $('#modalDivBank').show();
        } else {
            $('#modalDivTransactionNumber').hide();
            $('#modalDivBank').hide();
        }
    }

    function saveModalPayment() {
        var complaintId = $('#modalHdfComplaintId').val();
        var dueAmt = parseFloat($('#modalHdfDueAmount').val() || 0);
        var receiptNo = $.trim($('#modalTxtReceiptNumber').val());
        var receiptDate = $('#modalTxtReceiptDate').val();
        var mode = $('#modalDdlPaymentMode').val();
        var txnDate = $('#modalTxtTransactionDate').val();
        var txnNo = $.trim($('#modalTxtTransactionNumber').val());
        var bankId = $('#modalDdlBank').val() || '0';

        if (dueAmt <= 0) {
            swal("The due amount is zero.", "", "error");
            return;
        }
        if (!receiptNo) {
            swal("Please input receipt number.", "", "error");
            return;
        }
        if (!receiptDate) {
            swal("Please input receipt date.", "", "error");
            return;
        }
        if (mode === '0' || !mode) {
            swal("Please select receipt by (payment mode).", "", "error");
            return;
        }
        if (!txnDate) {
            swal("Please input transaction date.", "", "error");
            return;
        }
        if (mode !== 'CASH') {
            if (!txnNo) {
                swal("Please input transaction number.", "", "error");
                return;
            }
            if (parseInt(bankId) === 0) {
                swal("Please select bank.", "", "error");
                return;
            }
        }

        var postData = JSON.stringify({
            ComplaintId: complaintId,
            PaidAmount: dueAmt,
            PaidOn: receiptDate,
            PaymentMode: mode,
            TransactionNumber: txnNo,
            TransactionDate: txnDate,
            BankId: bankId,
            ReceiptNumber: receiptNo,
            ReceiptDate: receiptDate
        });

        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/ComplaintDetails/GetComplaintPaymentReceived",
            data: postData,
            success: function (response) {
                if (response.IsSuccess) {
                    swal("Payment Saved Successfully!", "", "success");
                    $('#modalPayFormSection').hide();
                    loadModalPaymentHistory(complaintId);
                    GetComplaintList();
                } else {
                    swal(response.Message || "Failed to save payment.", "", "error");
                }
            },
            error: function () {
                swal("Something went wrong while saving payment.", "", "error");
            }
        });
    }

    function viewComplaintDetails(complaintId) {
        var item = complaintDataMap[complaintId];
        if (!item) {
            swal("Complaint details not found.", "", "error");
            return;
        }

        $('#cdModalComplaintNo').text(item.ComplaintNumber || '-');
        $('#cdModalComplainant').text(item.FullName || '-');
        $('#cdModalContact').text(item.ContactNumber || '-');
        $('#cdModalEmail').text(item.EmailAddress || '-');

        var againstText = item.ComplainedAgainst ? item.ComplainedAgainst.split(', ').join(', ') : '-';
        $('#cdModalAgainst').text(againstText);
        $('#cdModalStatus').text(item.Status || '-');
        $('#cdModalCreatedDate').text(item.ComplaintsCreateDate || '-');

        var statusBadge = '<span class="badge bg-secondary">' + (item.Status || '-') + '</span>';
        if (item.Status === 'New') {
            statusBadge = '<span class="badge bg-success">New</span>';
        } else if (item.Status === 'Old') {
            statusBadge = '<span class="badge bg-secondary">Old</span>';
        } else if (item.Status === 'Payment Done') {
            statusBadge = '<span class="badge bg-primary">Payment Done</span>';
        } else if (item.Status === 'Accepted') {
            statusBadge = '<span class="badge bg-info">Accepted</span>';
        } else if (item.Status === 'Rejected') {
            statusBadge = '<span class="badge bg-danger">Rejected</span>';
        } else if (item.Status === 'Next General Board') {
            statusBadge = '<span class="badge bg-warning text-dark">Next General Board</span>';
        }
        $('#cdModalStatusWrapper').html(statusBadge);

        var totAmt = item.TotalAmount != null ? parseFloat(item.TotalAmount) : 0;
        var paidAmt = item.PaidAmount != null ? parseFloat(item.PaidAmount) : 0;
        var dueAmt = item.DueAmount != null ? parseFloat(item.DueAmount) : (totAmt - paidAmt);

        $('#cdModalTotalAmount').text('₹' + totAmt.toFixed(2));
        $('#cdModalPaidAmount').text('₹' + paidAmt.toFixed(2));
        $('#cdModalDueAmount').text('₹' + dueAmt.toFixed(2));

        var payStatus = item.PaymentStatus || '';
        var payBadge = payStatus === 'Completed' ? '<span class="badge bg-success">Completed</span>' : payStatus === 'Parcel Due' ? '<span class="badge bg-warning text-dark">Parcel Due</span>' : '<span class="badge bg-danger">Pending</span>';
        $('#cdModalPaymentBadge').html(payBadge);

        // Payment Receipts Table
        $('#cdModalTblPayments tbody').empty();
        var payList = [];
        if (item.ComplaintPaymentList) {
            try {
                payList = JSON.parse(item.ComplaintPaymentList) || [];
            } catch (e) { }
        }

        if (payList && payList.length > 0) {
            $.each(payList, function (idx, p) {
                var rDate = p.ReceiptDate ? p.ReceiptDate.split('T')[0] : '-';
                var tDate = p.TransactionDate ? p.TransactionDate.split('T')[0] : '-';
                $('#cdModalTblPayments tbody').append(
                    '<tr>'
                    + '<td>#' + (p.ReceiptNumber || '-') + '</td>'
                    + '<td>' + rDate + '</td>'
                    + '<td class="fw-bold text-success">₹' + parseFloat(p.PaidAmount || 0).toFixed(2) + '</td>'
                    + '<td>' + (p.PaymentMode || '-') + '</td>'
                    + '<td>' + (p.TransactionNumber || '-') + '</td>'
                    + '<td>' + tDate + '</td>'
                    + '<td>' + (p.BankName || '-') + '</td>'
                    + '</tr>'
                );
            });
        } else {
            $('#cdModalTblPayments tbody').append('<tr><td colspan="7" class="text-center text-muted">No payment records found.</td></tr>');
        }

        // Pay Payment button if due > 0
        if (dueAmt > 0) {
            $('#cdModalPaySection').show();
            $('#cdModalBtnPayNow').off('click').on('click', function () {
                $('#complaintDetailsModal').modal('hide');
                openPaymentModal(item.Id, item.ComplaintNumber, encodeURIComponent(item.FullName || ''), totAmt, paidAmt, dueAmt, true);
            });
        } else {
            $('#cdModalPaySection').hide();
        }

        // Affidavit files
        $('#cdModalAffidavitContent').empty();
        var affList = [];
        if (item.ComplaintAffidavitCopyList) {
            try {
                affList = JSON.parse(item.ComplaintAffidavitCopyList) || [];
            } catch (e) { }
        }
        if (affList && affList.length > 0) {
            var affHtml = '<div class="d-flex flex-wrap gap-2">';
            $.each(affList, function (idx, aff) {
                var fName = aff.FileName || 'Affidavit Document';
                affHtml += '<a href="javascript:void(0);" class="btn btn-sm btn-outline-primary" onclick="previewFile(\'' + aff.FilePath + '\')">'
                    + '<i class="fa-solid fa-file-pdf me-1 text-danger"></i> ' + fName
                    + '</a>';
            });
            affHtml += '</div>';
            $('#cdModalAffidavitContent').html(affHtml);
        } else {
            $('#cdModalAffidavitContent').html('<span class="text-muted small">No affidavit file uploaded.</span>');
        }

        // Additional attachments
        $('#cdModalAttachmentContent').empty();
        var attachList = [];
        if (item.ComplaintAdditionalAttachmentsList) {
            try {
                attachList = JSON.parse(item.ComplaintAdditionalAttachmentsList) || [];
            } catch (e) { }
        }
        if (attachList && attachList.length > 0) {
            var attachHtml = '<div class="d-flex flex-wrap gap-2">';
            $.each(attachList, function (idx, att) {
                var fName = att.FileName || att.FileTitle || 'Additional Attachment';
                var desc = att.Description ? ' <span class="text-muted">(' + att.Description + ')</span>' : '';
                attachHtml += '<div class="mb-1"><a href="javascript:void(0);" class="btn btn-sm btn-outline-info" onclick="previewFile(\'' + att.FilePath + '\')">'
                    + '<i class="fa-solid fa-paperclip me-1"></i> ' + fName
                    + '</a>' + desc + '</div>';
            });
            attachHtml += '</div>';
            $('#cdModalAttachmentContent').html(attachHtml);
        } else {
            $('#cdModalAttachmentContent').html('<span class="text-muted small">No additional attachments uploaded.</span>');
        }

        $('#complaintDetailsModal').modal('show');
    }
</script>