    function RenderPagination(totalRecords) {
        var totalPages = Math.ceil(totalRecords / baseFilter.pageSize);
        var paginationHtml = '';
        $("#paginationList").empty();

        var startEntry = totalRecords > 0 ? ((baseFilter.pageNo - 1) * baseFilter.pageSize + 1) : 0;
        var endEntry = Math.min(baseFilter.pageNo * baseFilter.pageSize, totalRecords);
        $("#entriesInfo").html('Showing ' + startEntry + ' to ' + endEntry + ' of ' + totalRecords + ' entries');

        if (totalPages > 1) {
            var prevDisabled = baseFilter.pageNo <= 1 ? 'disabled' : '';
            var prevPage = baseFilter.pageNo > 1 ? baseFilter.pageNo - 1 : 1;
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + prevPage + ')"><i class="fa-solid fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, baseFilter.pageNo - 2);
            var endPage = Math.min(totalPages, baseFilter.pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === baseFilter.pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + i + ')">' + i + '</a></li>';
            }

            var nextDisabled = baseFilter.pageNo >= totalPages ? 'disabled' : '';
            var nextPage = baseFilter.pageNo < totalPages ? baseFilter.pageNo + 1 : totalPages;
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link" href="javascript:void(0);" onclick="ChangePage(' + nextPage + ')"><i class="fa-solid fa-chevron-right"></i></a></li>';
        }

        $("#paginationList").html(paginationHtml);
    }

    function ChangePage(page) {
        baseFilter.pageNo = page;
        GetComplaintList();
    }

    $(document).on('click', '#lnkShareWithDC', function () {
        var complaintId = $(this).closest('.main_card_list').find('#HdfId').text();
        $('#shareDcCommitteeModal').data('complaintId', complaintId);
        
        $.ajax({
            type: 'Get',
            url: "/ComplaintDetails/GetComplaintShareMembers",
            contentType: "application/json; charset=utf-8",
            data: { ComplaintId: complaintId },
            dataType: "json",
            success: function (response) {
                $('#tblShareDcMembers').empty();
                if (response.IsSuccess) {
                    $.each(response.Data, function (data, value) {
                        var isCheckedStr = (value.Flag === 'A' || value.Flag === null) ? 'checked=""' : '';
                        
                        var VShareDcMembersItem = '<div class="main_card_list main_card_list_border mb-2">'
                                                    + '<div class="main_header_card">'
                                                        + '<div class="_left_side">'
                                                            + '<div class="number">' + (data + 1) + '</div>'
                                                            + '<div class="complaint_number">'
                                                                + '<div class="title">Enrollment Number</div>'
                                                                + '<a class="description">' + value.EnroNumber + '</a>'
                                                            + '</div>'
                                                            + '<div class="complaint_number">'
                                                                + '<div class="title">Name</div>'
                                                                + '<a class="description">' + value.FullName + '</a>'
                                                            + '</div>'
                                                            + '<div class="complaint_number">'
                                                                + '<div class="title">Contact Number</div>'
                                                                + '<a class="description">' + value.ContactNumber + '</a>'
                                                            + '</div>'
                                                        + '</div>'
                                                        + '<div class="rigth_side_check">'
                                                            + '<input type="checkbox" class="main_check_style" name="shareDcCheck" value="' + value.MemberId + '" ' + isCheckedStr + '>'
                                                            + '<i class="las la-check"></i>'
                                                        + '</div>'
                                                    + '</div>'
                                                + '</div>';
                        $('#tblShareDcMembers').append(VShareDcMembersItem);
                    });
                } else {
                    $('#tblShareDcMembers').append('<p>No members found.</p>');
                }
                $('#shareDcCommitteeModal').modal('show');
            },
            error: function () {
                swal('Something went wrong!', '', 'error');
            }
        });
    });

    $(document).on('click', '#btnShareWithSelectedMembers', function () {
        var complaintId = $('#shareDcCommitteeModal').data('complaintId');
        var membersData = [];
        
        $("input[name='shareDcCheck']").each(function () {
            var flag = $(this).is(':checked') ? 'A' : 'D';
            membersData.push($(this).val() + '_' + flag);
        });

        if (membersData.length == 0) {
            swal("No members found.", "", "warning");
            return;
        }

        var Data = JSON.stringify({
            ComplaintId: complaintId,
            MemberIds: membersData
        });

        $.ajax({
            type: 'POST',
            url: "/ComplaintDetails/ShareComplaintWithMembers",
            data: Data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.IsSuccess) {
                    swal("Shared successfully with selected members.", "", "success");
                    $('#shareDcCommitteeModal').modal('hide');
                } else {
                    swal("Failed to share.", "", "error");
                }
            },
            error: function () {
                swal('Something went wrong!', '', 'error');
            }
        });
    });

