
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div>
    <div class="row mb-3">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <div>
                    <h4 class="mb-sm-0 font-size-18"> DC Member List</h4>
                    <div class="page-title-left mt-1">
                        <ol class="breadcrumb m-0 font-size-13">
                            <li class="breadcrumb-item"><a href="/Home/Index" class="text-muted">Dashboard</a></li>
                            <li class="breadcrumb-item active"> DC Member List</li>
                        </ol>
                    </div>
                </div>
                <div class="page-title-right d-flex align-items-center">
                    <div class="input-group input-group-sm me-2">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input id="txtQuickSearch" class="form-control quicksearchcomplaintmanagement" placeholder="Quick Search (Name, Contact, Email or Member No.)">
                    </div>
                    <a href="/DCMember/Add" class="btn btn-sm btn-outline-primary me-2 text-nowrap"><i class="fa-solid fa-plus me-1"></i> Add New</a>
                    <a class="btn btn-sm btn-outline-primary text-nowrap" id="addfilter"><i class="fa-solid fa-filter me-1"></i> Filter</a>
                </div>
            </div>
        </div>
    </div>
    <div class="card main_filter_div">
        <div class="card-body">
            <div class="row ">
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label>Member Type</label>
                    <select id="ddlDCMemberDataMemberType" class="form-control" aria-label="Default select example">
                        <option selected value="">Select Member Type</option>
                        <option value="B">BCG MEMBER</option>
                        <option value="O">CO-OPT MEMBER</option>
                    </select>
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label>Record Status</label>
                    <select id="ddlDCMemberDataRecordStatus" class="form-control" aria-label="Default select example">
                        <option selected value="">Select Status</option>
                        <option value="A">Active</option>
                        <option value="D">Inactive</option>
                    </select>
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label> From Date:</label>
                    <input name="txtFromDate" id="txtDCMemberDataFromDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-6 col-sm-6 col-12 col-lg-3">
                    <label> To Date:</label>
                    <input name="txtToDate" id="txtDCMemberDataToDate" type="date" placeholder="DD/MM/YYYY" class="form-control" max="2999-12-31">
                </div>
                <div class="form-group col-md-12 mt-3">
                    <div>
                        <a id="lnkDCMemberDataSearch" class="close_filterdiv btn-sm btn btn-outline-primary waves-effect waves-light btn-sm"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</a>
                        <a id="lnkDCMemberDataSearchCancel" class="btn btn-outline-danger waves-effect m-l-5 btn-sm close_filterdiv btn-sm"><i class="fa-solid fa-xmark me-1"></i> Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card border-0">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <table id="tblDCMemberDataList" class="table table-bordered dt-responsive nowrap w-100">
                                <thead>
                                    <tr>
                                        <th class="text-center">#</th>
                                        <th class="text-center">Member No.</th>
                                        <th>Member Name</th>
                                        <th class="text-center">Member Type</th>
                                        <th class="text-center">Contact Number</th>
                                        <th>Email Address</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Create By &<br /> Date Time</th>
                                        <th class="text-center">Last Modify By &<br /> Date Time</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-1 justify-content-md-start justify-content-center d-flex mb-md-0 mb-4">
                            <select class="form-select totalpageshowselect" aria-label="Default select example" id="ddlDCMemberDatarecordsize">
                                <option selected value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="250">250</option>
                                <option value="500">500</option>
                            </select>
                        </div>
                        <div class="col-md-11">
                            <nav aria-label="...">
                                <ul class="pagination justify-content-md-end justify-content-center" id="MyPager"></ul>
                            </nav>
                            <input id="hdfPageNumber" type="hidden" value="1" />
                            <input id="hdfLatPageNumber" type="hidden" value="0" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(".main_filter_div").hide();

    $(document).ready(function () {
        GetRecordList();

        var searchTimer = null;
        $('#txtQuickSearch, #txtRecordSearch').on('input keyup paste', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
                $("#hdfPageNumber").val(1);
                GetRecordList();
            }, 300);
        });

        $('#txtQuickSearch, #txtRecordSearch').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                clearTimeout(searchTimer);
                $("#hdfPageNumber").val(1);
                GetRecordList();
            }
        });
    });

    $('#addfilter').click(function () {
        $(".main_filter_div").slideToggle();
    });

    $('.close_filterdiv').click(function () {
        $(".main_filter_div").slideUp();
    });

    $('#lnkDCMemberDataSearch').click(function () {
        $("#hdfPageNumber").val(1);
        GetRecordList();
    });

    $('#ddlDCMemberDatarecordsize').on('change', function () {
        $("#hdfPageNumber").val(1);
        GetRecordList();
    });

    $('#lnkDCMemberDataSearchCancel').click(function () {
        $('#ddlDCMemberDataMemberType').val('');
        $('#ddlDCMemberDataRecordStatus').val('');
        $('#txtDCMemberDataFromDate').val('');
        $('#txtDCMemberDataToDate').val('');
        $('#txtQuickSearch, #txtRecordSearch').val('');
        $("#hdfPageNumber").val(1);
        GetRecordList();
    });

    $("#ddlDCMemberDataRecordStatus, #ddlDCMemberDataMemberType").change(function () {
        $("#hdfPageNumber").val(1);
        GetRecordList();
    });

    $('body').on('click', 'a.page', function () {
        $("#hdfPageNumber").val($(this).attr('page'));
        GetRecordList();
    });

    function GetRecordList() {
        $('#loader_bcg').css('display', 'block');
        var searchValue = ($('#txtQuickSearch').val() || $('#txtRecordSearch').val() || '').trim();
        var data = {
            Id: '0',
            SearchValue: searchValue,
            MemberType: $("#ddlDCMemberDataMemberType option:selected").val(),
            FromDate: $("#txtDCMemberDataFromDate").val(),
            ToDate: $("#txtDCMemberDataToDate").val(),
            RecordStatus: $("#ddlDCMemberDataRecordStatus option:selected").val(),
            PageSize: $("#ddlDCMemberDatarecordsize option:selected").val(),
            PageNo: $("#hdfPageNumber").val(),
            SortBy: 'ByNewest'
        };

        $.ajax({
            type: "POST",
            url: "/DCMember/DCMemberLists",
            data: data,
            dataType: "json",
            success: DCMemberDataOnSuccess,
            error: function (response) { console.error("Error loading DCMember list:", response); },
            complete: function () { $('#loader_bcg').css('display', 'none'); }
        });
    }

    function DCMemberDataOnSuccess(response) {
        $('#tblDCMemberDataList tbody').empty();
        var data = response.data;

        if (!data || data.length === 0) {
            $("#MyPager").empty();
            $('#tblDCMemberDataList tbody').html('<tr><td colspan="10" class="text-center text-muted py-4"><i class="fa-solid fa-circle-exclamation me-1"></i> No records found</td></tr>');
            return;
        }

        var VTotalRecord = parseInt(data[0].TotalRecord || 0);
        var VDisplayRecordCount = parseInt($("#ddlDCMemberDatarecordsize").val() || 25);

        $.each(data, function (i, row) {
            var VActive = row.Flag;
            var VStatusButton = (VActive === 'A')
                ? '<span class="badge bg-success">Active</span>'
                : '<span class="badge bg-danger">Inactive</span>';

            var VMemberType = row.MemberType || '';
            var VMemberTypeBadge = '-';
            if (VMemberType === 'B') {
                VMemberTypeBadge = 'BCG MEMBER';
            } else if (VMemberType === 'O') {
                VMemberTypeBadge = 'CO-OPT MEMBER';
            } else if (VMemberType) {
                VMemberTypeBadge = '';
            }

            var VDeleteButton = "";
            if (row.DeleteRights === 'A' || !row.DeleteRights) {
                if (VActive === 'A') {
                    VDeleteButton = '<a class="btn btn-outline-danger actionbutton waves-effect waves-light btn-sm" title="Inactivate Record" onclick="DCMemberDataInActiveStatus(' + row.Id + ')"><i class="fa-solid fa-trash custom-icon"></i></a>';
                } else {
                    VDeleteButton = '<a class="btn btn-outline-success actionbutton waves-effect waves-light btn-sm" title="Activate Record" onclick="DCMemberDataActiveStatus(' + row.Id + ')"><i class="fa-solid fa-check custom-icon"></i></a>';
                }
            }

            var VEditButton = (row.EditRights === 'A' || !row.EditRights)
                ? '<a class="btn btn-outline-primary actionbutton waves-effect waves-light btn-sm me-1" title="Edit Record" onclick="EditDCMemberDataTypeRecord(' + row.Id + ')"><i class="fa-solid fa-pencil custom-icon"></i></a>'
                : '';

            var RowItemDetail =
                '<tr>' +
                '<td class="text-center">' + row.SrNo + '</td>' +
                '<td class="text-center">' + row.EnroNumber + '</td>' +
                '<td>' + row.FullName + '</td>' +
                '<td class="text-center">' + VMemberTypeBadge + '</td>' +
                '<td class="text-center">' + row.ContactNumber + '</td>' +
                '<td>' + row.EmailAddress + '</td>' +
                '<td class="text-center">' + VStatusButton + '</td>' +
                '<td class="text-center">' + row.CreateBy + '<br/>' + row.SCreateDate + '<br/>' + row.SCreateTime + '</td>' +
                '<td class="text-center">' + row.LastModifyBy + '<br/>' + row.LastModifyDate + '<br/>' + row.LastModifyTime + '</td>' +
                '<td class="text-center">' + VEditButton + VDeleteButton + '</td>' +
                '</tr>';

            $('#tblDCMemberDataList tbody').append(RowItemDetail);
        });

        RenderPagination(VTotalRecord, VDisplayRecordCount);
    }

    function RenderPagination(totalRecords, pageSize) {
        var pageNo = parseInt($("#hdfPageNumber").val()) || 1;
        var totalPages = Math.ceil(totalRecords / pageSize);
        var paginationHtml = '';
        $("#MyPager").empty();

        if (totalPages > 1) {
            var prevDisabled = pageNo <= 1 ? 'disabled' : '';
            var prevPage = pageNo > 1 ? pageNo - 1 : 1;
            paginationHtml += '<li class="page-item ' + prevDisabled + '"><a class="page-link page" href="javascript:void(0);" page="' + prevPage + '"><i class="fas fa-chevron-left"></i></a></li>';

            var startPage = Math.max(1, pageNo - 2);
            var endPage = Math.min(totalPages, pageNo + 2);

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = i === pageNo ? 'active' : '';
                paginationHtml += '<li class="page-item ' + activeClass + '"><a class="page-link page" href="javascript:void(0);" page="' + i + '">' + i + '</a></li>';
            }

            var nextDisabled = pageNo >= totalPages ? 'disabled' : '';
            var nextPage = pageNo < totalPages ? pageNo + 1 : totalPages;
            paginationHtml += '<li class="page-item ' + nextDisabled + '"><a class="page-link page" href="javascript:void(0);" page="' + nextPage + '"><i class="fas fa-chevron-right"></i></a></li>';
        }

        $("#MyPager").html(paginationHtml);
    }

    function EditDCMemberDataTypeRecord(EditRecordId) {
        localStorage.setItem("EditDCMemberId", EditRecordId);
        location.href = '/DCMember/Edit?id=' + EditRecordId;
    }

    function DCMemberDataInActiveStatus(Id) {
        $.when(DCMemberDataStatusOnSuccess({ id: Id, Flag: 'D' })).then(function (r) { console.log(r); }).fail(function (e) { console.log(e); });
    }

    function DCMemberDataActiveStatus(Id) {
        $.when(DCMemberDataStatusOnSuccess({ id: Id, Flag: 'A' })).then(function (r) { console.log(r); }).fail(function (e) { console.log(e); });
    }

    function DCMemberDataStatusOnSuccess(data) {
        return $.ajax({
            type: 'POST',
            url: "/DCMember/DCMembersStatusUpdate",
            data: data,
            success: function (result) {
                if (result != null) {
                    var VRecordStatus = result.data;
                    var VFlag = result.Flag;
                    if (VRecordStatus == "UD") {
                        if (VFlag == 'A') { swal("Good job!", "Record active successfully..", "success", "1500"); }
                        else if (VFlag == 'D') { swal("Good job!", "Record inactive successfully..", "success", "1500"); }
                        GetRecordList();
                    } else { swal("", "Opps! Something Went Wrong.", "error"); }
                } else { $('#loader_bcg').css('display', 'none'); swal("", "Opps! Something Went Wrong.", "error"); }
            },
            error: function () { $('#loader_bcg').css('display', 'none'); swal("", "Opps! Something Went Wrong.", "error"); }
        });
    }
</script>
