    <!-- SweetAlert2 CDN and Sneat compat wrapper -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.swal = function (a, b, c) {
            var callback = (typeof b === 'function') ? b : (typeof c === 'function') ? c : null;
            var config = {
                buttonsStyling: false,
                customClass: {
                    confirmButton: 'btn btn-outline-primary',
                    cancelButton: 'btn btn-outline-secondary ms-2'
                }
            };

            if (typeof a === 'object') {
                config = $.extend(true, config, a);
                if (config.type && !config.icon) {
                    config.icon = config.type;
                }
            } else {
                config.title = a;
                if (c !== undefined && typeof c !== 'function') {
                    config.text = b || '';
                    config.icon = c || undefined;
                } else if (b !== undefined && typeof b !== 'function') {
                    var icons = ['success', 'error', 'warning', 'info', 'question'];
                    if (icons.indexOf(b) !== -1) {
                        config.icon = b;
                    } else {
                        config.text = b || '';
                    }
                }
            }

            var promise = Swal.fire(config);
            if (callback) {
                promise.then(function (result) {
                    if (result.isConfirmed || result.value) {
                        callback(true);
                    }
                });
            }
            return promise;
        };
    </script>

    <script>
        function opensidemenu() {
            $("#mySidepanel").addClass("sidemenuopn");
            $("#sidemenuoverlay").addClass("sidemenuoverlayopen");



        }
        function closesidemenu() {
            $("#mySidepanel").removeClass("sidemenuopn");
            $("#sidemenuoverlay").removeClass("sidemenuoverlayopen");
        }

        $(document).ready(function() {
            $(".sidemenu-toggle").click(function(e) {
                e.preventDefault();
                $(this).toggleClass("active");
                var $submenu = $(this).next(".sidemenu-submenu");
                var $icon = $(this).find(".toggle-icon");
                
                $submenu.slideToggle(300);
                if ($icon.hasClass("fa-chevron-down")) {
                    $icon.removeClass("fa-chevron-down").addClass("fa-chevron-up");
                } else {
                    $icon.removeClass("fa-chevron-up").addClass("fa-chevron-down");
                }
            });
        });

        $('.main_close_header').hide();
        // Open navigation using jQuery
        function openNav() {
            $("#mySidenav").css("width", "250px");
            $("#main").css("margin-left", "250px");
            $(".main_topbar").css("left", "250px");

            $('.main_close_header').show();
        }

        // Close navigation using jQuery
        function closeNav() {
            $("#mySidenav").css("width", "0");
            $("#main").css("margin-left", "0");
            $(".main_topbar").css("left", "0");
            $('.main_close_header').hide();


        }

    </script>
